---
import PageRail from "./PageRail.astro";
import ApprovedImage from './ApprovedImage.astro';
import CaseScene from './CaseScene.astro';
import CaseHeroMockup from './CaseHeroMockup.astro';
import {cases} from '../data/site';
const additionalCases=cases.filter(c=>['las-vegas-safety','zinc-fusion-v16','the-lampstand-va','straight-street-ministries'].includes(c.slug));
import '../styles/editorial.css';
---
<section class="zn-page-hero zn-work-overview"><div class="zn-hero-grid wrap"><div class="zn-hero-copy"><p class="lab">ZINC / Selected projects</p><h1 class="disp">Selected<br/>work<span>.</span></h1><p class="p-lede">Websites, campaigns and applications.<br/>See what we made, and the work behind it.</p><a class="zn-hero-action" href="#selected-projects">Explore the projects ↓</a></div><ApprovedImage name="build-ouabc-neese.png" alt="Bear Claw laptop, OUABC mobile storefront and Andrew Neese tablet" loading="eager" sizes="(max-width: 900px) 92vw, 56vw" class="zn-direction-art" /></div></section><PageRail path="/work/" title="Work" /><section class="zn-editorial" id="selected-projects"><div class="light"><div class="wrap"><div class="gallery"><article class="project bear" data-category="build"><a class="zn-project-link" href="/work/bear-claw-usa/"><div class="art"><ApprovedImage name="bear-white-devices.png" alt="Bear Claw USA project preview" /></div><div class="meta"><h2>Bear Claw USA</h2><p>Industrial · Website</p></div></a></article><article class="project smoky" data-category="build"><div class="art"><ApprovedImage name="smoky-white-devices.png" alt="Smoky Mountain Survival project preview" /></div><div class="meta"><h2>Smoky Mountain Survival</h2><p>Outdoor · Website &amp; commerce</p></div></article><article class="project tax" data-category="build"><div class="art"><ApprovedImage name="tax.jpeg" alt="Fraim, Cawley &amp; Company project preview" /></div><div class="meta"><h2>Fraim, Cawley &amp; Company</h2><p>Accounting · Website</p></div></article><article class="project ouabc" data-category="build"><a class="zn-project-link" href="/work/once-upon-a-book-club/"><div class="art"><ApprovedImage name="ouabc-white-devices.png" alt="Once Upon a Book Club project preview" /></div><div class="meta"><h2>Once Upon a Book Club</h2><p>Books &amp; retail · Shopify</p></div></a></article><article class="project andrew" data-category="build"><div class="art"><ApprovedImage name="andrew-white-devices.png" alt="Andrew Neese project preview" /></div><div class="meta"><h2>Andrew Neese</h2><p>Real estate · Website</p></div></article><article class="project porsche" data-category="build"><div class="art"><ApprovedImage name="porsche-white-devices.png" alt="Porsche project preview" /></div><div class="meta"><h2>Porsche</h2><p>Automotive · Web work</p></div></article><article class="project bi" data-category="intelligence"><a class="zn-project-link" href="/work/once-upon-a-book-club/#reporting"><div class="art"><ApprovedImage name="bi-path.avif" alt="OUABC BI Fusion project preview" /></div><div class="meta"><h2>OUABC BI Fusion</h2><p>Retail · BI application</p></div></a></article><article class="project felon" data-category="build"><a class="zn-project-link" href="/work/felon-motorwerk/"><div class="art"><ApprovedImage name="felon-white-devices.png" alt="Felon Motorwerk project preview" /></div><div class="meta"><h2>Felon Motorwerk</h2><p>Motorcycles · Web work</p></div></a></article><article class="project summit" data-category="intelligence"><a class="zn-project-link" href="/work/summit-marine-development/"><div class="art"><ApprovedImage name="summit.jpeg" alt="Summit Marine Development project preview" /></div><div class="meta"><h2>Summit Marine Development</h2><p>Marine · Business application</p></div></a></article><article class="project oil" data-category="build"><a class="zn-project-link" href="/work/us-oil-solutions/"><div class="art"><ApprovedImage name="oil-white-devices.png" alt="U.S. Oil Solutions project preview" /></div><div class="meta"><h2>U.S. Oil Solutions</h2><p>Commercial services · Website</p></div></a></article><article class="project"><a class="zn-project-link" href="/work/once-upon-a-book-club/#campaigns"><div class="art"><figure class="case-scene"><ApprovedImage name="campaign-white.png" alt="Once Upon a Book Club — SEO + Shopping + Meta + TikTok, presented in a studio device composition." /></figure></div><div class="meta"><h2>Once Upon a Book Club</h2><p>Campaigns · Demand</p></div></a></article><article class="project"><a class="zn-project-link" href="/work/summit-marine-development/#work-demand"><div class="art"><CaseScene name="demand-summit" alt="Summit Marine Development — Local SEO + Google + LSA + Meta, presented in a studio device composition." /></div><div class="meta"><h2>Summit Marine Development</h2><p>Campaigns · Demand</p></div></a></article>{additionalCases.map(study=><article class="project"><a class="zn-project-link" href={'/work/'+study.slug+'/'}><div class="art zn-device-stage"><CaseHeroMockup study={study} loading="lazy" /></div><div class="meta"><h2>{study.title}</h2><p>{study.application?'Application':study.nonprofit?'Community · Website':'Commerce · Website'}</p></div></a></article>)}</div></div></div></section>