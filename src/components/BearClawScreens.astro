import CaseScreens from './CaseScreens.astro';
const pages=[
 {key:'product',title:'Choose the supply size',path:'/product',detail:'The product page compares 5-gallon, 55-gallon and 275-gallon options before the quote request.'},
 {key:'applications',title:'Start with the application',path:'/applications',detail:'Concrete forms, asphalt beds and tools each lead to a dedicated application page.'},
 {key:'about',title:'Meet the company',path:'/about',detail:'The company page connects the product story with a direct contact at Bear Claw.'},
 {key:'quote',title:'Bring the job details',path:'/quote',detail:'The quote form asks for application, estimated volume, timeline and project details.'},
