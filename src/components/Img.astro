---
// Renders a site asset by key. Case images kept in src/assets/work/ go through astro:assets and
// ship as responsive AVIF/WebP; every other asset is a dimensioned <img> served from public/.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { asset } from '../data/site';

interface Props {
  k: string;
  alt: string;
  class?: string;
  id?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
}

const local = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.png', { eager: true });
const { k, alt, class: cls, id, loading = 'lazy', fetchpriority, sizes = '100vw' } = Astro.props;
const a = asset(k);
const file = local['../assets/work/' + a.src.split('/').pop()]?.default;
const widths = file ? [...new Set([480, 960, 1440, 1920, file.width].filter((w) => w <= file.width))] : [];
---
{file ? (
  <Picture src={file} formats={['avif', 'webp']} fallbackFormat="webp" widths={widths} sizes={sizes} alt={alt} class={cls} id={id} loading={loading} decoding="async" fetchpriority={fetchpriority} />
) : (
  <img src={a.src} alt={alt} class={cls} id={id} width={a.width} height={a.height} loading={loading} decoding="async" fetchpriority={fetchpriority} />
)}
