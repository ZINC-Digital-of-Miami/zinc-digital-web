<script>
  // Progressive enhancement only. Every piece of content above is already
  // complete in the server-rendered HTML; this script only ever ADDS motion
  // (word wraps, typing cursor, team reshuffle, the Loop's scroll-driven
  // draw). It never hides content that isn't already gated behind the
  // html.anim class in home.css. This is the ONLY script on the site that
  // adds .anim to <html> (plan invariant, Task 3).
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches || document.visibilityState !== 'visible';
  const root = document.documentElement;

  if (!reduce) {
    root.classList.add('anim');
  }

  // ---- kinetic headline word wrap (hero, OUABC, U.S. Oil, footer) --------
  function wrapWords(el: Element) {
    const walk = (node: Node) => {
      Array.from(node.childNodes).forEach((child) => {
        if (child.nodeType === Node.TEXT_NODE) {
          const text = child.textContent || '';
          const frag = document.createDocumentFragment();
          text.split(/(\s+)/).forEach((piece) => {
            if (!piece) return;
            if (/^\s+$/.test(piece)) {
              frag.appendChild(document.createTextNode(piece));
              return;
            }
            const w = document.createElement('span');
            w.className = 'w';
            const i = document.createElement('i');
            i.textContent = piece;
            w.appendChild(i);
            frag.appendChild(w);
          });
          child.replaceWith(frag);
        } else if (child.nodeType === Node.ELEMENT_NODE) {
          walk(child);
        }
      });
    };
    walk(el);
    el.querySelectorAll('.w > i').forEach((i, k) => {
      (i as HTMLElement).style.transitionDelay = k * 70 + 'ms';
    });
  }

  const kinEls = Array.from(document.querySelectorAll('.kin'));
  if (!reduce) {
    kinEls.forEach(wrapWords);
    // The word wrap adds inline-block spans to the hero headline; refit it.
    (window as unknown as { __fitHero?: () => void }).__fitHero?.();
  }

  // ---- reveal on view -----------------------------------------------------
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const target = entry.target as HTMLElement;
        target.classList.add('in');
        const band = target.dataset.homeBand;
        if (band === 'clients') flipLogos();
        if (band === 'commitments') typeLines();
        if (band === 'team') shuffleTeam(true);
        if (band === 'us-oil-solutions') revealStamps();
        io.unobserve(target);
      });
    },
    { threshold: 0.25 }
  );
  document
    .querySelectorAll(
      '.kin, [data-home-band="clients"], [data-home-band="commitments"], [data-home-band="team"], [data-home-band="us-oil-solutions"]'
    )
    .forEach((el) => io.observe(el));

  if (reduce) {
    typeLines();
  }
  requestAnimationFrame(() => {
    document.querySelector('[data-home-band="hero"]')?.classList.add('in');
  });

  // ---- logo wall: flip cells one at a time --------------------------------
  function flipLogos() {
    if (reduce) return;
    const cells = Array.from(document.querySelectorAll('.home-logo-cell')).filter(
      (c) => (c.textContent || '').trim()
    );
    cells.forEach((c, k) => {
      setTimeout(() => c.classList.add('flip'), k * 180);
      setTimeout(() => c.classList.remove('flip'), k * 180 + 420);
    });
  }

  // ---- U.S. Oil timeline: stagger the stamps in on entry ------------------
  // Mirrors the sketch's usoil handler (.planning/sketches/001-a-plus-b-homepage/index.html
  // lines 438-446): under reduced motion every stamp gets `.in` immediately;
  // otherwise each stamp arrives ~220ms after the last.
  function revealStamps() {
    const stamps = Array.from(document.querySelectorAll('.home-stamp'));
    stamps.forEach((s, k) => {
      if (reduce) {
        s.classList.add('in');
      } else {
        setTimeout(() => s.classList.add('in'), k * 220);
      }
    });
  }

  // ---- how we work: clear, type, lock -------------------------------------
  function typeLines() {
    const items = Array.from(document.querySelectorAll('.home-commit li'));
    let delay = 0;
    items.forEach((li) => {
      const el = li.querySelector<HTMLElement>('.typed');
      if (!el) return;
      const text = el.dataset.text || el.textContent || '';
      if (reduce) {
        el.textContent = text;
        li.classList.add('locked');
        return;
      }
      el.textContent = '';
      li.classList.remove('locked');
      for (let k = 0; k < text.length; k++) {
        setTimeout(() => {
          el.textContent = text.slice(0, k + 1);
        }, delay + k * 28);
      }
      delay += text.length * 28 + 250;
      setTimeout(() => li.classList.add('locked'), delay);
      delay += 150;
    });
  }

  // ---- team: shuffle order on entry ----------------------------------------
  function shuffleTeam(animate: boolean) {
    const grid = document.querySelector<HTMLElement>('[data-team]');
    if (!grid) return;
    if (grid.contains(document.activeElement)) return;
    const cards = Array.from(grid.children);
    const doShuffle = () => {
      cards.sort(() => Math.random() - 0.5).forEach((card) => grid.append(card));
    };
    if (animate && !reduce) {
      cards.forEach((c) => c.classList.add('shuffling'));
      setTimeout(() => {
        doShuffle();
        cards.forEach((c, k) => setTimeout(() => c.classList.remove('shuffling'), k * 60));
      }, 300);
    } else {
      doShuffle();
    }
  }

  // ---- the Loop: draw on scroll, pulse travels, layers scale --------------
  const path = document.getElementById('loop-path') as SVGPathElement | null;
  const pulse = document.getElementById('pulse');
  const glow = document.getElementById('glow');
  const loopBand = document.querySelector<HTMLElement>('[data-home-band="loop"]');
  const loopPct = document.getElementById('loop-pct');
  const nodes = Array.from(document.querySelectorAll('.home-loop-svg .node'));
  const layerItems = Array.from(document.querySelectorAll('.home-layer'));

  if (path && pulse && glow && loopBand && loopPct && nodes.length === 3 && layerItems.length === 3) {
    const len = path.getTotalLength();
    path.style.strokeDasharray = String(len);

    const nodeAt: [number, number, number] = [0, 0, 0];
    (function measure() {
      const targets = nodes.map((n) => [
        Number(n.getAttribute('cx')),
        Number(n.getAttribute('cy')),
      ]);
      const best = [1e9, 1e9, 1e9];
      for (let s = 0; s <= 400; s++) {
        const L = (len * s) / 400;
        const p = path.getPointAtLength(L);
        targets.forEach((t, i) => {
          const d = (p.x - t[0]) ** 2 + (p.y - t[1]) ** 2;
          if (d < best[i]) {
            best[i] = d;
            nodeAt[i] = s / 400;
          }
        });
      }
      nodeAt[0] = 0;
    })();

    function setLoop(p: number) {
      if (!path || !pulse || !glow || !loopPct) return;
      const drawn = Math.min(p * 1.08, 1);
      path.style.strokeDashoffset = String(len * (1 - drawn));
      const pt = path.getPointAtLength(len * (p % 1 === 0 && p >= 1 ? 0.999 : p % 1));
      pulse.setAttribute('cx', String(pt.x));
      pulse.setAttribute('cy', String(pt.y));
      glow.setAttribute('cx', String(pt.x));
      glow.setAttribute('cy', String(pt.y));
      let active = 0;
      nodeAt.forEach((a, i) => {
        if (p % 1 >= a - 0.001) active = i;
      });
      if (p >= 0.999) active = 2;
      nodes.forEach((n, i) => {
        n.classList.toggle('on', (drawn >= nodeAt[i] - 0.001 && i <= active) || p >= 0.999);
      });
      layerItems.forEach((l, i) => l.classList.toggle('on', i === active));
      loopPct.textContent =
        p < 0.02
          ? 'Scroll to run the loop'
          : p >= 0.999
            ? 'Loop complete · Intelligence feeds Build'
            : 'Pulse at ' + ['Build', 'Demand', 'Intelligence'][active];
    }

    function onScroll() {
      if (!loopBand) return;
      const rect = loopBand.getBoundingClientRect();
      const span = loopBand.offsetHeight - innerHeight;
      const p = reduce || span <= 0 ? 1 : Math.max(0, Math.min(1, -rect.top / span));
      setLoop(p);
    }

    let ticking = false;
    const request = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          onScroll();
        });
      }
    };
    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    onScroll();

    // Each TOC link's href already targets its own layer's id
    // (#loop-layer-0/1/2) directly — plain browser anchor navigation lands
    // on the right layer with zero JS. Only intercept the click to run the
    // 340vh progress math when the pinned scene is actually armed
    // (html.anim present, i.e. motion allowed and the tab is visible);
    // otherwise the Loop isn't pinned at all (home.css keeps every layer
    // expanded and in flow by default), so let the native anchor jump
    // happen instead of computing an offset against a scene that was never
    // built (Codex CLI review, confirmed: this fired unconditionally even
    // under prefers-reduced-motion, applying 340vh math to an unpinned band).
    document.querySelectorAll('.home-toc a[data-layer]').forEach((a) => {
      a.addEventListener('click', (e) => {
        if (!root.classList.contains('anim')) return;
        e.preventDefault();
        const span = loopBand.offsetHeight - innerHeight;
        const layerIndex = Number((a as HTMLElement).dataset.layer);
        const target = [0.05, 0.4, 0.72][layerIndex] ?? 0;
        scrollTo({
          top: loopBand.offsetTop + target * span + 10,
          behavior: 'smooth',
        });
      });
    });
  }
</script>
