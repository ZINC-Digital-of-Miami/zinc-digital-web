---
// Sketch footer language (.planning/sketches/001-a-plus-b-homepage/index.html
// lines 172-176, 389-399). Rendered once from PreviewLayout after main on
// every page, including 404 — this is the ONLY footer render site for
// non-home pages. The homepage's own inline footer (MockupBands part='home')
// stays until Task 3 replaces the whole homepage with HomeBands.
import { assets, toSitePath } from '../data/mockup';
const link = (path: string) => toSitePath(path);
---

<footer class="band site-footer" data-home-band="footer">
  <div class="band__inner">
    <h2 class="display section-title kin">Start an inquiry.</h2>
    <div class="footer-actions">
      <a class="btn solid" href={link('/contact/')}>Open the form &rarr;</a>
      <a class="sms" href="sms:+17865754837">Text (786) 575-4837</a>
    </div>
    <div class="footer-fact-grid">
      <div>
        <h3 class="t-label">Miami HQ</h3>
        <address>1900 N Bayshore Dr<br />Miami, FL 33132</address>
        <h3 class="t-label">Panama City satellite</h3>
        <address>97 Oak Ave Suite 7<br />Panama City, FL 32401</address>
        <a class="text-link" href="mailto:hello@zincdigital.co">hello@zincdigital.co</a>
      </div>
      <nav aria-label="Social links">
        <a href="https://www.facebook.com/zincdigitalofmiami">Facebook &#8599;</a>
        <a href="https://www.instagram.com/zincdigitalofmiami/">Instagram &#8599;</a>
        <a href="https://x.com/zinc_of">X &#8599;</a>
        <a href="https://www.linkedin.com/company/zinc-digital-of-miami/">LinkedIn &#8599;</a>
        <span class="draft-tag">YouTube [OWNER CONFIRM]</span>
      </nav>
    </div>
    <div class="footer-fine">
      <img
        src={assets['wordmark-black'].src}
        width={assets['wordmark-black'].width}
        height={assets['wordmark-black'].height}
        alt="ZINC"
      />
      <p class="t-label muted">&copy; 2026 ZINC Digital</p>
      <nav aria-label="Legal">
        <a href={link('/privacy/')}>Privacy</a>
        <a href={link('/terms/')}>Terms</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 3px solid var(--rule);
  }

  address {
    font-style: normal;
    color: var(--muted);
    font-size: 0.875rem;
    margin-block: 0.75rem 1.5rem;
  }

  .footer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    align-items: center;
    margin-top: var(--space-xl);
  }

  .footer-fact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
    border-top: 3px solid var(--rule);
    padding-top: var(--space-lg);
    margin-block: var(--space-2xl);
  }

  .footer-fact-grid nav {
    display: flex;
    flex-direction: column;
  }

  .footer-fact-grid nav a,
  .footer-status {
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .footer-fine {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    border-top: 1px solid var(--muted);
    padding-top: var(--space-xl);
  }

  .footer-fine img {
    width: 160px;
  }

  .footer-fine nav {
    display: flex;
    gap: var(--space-lg);
  }

  .footer-fine nav a,
  .footer-fine p {
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  @container (max-width: 820px) {
    .footer-fact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
