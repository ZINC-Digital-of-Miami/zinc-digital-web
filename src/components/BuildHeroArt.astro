---
import Img from './Img.astro';
---
<div class="build-art" aria-label="Bear Claw website and rebuilt Once Upon a Book Club storefront">
  <div class="build-plane" aria-hidden="true"></div>
  <div class="build-laptop"><div class="build-screen"><Img k="bear-claw-home-desktop" alt="Bear Claw website built by ZINC" loading="eager" sizes="(max-width:600px) 80vw, 50vw" /></div><div class="build-keyboard" aria-hidden="true"></div></div>
  <div class="build-tablet"><Img k="ouabc-site" alt="Once Upon a Book Club rebuilt Shopify storefront" loading="eager" sizes="(max-width:600px) 50vw, 35vw" /></div>
  <div class="build-phone"><Img k="ouabc-mobile" alt="Once Upon a Book Club mobile storefront" loading="eager" sizes="(max-width:600px) 22vw, 15vw" /></div>
</div>
<style>
.build-art{position:absolute;inset:0;z-index:-2;isolation:isolate;background:#101519;overflow:hidden}
.build-plane{position:absolute;inset:0;clip-path:polygon(67% 0,100% 0,100% 100%,36% 100%);background:#1b2228}
.build-laptop{position:absolute;width:46%;right:15%;top:26%;transform:perspective(1400px) rotateY(-12deg) rotateZ(-3deg);filter:drop-shadow(0 28px 20px #0009)}
.build-screen{aspect-ratio:16/10;padding:12px 10px 10px;border:1px solid #737b81;border-radius:12px 12px 0 0;background:#101214;overflow:hidden}
.build-screen :global(img){width:100%;height:100%;object-fit:cover;object-position:top}
.build-screen :global(picture){display:block;height:100%}
.build-keyboard{height:17px;margin:0 -6%;background:linear-gradient(#b1b5b8,#454b50);border-radius:0 0 50% 50% / 0 0 10px 10px;border-top:1px solid #d1d4d7}
.build-tablet{position:absolute;right:3%;top:13%;width:27%;height:64%;background:#121416;padding:12px 9px;border:1px solid #6d757b;border-radius:19px;transform:perspective(1200px) rotateY(-9deg) rotateZ(5deg);box-shadow:-18px 28px 45px #0008;overflow:hidden}
.build-tablet :global(picture),.build-tablet :global(img){display:block;width:100%;height:100%;object-fit:cover;object-position:left top}
.build-phone{position:absolute;width:11%;right:26%;bottom:12%;padding:13px 5px 7px;background:#0c0e10;border:1px solid #9ca1a4;border-radius:19px;transform:rotate(-4deg);box-shadow:-10px 15px 25px #0008;overflow:hidden}
.build-phone :global(img){display:block;width:100%;aspect-ratio:9/18;height:auto;object-fit:cover;object-position:top;border-radius:9px}
@media(max-width:600px){.build-plane{clip-path:polygon(100% 30%,100% 100%,0 100%)}.build-laptop{width:65%;right:23%;top:auto;bottom:14%}.build-tablet{width:37%;height:29%;right:4%;top:auto;bottom:16%}.build-phone{width:19%;right:32%;bottom:8%}.build-screen{padding:8px 6px 6px}.build-tablet{padding:7px 5px;border-radius:12px}}
</style>
