{
  "name": "zinc-digital-web",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "assets": "node scripts/fetch-live-assets.mjs",
    "build": "node -e \"require('fs').rmSync('node_modules/.astro/fonts',{recursive:true,force:true})\" && astro build",
    "check": "astro check",
    "test": "node --test 'tests/*.test.ts'",
    "astro": "astro",
    "verify": "npm run assets && astro build && node scripts/check-site.mjs && node scripts/verify-site.mjs --mode quick",
    "verify:full": "npm run assets && astro build && node scripts/check-site.mjs && node scripts/verify-site.mjs --mode full"
  },
  "dependencies": {
    "@astrojs/vercel": "11.0.18",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "astro": "7.4.5",
    "mammoth": "1.13.0",
    "marked": "18.0.14",
    "nodemailer": "10.3.1",
    "parse5": "8.0.1",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/cli": "4.13.0",
    "@lhci/cli": "0.16.0",
    "@types/nodemailer": "8.0.2",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@vercel/nft": {
      "glob": "14.0.3"
    },
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "basic-ftp": "6.2.5",
    "@sentry/bundler-plugins": {
      "glob": "14.0.3"
    }
  }
}
