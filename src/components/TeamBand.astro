---
// Sketch team language (.planning/sketches/001-a-plus-b-homepage/index.html
// lines 155-163, 366-377): 7 columns, 2 under 820px, 4:5 grayscale tiles.
// No script here — the shuffle-on-entry lives in Task 3's homepage script.
// Called with no props, the about page shows the data in mockup.ts order.
import { team, assets } from '../data/mockup';

interface Props {
  heading?: string;
}

const { heading = 'The people doing the work' } = Astro.props;

// Jaymie and Wendy have no photo yet (mockup.ts team[].photo === null); the
// sketch shows their initials in the tile in addition to the existing
// [PHOTO PENDING] marker.
const initials: Record<string, string> = {
  'jaymie-wilhoit': 'JW',
  'wendy-funnell': 'WF',
};
---

<section class="band team-band">
  <div class="band__inner">
    <p class="t-label eyebrow">{heading}</p>
    <div class="team-band-grid">
      {team.map((person) => (
        <article class="team-band-person">
          {person.photo ? (
            <div class="team-band-photo">
              <img
                src={assets[person.photo as keyof typeof assets].src}
                width={assets[person.photo as keyof typeof assets].width}
                height={assets[person.photo as keyof typeof assets].height}
                alt=""
                loading="lazy"
              />
            </div>
          ) : (
            <div class="team-band-photo team-band-photo--pending">
              <span aria-hidden="true">{initials[person.id] ?? ''}</span>
              <span class="draft-tag">[PHOTO PENDING]</span>
            </div>
          )}
          <p class="team-band-name">{person.name}</p>
          <p class="t-label muted">{person.role}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .team-band-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  @container (max-width: 820px) {
    .team-band-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .team-band-person {
    min-width: 0;
  }

  .team-band-photo {
    aspect-ratio: 4 / 5;
    background: var(--color-gray-on-light);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .team-band-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  .team-band-photo--pending {
    flex-direction: column;
    gap: var(--space-xs);
    border: 1px solid var(--muted);
    background: none;
    font-family: var(--font-display, sans-serif);
    font-weight: var(--weight-heavy);
    font-size: 2rem;
    color: var(--fg);
  }

  .team-band-name {
    font-weight: 500;
    font-size: 0.95rem;
    margin-top: var(--space-sm);
    line-height: 1.25;
  }
</style>
