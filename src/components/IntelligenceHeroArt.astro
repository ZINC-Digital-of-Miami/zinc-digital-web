---
import DesktopMockup from './DesktopMockup.astro';
import DeviceFrame from './DeviceFrame.astro';
---
<div class="intelligence-art hero-art" aria-label="Once Upon a Book Club business intelligence application in development">
  <div class="intelligence-plane" aria-hidden="true"></div>
  <div class="hero-art__group">
    <div class="intelligence-monitor"><DesktopMockup asset="ouabc-bi-demand-current" title="OUABC BI Fusion demand calendar — application in development, private figures removed" loading="eager" sizes="(max-width:700px) 80vw, 50vw" /></div>
    <div class="intelligence-tablet"><DeviceFrame device="tablet-landscape" asset="ouabc-bi-ads-current" title="OUABC BI Fusion advertising overview — application in development, private figures removed" loading="eager" sizes="(max-width:700px) 46vw, 30vw" /></div>
  </div>
</div>
<style>
.intelligence-art{--ratio:1.35;position:absolute;inset:0;isolation:isolate;overflow:hidden;background:#0e151b}
.intelligence-plane{position:absolute;inset:0;clip-path:polygon(68% 0,100% 0,100% 100%,35% 100%);background:#1c2831}
.intelligence-monitor{position:absolute;width:86%;left:0;top:0}
.intelligence-tablet{position:absolute;width:52%;right:0;bottom:0;filter:drop-shadow(-15px 18px 18px #0007)}
@media(max-width:700px){.intelligence-plane{clip-path:polygon(100% 30%,100% 100%,0 100%)}}
</style>
