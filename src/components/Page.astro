</>)}

{profile && <section class="p-band thin"><div class="wrap"><div class="p-author-profile"><Img k={profile.photo} alt={profile.schemaName} sizes="(max-width: 700px) 120px, 220px" loading="eager" fetchpriority="high" decoding="sync"/><div><span class="lab">{profile.role}</span><p class="p-body">{profile.bio}</p><p class="lab p-muted">{profile.topics}</p></div></div><h2 class="disp p-sec">Articles by {profile.schemaName.split(' ')[0]}.</h2>{authorPosts.length ? <div class="p-articles">{authorPosts.map(p=><article class="p-art">{articleImages[p.slug] && <a class="p-art-image" href={'/blog/'+p.slug+'/'} aria-hidden="true" tabindex="-1"><Img k={articleImages[p.slug].asset} alt="" sizes="(max-width: 900px) 90vw, 360px"/></a>}<span class="lab">{dateLabel(p.dateGmt)} / {p.layer}</span><h3><a href={'/blog/'+p.slug+'/'}>{p.title}</a></h3><p>{excerpt(p)}</p><a class="arrow" href={'/blog/'+p.slug+'/'}>Read the article </a></article>)}</div> : <p class="p-muted">New articles are being prepared.</p>}</div></section>}

{legal.length > 0 && <section class="p-band"><div class="wrap p-legal"><div class="rv">{legal.map(([h, p], i) => <section><span class="lab">{pad(i)}</span><div><h2>{h}</h2><p>{p}</p></div></section>)}</div></div></section>}

{t === 'contact' && <section class="p-band"><div class="wrap p-contact"><ContactForm values={form?.values} error={form?.error} /></div></section>}

{t === 'thanks' && <section class="p-band"><div class="wrap"><div class="p-related rv" style="margin-top:0"><a class="btn fill" href="/work/">Explore the work </a><a class="arrow" href="/" style="margin-top:0">Return home </a></div></div></section>}

{t === '404' && <section class="p-band"><div class="wrap"><div class="p-related rv" style="margin-top:0"><a class="btn fill" href="/">Home</a><a href="/services/">Services </a><a href="/contact/">Contact </a></div></div></section>}

<script>
  // Both initialisers return immediately when their root element is absent.
  import { initBlog, initForm } from '../scripts/page';
  initBlog(); initForm();
</script>
