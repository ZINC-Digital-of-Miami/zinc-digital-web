---
import {googleAccountEmail,googleUsesExistingLogin,savedGoogleSettings} from '../../lib/google';
import {createServerClient} from '../../lib/supabase';
import {requireStaff} from '../../lib/auth';
const staff=requireStaff(Astro);if(staff instanceof Response)return staff;
const account=googleAccountEmail();
const existingLogin=googleUsesExistingLogin();
let settings={property:'',site:''},error='';
try{settings=await savedGoogleSettings(createServerClient(Astro));}catch(e){error=(e as Error).message;}
---
<section class="a-panel a-section" data-google-connection>
 <h2 class="a-heading">Google connections</h2>
 {error&&<p class="a-error">{error}</p>}
 {account?<>
 <p class="a-muted">{existingLogin?'Using your existing Google connection for ZINC. Verify the selected properties below.':'Give the website account access in Google, then verify each connection here.'}</p>
 <label class="a-field a-section"><span>{existingLogin?'Connected Google account':'Website account'}</span><input class="a-input" data-google-account value={account} readonly aria-label="Connected Google account address"/></label>
 {!existingLogin&&<button type="button" class="a-button a-section" data-copy-google-account>Copy account address</button>}
 <p class="a-muted" data-google-status role="status" aria-live="polite"></p>
 <div class="a-grid a-section">
  <div>
   <h3 class="a-heading">Google Analytics 4</h3>
   {!existingLogin&&<p class="a-muted">In Admin → Property access management, add the website account as a Viewer. Turn off the invitation email.</p>}
   <a class="a-button a-section" href="https://analytics.google.com/analytics/web/" target="_blank" rel="noopener noreferrer">Open Google Analytics ↗</a>
   <form class="a-form a-section" data-google-form data-kind="ga4">
    <label class="a-field"><span>Property ID</span><input class="a-input" name="property" inputmode="numeric" pattern="[0-9]{1,20}" maxlength="20" required value={settings.property} readonly={staff.role!=='owner'}/></label>
    {staff.role==='owner'&&<button type="submit" class="a-button">Verify and save GA4</button>}
    <p class="a-muted" data-google-result role="status" aria-live="polite">{staff.role!=='owner'?'An owner can verify and save this connection.':''}</p>
   </form>
   <a class="a-link" href="https://support.google.com/analytics/answer/9305788" target="_blank" rel="noopener noreferrer">Google’s access instructions</a>
  </div>
  <div>
   <h3 class="a-heading">Search Console</h3>
   {!existingLogin&&<p class="a-muted">In Settings → Users and permissions, add the website account as a Full user. Return here to load your accessible property.</p>}
   <a class="a-button a-section" href="https://search.google.com/search-console" target="_blank" rel="noopener noreferrer">Open Search Console ↗</a>
   <button type="button" class="a-button a-section" data-google-discover>Check available properties</button>
   <form class="a-form a-section" data-google-form data-kind="gsc">
    <label class="a-field"><span>Search Console property</span><select class="a-input" name="site" required disabled={staff.role!=='owner'}><option value="">Choose your property</option>{settings.site&&<option value={settings.site} selected>{settings.site}</option>}</select></label>
    {staff.role==='owner'&&<button type="submit" class="a-button">Verify and save Search Console</button>}
    <p class="a-muted" data-google-result role="status" aria-live="polite">{staff.role!=='owner'?'An owner can verify and save this connection.':''}</p>
   </form>
   <a class="a-link" href="https://support.google.com/webmasters/answer/7687615" target="_blank" rel="noopener noreferrer">Google’s access instructions</a>
  </div>
 </div>
 </>:<p class="a-notice">The website’s Google connection has not been configured.</p>}
</section>
<script>import '../../scripts/admin/google';</script>
