---
import MessageForm from './MessageForm.astro';
interface Props { sourcePath: string }
const {sourcePath}=Astro.props;
---
{(['message','content_question'] as const).map(intent=><dialog class="message-dialog" data-message-dialog={intent} aria-labelledby={'message-'+(intent==='message'?'jaymie':'wendy')+'-title'}>
 <div class="message-dialog-head"><span class="kick">ZINC / A conversation</span><button type="button" data-message-close aria-label="Close message">Close <span aria-hidden="true">×</span></button></div>
 <div class="message-dialog-body"><MessageForm intent={intent} sourcePath={sourcePath} /></div>
</dialog>)}
<style>
 .message-dialog{position:fixed;inset:0 0 0 auto;margin:0;width:min(620px,100%);max-width:100%;height:100dvh;max-height:100dvh;padding:0;border:0;border-left:1px solid var(--line);background:var(--bg);color:var(--ink);overflow:auto;overscroll-behavior:contain;font-family:var(--fb)}.message-dialog::backdrop{background:rgb(0 0 0 / .56)}.message-dialog-head{position:sticky;top:0;z-index:1;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:14px 30px;background:var(--bg);border-top:3px solid var(--tealt);border-bottom:1px solid var(--line)}.message-dialog-head button{display:flex;align-items:center;gap:16px;min-height:44px;border:0;padding:4px 0 4px 8px;background:none;color:var(--ink);font-family:var(--fm);cursor:pointer}.message-dialog-head button span{font-size:28px}.message-dialog-head button:focus-visible{outline:3px solid var(--tealt);outline-offset:4px}.message-dialog-body{padding:32px 36px max(36px,env(safe-area-inset-bottom))}
 @media(max-width:600px){.message-dialog-head{padding:10px 22px}.message-dialog-body{padding:26px 22px max(32px,env(safe-area-inset-bottom))}}
</style>
