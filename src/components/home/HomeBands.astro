---
// HomeBands.astro — the homepage, ported from ZINC Home Blend.dc.html.
// Header, CTA band and footer come from SiteLayout. Motion lives in scripts/home.ts.
import Img from '../Img.astro';
import ClientLogos from '../ClientLogos.astro';
import { team, asset, posts, dateLabel } from '../../data/site';
import '../../styles/home.css';
---
<section class="hero" id="hero"><div class="sph" data-par="0.06" style="width:620px;height:620px;right:-160px;top:4%;animation:float1 11s ease-in-out infinite"></div><div class="sph" data-par="0.1" style="width:380px;height:380px;left:-150px;bottom:-110px;animation:float2 13s ease-in-out infinite"></div><div class="wrap hero-in" id="heroIn"><h1 class="disp hero-h"><span class="ln"><span class="w"><i>Other</i></span> <span class="w"><i style="transition-delay:.06s">agencies</i></span> <span class="w"><i style="transition-delay:.12s">deliver</i></span></span><span class="ln"><span class="w"><i style="transition-delay:.2s"><span class="strike">the scope.</span></i></span></span><span class="ln"><span class="w"><i style="transition-delay:.3s">ZINC</i></span> <span class="w"><i style="transition-delay:.36s">delivers</i></span></span><span class="ln"><span class="w"><i style="transition-delay:.44s"><span class="hit">the business.</span></i></span></span></h1></div><div class="scrollcue lab"><i></i>Scroll</div></section>

<div class="wrap"><hr class="rule" /><div class="meta lab"><span>ZINC Digital</span><span>Miami HQ · Panama City</span><span>Working nationwide</span><span>Build · Demand · Intelligence</span></div><div class="intro"><div class="rv"><p class="intro-lede">One team connects your website or store, the demand reaching it, and the reporting that guides the next step.</p><div class="acts"><a class="btn fill" href="/contact/">Start an inquiry</a><a class="btn ghost" href="sms:+17865754837">Text (786) 575-4837</a></div><a class="proof" href="/work/once-upon-a-book-club/"><span class="mdot"></span><span class="lab">Proof</span><span class="proof-t">Once Upon a Book Club · Shopify, product campaigns and monthly reporting</span><span class="lab">Read the case ↗</span></a></div><div class="rv"><div class="kick" style="margin-bottom:14px">Contents</div><ol class="toc"><li><a href="#loop"><span class="n">01</span><span class="t">Build</span><span class="dots"></span><span class="c">3 services</span></a></li><li><a href="#loop"><span class="n">02</span><span class="t">Demand</span><span class="dots"></span><span class="c">7 services</span></a></li><li><a href="#loop"><span class="n">03</span><span class="t">Intelligence</span><span class="dots"></span><span class="c">1 service</span></a></li><li><a href="#work"><span class="n">04</span><span class="t">The work</span><span class="dots"></span><span class="c">2 cases</span></a></li></ol></div></div></div>

<div class="mq"><div class="mqtrack"><span class="mqi">Shopify <span class="d">·</span> <span class="o">Web design</span> <span class="d">·</span> Apps <span class="d">·</span> <span class="o">SEO</span> <span class="d">·</span> Local SEO <span class="d">·</span> <span class="o">Generative search</span> <span class="d">·</span> Search ads <span class="d">·</span> <span class="o">Shopping ads</span> <span class="d">·</span> Meta <span class="d">·</span> <span class="o">TikTok</span> <span class="d">·</span> Business intelligence <span class="d">·</span></span><span class="mqi">Shopify <span class="d">·</span> <span class="o">Web design</span> <span class="d">·</span> Apps <span class="d">·</span> <span class="o">SEO</span> <span class="d">·</span> Local SEO <span class="d">·</span> <span class="o">Generative search</span> <span class="d">·</span> Search ads <span class="d">·</span> <span class="o">Shopping ads</span> <span class="d">·</span> Meta <span class="d">·</span> <span class="o">TikTok</span> <span class="d">·</span> Business intelligence <span class="d">·</span></span></div></div>

<section class="band"><div class="wrap"><span class="kick rv">// Who's trusted us</span><ClientLogos /></div></section>

<section class="loop" id="loop"><div class="loop-pin"><div class="wrap" style="width:100%"><div class="loop-head lab"><span>One system, three layers</span><span id="loopStatus">Build · the machine the customer touches</span></div><div class="loop-grid"><div class="circ"><svg viewBox="0 0 400 400" aria-hidden="true"><circle class="trace" cx="200" cy="200" r="186"></circle><circle class="track" cx="200" cy="200" r="150"></circle><circle class="draw" id="loopDraw" cx="200" cy="200" r="150" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" transform="rotate(-90 200 200)"></circle><circle class="node" cx="200" cy="50" r="12"></circle><circle class="node" cx="329.9" cy="275" r="12"></circle><circle class="node" cx="70.1" cy="275" r="12"></circle><text class="nl" x="200" y="22" text-anchor="middle">Build</text><text class="nl" x="352" y="312" text-anchor="middle">Demand</text><text class="nl" x="48" y="312" text-anchor="middle">Intelligence</text><circle id="loopPulse" cx="200" cy="50" r="6" fill="#FC0781"></circle></svg><div class="circ-core"><div class="badge"><div class="bring2"></div><Img k="zinc-badge" class="bimg" alt="" sizes="260px" /><div class="bring"></div><div class="borbit"><div class="bdot"></div></div></div></div></div><ol class="layers"><li class="layer on"><span class="lab">01 · The machine the customer touches</span><h2 class="disp layer-t">Build</h2><ul class="layer-list"><li><a href="/services/shopify/">Shopify Ecommerce</a></li><li><a href="/services/web-design/">Web Design</a></li><li><a href="/services/apps/">Apps</a></li></ul></li><li class="layer"><span class="lab">02 · Traffic into it</span><h2 class="disp layer-t">Demand</h2><ul class="layer-list"><li><a href="/services/seo/">SEO</a></li><li><a href="/services/local-seo/">Local SEO</a></li><li><a href="/services/ai-search-optimization/">Generative Search Optimization</a></li><li><a href="/services/google-search-ads/">Google Search Ads</a></li><li><a href="/services/shopping-ads/">Shopping / Merchant Center Ads</a></li><li><a href="/services/social-ads/">Social Ads (Meta)</a></li><li><a href="/services/tiktok-ads/">TikTok Ads</a></li></ul></li><li class="layer"><span class="lab">03 · The truth about what's working</span><h2 class="disp layer-t">Intelligence</h2><ul class="layer-list"><li><a href="/services/business-intelligence/">Business Intelligence</a></li><li><span style="color:var(--muted)">Reporting that feeds Build and Demand</span></li></ul></li></ol></div></div></div></section>

<section class="hz" id="hz"><div class="hz-pin"><div class="hz-track" id="hzTrack"><div class="hz-panel"><div class="hz-in"><div class="hz-text"><span class="kick">01 · Layer</span><h2 class="disp hz-h" style="margin-top:14px">Build</h2><p class="hz-p">The storefront, the site, the app. The machine the customer touches, built to convert before any traffic hits it.</p><div class="hz-tags"><span class="hz-tag">Shopify</span><span class="hz-tag">Web design</span><span class="hz-tag">Apps</span></div></div><div class="hz-vis"><div style="position:relative;width:240px;height:240px"><div class="ring rgA"></div><div class="ring rgB"></div><div class="ring rgC"></div><div class="cdot"></div></div></div></div></div><div class="hz-panel"><div class="hz-in"><div class="hz-text"><span class="kick">02 · Layer</span><h2 class="disp hz-h" style="margin-top:14px">Demand</h2><p class="hz-p">Search, AI answers, paid and social. Traffic modeled against the demand curve, then pointed at the pages that close.</p><div class="hz-tags"><span class="hz-tag">SEO</span><span class="hz-tag">Generative search</span><span class="hz-tag">Paid media</span></div></div><div class="hz-vis"><div class="bars" style="height:200px;gap:16px"><i style="height:30%;width:26px"></i><i style="height:55%;width:26px;animation-delay:.2s"></i><i style="height:80%;width:26px;animation-delay:.4s"></i><i style="height:64%;width:26px;animation-delay:.6s"></i><i style="height:100%;width:26px;background:var(--teal);animation-delay:.8s"></i></div></div></div></div><div class="hz-panel"><div class="hz-in"><div class="hz-text"><span class="kick">03 · Layer</span><h2 class="disp hz-h" style="margin-top:14px">Intelligence</h2><p class="hz-p">Dashboards and models your team actually opens. The truth about what's working, tied to revenue.</p><div class="hz-tags"><span class="hz-tag">BI dashboards</span><span class="hz-tag">Forecasting</span><span class="hz-tag">Decision apps</span></div></div><div class="hz-vis"><div class="dgrid" style="grid-template-columns:repeat(4,22px);gap:20px"><i style="width:22px;height:22px"></i><i style="width:22px;height:22px;animation-delay:.3s"></i><i style="width:22px;height:22px;animation-delay:.6s"></i><i style="width:22px;height:22px;animation-delay:.9s"></i><i style="width:22px;height:22px;animation-delay:1.2s"></i><i style="width:22px;height:22px;animation-delay:1.5s"></i><i style="width:22px;height:22px;animation-delay:1.8s"></i><i style="width:22px;height:22px;animation-delay:2.1s"></i></div></div></div></div></div><div class="hz-dots" id="hzDots"><i class="on"></i><i></i><i></i></div></div></section>

<section class="band" id="work" style="border-top:3px solid var(--ink)"><div class="wrap"><div class="case-top"><div><span class="kick rv">Case 01 · Once Upon a Book Club</span><h2 class="disp case-h rv" style="margin-top:18px">Every new box needs more than a product page.</h2></div><p class="rv" style="font-size:20px;line-height:1.5;max-width:34ch;margin:0">We rebuilt the Shopify website and manage SEO, blogs, Google Shopping, TikTok and Meta ads around each book-box release. ZINC also initiated a two-month reporting-app build, now in progress, to support better decisions.</p></div><div class="figs rv"><div class="fig"><div class="lab">Store &amp; search</div><div class="fig-v">Store rebuilt</div><div class="fig-r">Titles, descriptions, publication checks and crawl repairs</div></div><div class="fig"><div class="lab">Campaigns</div><div class="fig-v">Product launches</div><div class="fig-r">Google Shopping · Meta ads · TikTok ads</div></div><div class="fig"><div class="lab">Reporting</div><div class="fig-v">Next priorities</div><div class="fig-r">Monthly reporting · BI app in progress</div></div></div><div class="case-body"><div class="rv"><div class="lab">Layers ZINC runs</div><ul class="chips"><li>TikTok Ads</li><li>Shopping Ads</li><li>Meta Ads</li><li>Blog content</li><li>Website rebuild</li><li>Business Intelligence</li></ul><a class="arrow" href="/work/once-upon-a-book-club/">Read the case →</a></div><div class="shots rv"><div class="mini"><div class="ring rgA"></div><div class="ring rgB"></div><div class="ring rgC"></div><div class="cdot"></div></div><Img class="desk" k="ouabc-site" alt="Once Upon a Book Club storefront presentation" sizes="(max-width: 900px) 100vw, 640px" /><Img class="phone" k="ouabc-mobile" alt="Once Upon a Book Club mobile storefront presentation" sizes="240px" /></div></div></div></section>

<section class="uso" id="uso"><div class="uso-pin"><div class="uso-track" id="usoTrack"><div class="uso-intro"><span class="kick">Case 02 · U.S. Oil Solutions · Las Vegas</span><h2 class="disp uso-h" style="margin-top:18px">Oil management, online and on the job.</h2><a class="arrow" href="/work/us-oil-solutions/">Read the case →</a></div><div class="stamp"><div><span class="lab">01</span><div class="disp stamp-k">Website</div><span class="lab">Build</span><p class="stamp-p">Fryer-oil management, filtration, fresh-oil delivery and used-oil pickup—with clear service pages and inquiry paths.</p></div><div class="stamp-vis"><div class="stk" style="width:120px"><i style="width:100%"></i><i style="width:70%;background:var(--ink);animation-delay:.4s"></i><i style="width:85%;animation-delay:.8s"></i></div></div></div><div class="stamp"><div><span class="lab">02</span><div class="disp stamp-k">SEO</div><span class="lab">Demand</span><p class="stamp-p">Las Vegas search content answers restaurant questions about fryer-oil management, filtration and oil service.</p></div><div class="stamp-vis"><div class="bars"><i style="height:35%"></i><i style="height:55%;animation-delay:.2s"></i><i style="height:48%;animation-delay:.4s"></i><i style="height:78%;animation-delay:.6s"></i><i style="height:100%;background:var(--teal);animation-delay:.8s"></i></div></div></div><div class="stamp"><div><span class="lab">03</span><div class="disp stamp-k">Technicians</div><span class="lab">Operations app</span><p class="stamp-p">A separate operations app handles scheduling and check-ins, restaurant assignments, fryer records, replacement thresholds, camera capture and pause/resume controls.</p></div><div class="stamp-vis"><div class="dgrid"><i></i><i style="animation-delay:.3s"></i><i style="animation-delay:.6s"></i><i style="animation-delay:.9s"></i><i style="animation-delay:1.2s"></i><i style="animation-delay:1.5s"></i><i style="animation-delay:1.8s"></i><i style="animation-delay:2.1s"></i></div></div></div><div class="stamp"><div><span class="lab">04</span><div class="disp stamp-k">Supervisors</div><span class="lab">Operations app</span><p class="stamp-p">The same operations app gives supervisors on-call rescheduling, restaurant groups, special tasks, checkout oversight and operational reporting.</p></div><div class="stamp-vis"><div class="mot" style="position:relative;width:96px;height:96px"><div class="ring rgA"></div><div class="ring rgB"></div><div class="ring rgC"></div><div class="cdot"></div></div></div></div><div class="uso-shot" aria-label="Separate operations app"><span class="lab uso-shot-label">Operations app · Technician and supervisor workflows</span><Img class="desk" k="uos-current-technicians-desktop" alt="U.S. Oil supervisor dashboard: technician assignments and check-in oversight; identifying details removed" sizes="(max-width: 900px) 100vw, 820px" /><Img class="phone" k="uos-current-fryers-mobile" alt="U.S. Oil mobile workflow: fryer records, scheduling and service history; identifying details removed" sizes="240px" /></div><div class="stamp next"><div><span class="lab">05</span><div class="disp stamp-k">New website</div><span class="lab" style="color:var(--tealt)">In progress</span><p class="stamp-p">A second website is being built around the full oil-management program: filtration, top-offs, delivery, oil changes, pickup and reporting.</p></div><div class="stamp-vis" style="padding:0 0 14px 14px"><div class="diam"><div class="in"></div></div></div></div><div class="uso-shot" aria-label="Second public website in development"><span class="lab uso-shot-label">Second website · In progress</span><Img class="desk" k="uos-second-site-desktop" alt="U.S. Oil Solutions second public website, black and gold desktop design in development" sizes="(max-width: 900px) 100vw, 820px" /><Img class="phone" k="uos-second-site-mobile" alt="U.S. Oil Solutions second public website, mobile design in development" sizes="240px" /></div></div><div class="uso-prog"><i id="usoProg"></i></div></div></section>

<section class="band" style="border-top:3px solid var(--ink)"><div class="wrap"><span class="kick rv">How we work</span><ol class="commit"><li><span class="lab">01</span><span class="typed">You own your accounts, data and code.</span><span class="lock">■ Locked</span></li><li><span class="lab">02</span><span class="typed">Direct access to the people doing the work.</span><span class="lock">■ Locked</span></li><li><span class="lab">03</span><span class="typed">Reporting tied to revenue, not impressions.</span><span class="lock">■ Locked</span></li></ol></div></section>

<section class="band" id="team" style="padding-top:0"><div class="wrap"><div class="kick rv">The people behind the work</div><div class="team" data-team>{team.map((p) => <div class="person rv"><div class="person-ph"><img src={asset(p.photo).src} alt={p.name} width={asset(p.photo).width} height={asset(p.photo).height} loading="lazy" decoding="async" /></div><div class="person-n">{p.name}</div><div class="lab" style="margin-top:6px">{p.role}</div></div>)}</div></div></section>

<section class="band" id="notes" style="border-top:1px solid var(--line)"><div class="wrap"><span class="kick rv">Field notes</span><div class="notes rv">{posts.slice(0, 3).map((p) => <a class="note" href={'/blog/' + p.slug + '/'}><span class="lab">{dateLabel(p.dateGmt)} · {p.layer}</span><h3>{p.title}</h3></a>)}</div></div></section>

<section class="band"><div class="wrap"><div class="mcard"><div class="sph" data-par="0.05" style="width:420px;height:420px;left:8%;top:10%;animation:float1 12s ease-in-out infinite"></div><div class="sph" data-par="0.07" style="width:300px;height:300px;right:10%;bottom:6%;animation:float2 10s ease-in-out infinite"></div><span class="kick rv" style="position:relative;z-index:2"><span class="mdot"></span> Work with ZINC</span><h2 class="disp mcard-h rv">Every engagement starts with <span class="ctag"><span class="b">&lt;</span>model<span class="x">.py</span><span class="b">/&gt;</span></span></h2><p class="mcard-p rv">Search that isn't converting, brand systems that don't scale, reporting nobody trusts. Send the details and we'll tell you what's visible, what's missing, and what to model next.</p><a class="btn fill rv" href="/contact/">Start with a conversation</a></div></div></section>

<section class="band cta" id="inquiry"><div class="sph" data-par="0.06" style="width:520px;height:520px;left:-140px;top:-80px;animation:float2 12s ease-in-out infinite"></div><div class="sph" data-par="0.09" style="width:340px;height:340px;right:22%;bottom:-120px;animation:float1 10s ease-in-out infinite"></div><div class="wrap cta-grid"><div><span class="kick rv"><span class="mdot"></span> Work with ZINC</span><h2 class="disp cta-h rv" style="margin-top:18px">Send the <span class="hit" style="z-index:0">hard part.</span></h2><div class="acts rv" style="margin-top:36px"><a class="btn fill" href="/contact/">Open the form</a><a class="btn ghost" href="sms:+17865754837">Text (786) 575-4837</a></div></div><div class="rv" style="width:clamp(160px,18vw,260px);aspect-ratio:1"><div class="badge"><div class="bring2"></div><Img k="zinc-badge" class="bimg" alt="" sizes="260px" /><div class="bring"></div><div class="borbit"><div class="bdot"></div></div></div></div></div></section>


<script>
  import { initHome } from '../../scripts/home';
  initHome();
</script>
