---
import PageRail from "../PageRail.astro";
import heroLettering from '../../assets/brand/zinc-digital-balgin.svg?raw';
import ApprovedImage from '../ApprovedImage.astro';
import Img from '../Img.astro';
const slides=[{name:'build',image:'build-bear-claw-wide.png',alt:'Bear Claw USA website on a laptop and phone'},{name:'demand',image:'smd-devices',alt:'Retained ZINC-built Summit Marine Development website across devices'},{name:'intelligence',image:'intelligence-fusion-wide.png',alt:'ZINC Fusion v16 forecasting dashboard on desktop and tablet; private figures removed'}];
---
<section aria-label="ZINC Digital and our work" class="zn-hero" id="hero">
 <div class="wrap">
  <div class="zn-stage" data-lane="build">
   {slides.map((slide,i)=><div class="zn-hero-picture" data-zn-picture={slide.name} hidden={i!==0}>{slide.name==='demand' ? <Img k="smd-devices" alt={slide.alt} loading={i===0?'eager':'lazy'} fetchpriority="low" quality={95} sizes="(max-width: 760px) calc(100vw - 48px), 70vw" /> : <ApprovedImage name={slide.image} alt={slide.alt} loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':'low'} quality={100} formats={i===0?['webp']:undefined} sizes="(max-width: 760px) 150vw, 100vw" widths={[480,768,1100,1536,1672]} />}</div>)}
   <div class="zn-home-copy">
    <div class="zn-mast">
     <h1 aria-label="ZINC Digital — web design, AI search optimization and business intelligence in Panama City and Miami"><span class="sr-only">ZINC DIGITAL</span><span class="zn-stable-word" aria-hidden="true" set:html={heroLettering}></span></h1>
     <p><span>Other agencies deliver the scope.</span> ZINC delivers the business.</p>
    </div>
    <div class="zn-copy">
     <h2 id="zn-title">BUILD<span>.</span></h2>
     <p id="zn-description">Websites, commerce and applications.</p>
    </div>
   </div>
  </div>
  <div aria-label="Explore our three lanes" class="zn-tabs">
   <button aria-pressed="true" data-zn-lane="build" type="button">BUILD </button>
   <button aria-pressed="false" data-zn-lane="demand" type="button">DEMAND </button>
   <button aria-pressed="false" data-zn-lane="intelligence" type="button">INTELLIGENCE </button>
  </div>
 </div>
</section>
<PageRail path="/" title="Home" />
<script>
const root=document.querySelector('.zn-hero');
if(root){
// Defer hidden slides; warm them after the visible image decodes and two frames.
const warmSlides=()=>root.querySelectorAll<HTMLImageElement>('[data-zn-picture][hidden] img').forEach(image=>image.loading='eager');
const afterPaint=()=>requestAnimationFrame(()=>requestAnimationFrame(warmSlides));
const firstImage=root.querySelector<HTMLImageElement>('[data-zn-picture="build"] img');
firstImage?.decode().then(afterPaint,afterPaint);
const content={build:['BUILD','Websites, commerce and applications.'],demand:['DEMAND','Search. Campaigns. The path to a customer.'],intelligence:['INTELLIGENCE','Reporting and systems for the next decision.']};
root.querySelectorAll<HTMLButtonElement>('[data-zn-lane]').forEach(button=>button.addEventListener('click',()=>{const key=button.dataset.znLane as keyof typeof content;root.querySelector<HTMLElement>('.zn-stage')!.dataset.lane=key;root.querySelector('#zn-title')!.innerHTML=content[key][0]+'<span>.</span>';root.querySelector('#zn-description')!.innerHTML=content[key][1];root.querySelectorAll<HTMLElement>('[data-zn-picture]').forEach(p=>p.hidden=p.dataset.znPicture!==key);root.querySelectorAll('[data-zn-lane]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));}));
}
</script>