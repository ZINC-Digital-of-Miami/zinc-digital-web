---
import {pagePerformanceEvidence,sparklineSegments,type PerformancePage} from '../../lib/seo-review-dashboard';
interface Props {evidence:readonly unknown[]}
const data=pagePerformanceEvidence(Astro.props.evidence);
const format=(v:number|null|undefined)=>typeof v==='number'?new Intl.NumberFormat('en-US',{maximumFractionDigits:1}).format(v):'—';
const change=(current:number|null,previous:number|null)=>current===null||previous===null?'No comparison':`${current-previous>0?'+':''}${format(current-previous)}`;
const series=(p:PerformancePage)=>p.series.ga4.length?{metric:'views',source:'GA4',values:p.series.ga4.map(v=>({date:v.date,value:v.views}))}:p.series.gsc.length?{metric:'clicks',source:'Search Console',values:p.series.gsc.map(v=>({date:v.date,value:v.clicks}))}:null;
const spark=(p:PerformancePage)=>{const s=series(p);return s&&data?{...s,segments:sparklineSegments(s.values,data.range.current.start,data.range.current.end)}:null;};
const blogs=data?.pages.filter(p=>p.kind==='blog')||[],servicePages=data?.pages.filter(p=>p.kind==='service')||[];
const blogSearch=Astro.url.searchParams.get('blogSearch')||'';
const filteredBlogs=blogs.filter(p=>(p.title+' '+p.path).toLowerCase().includes(blogSearch.toLowerCase()));
const blogPages=Math.max(1,Math.ceil(filteredBlogs.length/20)),requestedBlogPage=Number(Astro.url.searchParams.get('blogPage')||1),blogPage=Number.isSafeInteger(requestedBlogPage)?Math.max(1,Math.min(blogPages,requestedBlogPage)):1;
const visibleBlogs=filteredBlogs.slice((blogPage-1)*20,blogPage*20);
const blogPageLink=(n:number)=>{const q=new URLSearchParams(Astro.url.searchParams);q.set('blogPage',String(n));return '/admin/analysis/?'+q+'#blog-performance';};
const preserved=[...Astro.url.searchParams.entries()].filter(([key])=>!['blogSearch','blogPage'].includes(key));
const find=new Map(data?.pages.map(p=>[p.path,p])||[]);
const observedTotal=(values:(number|null|undefined)[])=>{const observed=values.filter((v):v is number=>typeof v==='number');return observed.length?observed.reduce((a,b)=>a+b,0):null;};
---
<section class="content-performance" aria-labelledby="content-performance-title">
 <div class="performance-title"><div><p class="a-label a-muted">Content → service</p><h2 id="content-performance-title">What brings people closer</h2></div>{data&&<p class="a-count">{data.range.current.start} → {data.range.current.end}<br/>Previous: {data.range.previous.start} → {data.range.previous.end}</p>}</div>
 <p class="a-muted">Follow each article’s performance, its service pillar and the service pages people view next. Referrer measurements are page views, not unique clicks or qualified leads.</p>
 {!data?<p class="a-empty">Refresh site checks to collect native blog, service and pillar performance.</p>:<>
  {(!data.sources.ga4.available||!data.sources.gsc.available||!data.sources.transitions?.available)&&<div class="performance-gaps">{!data.sources.ga4.available&&<p>GA4: {data.sources.ga4.gap||'Page performance is unavailable.'}</p>}{!data.sources.gsc.available&&<p>Search Console: {data.sources.gsc.gap||'Page performance is unavailable.'}</p>}{!data.sources.transitions?.available&&<p>Article → service: {data.sources.transitions?.gap||'Native referrer evidence is unavailable.'}</p>}</div>}
  <section id="blog-performance" class="performance-section" aria-labelledby="blog-performance-title"><h3 id="blog-performance-title">Blog performance</h3><p class="a-count">Each article has its own sparkline. Gaps remain gaps; scales are local to each row and start at zero.</p><form class="blog-filter" method="get" action="/admin/analysis/">{preserved.map(([name,value])=><input type="hidden" name={name} value={value}/>)}<label class="a-field"><span>Find an article</span><input class="a-input" name="blogSearch" type="search" value={blogSearch} maxlength="150" placeholder="Article title or path"/></label><button class="a-button" type="submit">Find</button></form><div class="performance-table" tabindex="0" role="region" aria-label="Blog performance"><table><thead><tr><th scope="col">Article</th><th scope="col">Current trend</th><th scope="col">Views / change</th><th scope="col">Search clicks / change</th><th scope="col">Impressions</th><th scope="col">Target-service views</th></tr></thead><tbody>{visibleBlogs.map(p=>{const s=spark(p);return <tr><th scope="row"><a class="a-link" href={p.path}>{p.title}</a><small>{p.pillars.map(slug=><a class="a-link" href={'#pillar-'+slug}>{data.pillars.find(g=>g.slug===slug)?.title||slug} </a>)}</small></th><td>{s?<><svg class="performance-spark" viewBox="0 0 120 36" role="img" aria-label={`${p.title}, ${s.source} daily ${s.metric}: `+s.values.map(v=>v.date+': '+v.value).join('; ')}><line x1="4" x2="116" y1="30" y2="30" class="spark-base"/>{s.segments.map(segment=><>{segment.length>1&&<polyline class="spark-line" points={segment.map(v=>`${v.x},${v.y}`).join(' ')}/>} {segment.map(v=><circle class="spark-dot" cx={v.x} cy={v.y} r="2"/>)}</>)}</svg><small>{s.source} · {s.metric}</small></>:<small>No observed series</small>}</td><td class="numeric">{format(p.current.views)}<small>{change(p.current.views,p.previous.views)}</small></td><td class="numeric">{format(p.current.clicks)}<small>{change(p.current.clicks,p.previous.clicks)}</small></td><td class="numeric">{format(p.current.impressions)}</td><td class="numeric">{format(p.serviceReferrals?.current)}<small>Referrer-based page views</small></td></tr>;})}</tbody></table></div><nav class="blog-pagination" aria-label="Blog performance pagination"><span class="a-count">{filteredBlogs.length?`${(blogPage-1)*20+1}–${Math.min(blogPage*20,filteredBlogs.length)} of ${filteredBlogs.length} articles`:"No articles match this search."}</span><div>{blogPage>1&&<a class="a-button" href={blogPageLink(blogPage-1)}>Previous</a>}{blogPage<blogPages&&<a class="a-button" href={blogPageLink(blogPage+1)}>Next</a>}</div></nav></section>
  <section class="performance-section" aria-labelledby="service-performance-title"><h3 id="service-performance-title">Service page performance</h3><div class="performance-table" tabindex="0" role="region" aria-label="Service page performance"><table><thead><tr><th scope="col">Service page</th><th scope="col">Current trend</th><th scope="col">Views / change</th><th scope="col">Search clicks / change</th><th scope="col">Engagement time</th></tr></thead><tbody>{servicePages.map(p=>{const s=spark(p);return <tr><th scope="row"><a class="a-link" href={p.path}>{p.title}</a></th><td>{s?<><svg class="performance-spark" viewBox="0 0 120 36" role="img" aria-label={`${p.title}, ${s.source} daily ${s.metric}: `+s.values.map(v=>v.date+': '+v.value).join('; ')}><line x1="4" x2="116" y1="30" y2="30" class="spark-base"/>{s.segments.map(segment=><>{segment.length>1&&<polyline class="spark-line" points={segment.map(v=>`${v.x},${v.y}`).join(' ')}/>} {segment.map(v=><circle class="spark-dot" cx={v.x} cy={v.y} r="2"/>)}</>)}</svg><small>{s.source} · {s.metric}</small></>:<small>No observed series</small>}</td><td class="numeric">{format(p.current.views)}<small>{change(p.current.views,p.previous.views)}</small></td><td class="numeric">{format(p.current.clicks)}<small>{change(p.current.clicks,p.previous.clicks)}</small></td><td class="numeric">{format(p.current.engagementSeconds)} s<small>Total foreground time</small></td></tr>;})}</tbody></table></div></section>
  <section class="performance-section" aria-labelledby="pillar-performance-title"><h3 id="pillar-performance-title">Pillar performance</h3><p class="a-muted">Each pillar is a focused set of articles supporting its target service page. Membership can overlap; these areas must not be added together as separate audiences.</p><nav class="pillar-index" aria-label="Content pillars">{data.pillars.map(p=><a href={'#pillar-'+p.slug}>{p.title}</a>)}</nav>{data.pillars.map(p=>{const articles=p.articlePaths.map(path=>find.get(path)).filter((row):row is PerformancePage=>!!row),views=observedTotal(articles.map(a=>a.current.views)),clicks=observedTotal(articles.map(a=>a.current.clicks));return <details id={'pillar-'+p.slug} class="pillar-area"><summary><span>{p.title}</span><small>{p.articlePaths.length} articles → target service</small></summary><div class="pillar-destination"><p><a class="a-link" href={'/blog/category/'+p.slug+'/'}>Open article pillar</a><span aria-hidden="true"> → </span><a class="a-link" href={p.servicePath}>Open {p.title} service page</a></p><dl><div><dt>Observed article views</dt><dd>{format(views)}</dd></div><div><dt>Observed search clicks</dt><dd>{format(clicks)}</dd></div><div><dt>Service views referred from pillar articles</dt><dd>{format(p.serviceReferrals?.current)}<small>{change(p.serviceReferrals?.current??null,p.serviceReferrals?.previous??null)} vs previous</small></dd></div></dl></div><div class="performance-table" tabindex="0" role="region" aria-label={p.title+' pillar articles'}><table><thead><tr><th scope="col">Supporting article</th><th scope="col">Views</th><th scope="col">Search clicks</th><th scope="col">Views referred to target service</th></tr></thead><tbody>{p.articlePaths.map(path=>{const article=find.get(path),transition=data.transitions?.find(t=>t.articlePath===path&&t.servicePath===p.servicePath);return <tr><th scope="row"><a class="a-link" href={path}>{article?.title||path}</a></th><td class="numeric">{format(article?.current.views)}</td><td class="numeric">{format(article?.current.clicks)}</td><td class="numeric">{format(transition?.current)}</td></tr>;})}</tbody></table></div></details>;})}</section>
  <details class="performance-limits"><summary>Performance definitions &amp; source limits</summary><ul>{data.notes.map(note=><li>{note}</li>)}</ul><p class="a-count">GA4 reporting timezone: {data.sources.ga4.timeZone||'unavailable'} · Search Console: {data.sources.gsc.timeZone||'America/Los_Angeles'}</p></details>
 </>}
</section>
<style>
 .content-performance :is(h2,h3),.pillar-area>summary>span,.pillar-destination dd{font-family:var(--font-display),sans-serif;font-weight:800;letter-spacing:-.025em}.performance-table thead th{font-family:var(--font-mono),sans-serif;font-weight:400;font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:var(--muted)}.pillar-destination dd small{font-family:var(--font-body),sans-serif;font-weight:400;letter-spacing:0} .blog-filter{display:flex;gap:14px;align-items:end;margin:20px 0}.blog-filter label{flex:1;max-width:480px}.blog-pagination{display:flex;justify-content:space-between;align-items:center;gap:18px;flex-wrap:wrap;margin-top:18px}.blog-pagination div{display:flex;gap:10px} .content-performance{padding:30px 0;border-top:1px solid var(--line);margin-top:30px;min-width:0}.performance-title{display:flex;justify-content:space-between;gap:22px;align-items:flex-start;flex-wrap:wrap}.performance-title h2{font-size:25px;margin:4px 0}.performance-title p{margin:0;line-height:1.8}.performance-section{margin:30px 0}.performance-section h3{font-size:20px;margin:0 0 12px}.performance-table{overflow:auto;border-top:1px solid var(--line);margin-top:18px}.performance-table table{border-collapse:collapse;width:100%;font-size:14px;min-width:800px}.performance-table th,.performance-table td{padding:14px 12px;text-align:left;vertical-align:middle;border-bottom:1px solid var(--line)}.performance-table th[scope=row]{font-weight:500;min-width:220px;max-width:420px;overflow-wrap:anywhere}.performance-table small{display:block;color:var(--muted);font-size:11px;font-weight:400;margin-top:6px}.performance-table .numeric{font-variant-numeric:tabular-nums}.performance-spark{width:120px;display:block;overflow:visible}.spark-base{stroke:var(--line);stroke-width:1}.spark-line{stroke:var(--tealt);stroke-width:2;fill:none;stroke-linejoin:round}.spark-dot{fill:var(--tealt)}.performance-gaps{border-left:3px solid var(--mag);padding:2px 0 2px 18px;margin-top:20px;font-size:14px;color:var(--muted)}.performance-gaps p{margin:8px 0}.pillar-index{display:flex;flex-wrap:wrap;gap:8px 18px;font-size:13px;margin:20px 0}.pillar-index a{color:var(--tealt);text-decoration:underline}.pillar-area{border-top:1px solid var(--line);scroll-margin-top:20px}.pillar-area>summary{cursor:pointer;min-height:64px;padding:20px 0;font-size:17px}.pillar-area>summary small{font-size:12px;color:var(--muted);margin-left:20px}.pillar-destination{padding:0 0 16px}.pillar-destination dl{display:grid;grid-template-columns:1fr 1fr 1.5fr;gap:24px;margin:24px 0 6px}.pillar-destination dt{font-family:var(--font-mono),monospace;font-size:11px;color:var(--muted);text-transform:uppercase;line-height:1.7}.pillar-destination dd{margin:8px 0 0;font-size:24px;font-variant-numeric:tabular-nums}.pillar-destination dd small{display:block;font-size:11px;color:var(--muted);margin-top:6px}.performance-limits{padding:20px 0;color:var(--muted);font-size:13px}.performance-limits summary{cursor:pointer}.performance-limits li{margin:10px 0;line-height:1.6}@media(max-width:700px){.pillar-area>summary small{display:block;margin:8px 0 0 18px}.pillar-destination dl{grid-template-columns:1fr 1fr;gap:18px}.pillar-destination dl>div:last-child{grid-column:1/-1}.performance-title h2{font-size:23px}}
</style>
