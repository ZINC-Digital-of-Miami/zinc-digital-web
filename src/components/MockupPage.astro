---
import MockupBands from './MockupBands.astro';
import {services,layers,cases,posts,assets,clients,toSitePath,dateLabel,type Route,type Pairing} from '../data/mockup';
interface Props {route:Route;pairing:Pairing;basePath?:string}
const {route,pairing,basePath=''}=Astro.props;
const link=(path:string,query?:Record<string,string>)=>toSitePath(path,basePath,query);
const service=services.find(s=>s.slug===route.slug);
const study=cases.find(c=>c.slug===route.slug);
const post=posts.find(p=>p.slug===route.slug);
const photo=(key:string)=>assets[key as keyof typeof assets];
---
{route.template==='home' ? <MockupBands pairing={pairing} basePath={basePath}/> : <>
<section class="band page-intro" data-theme="light" data-template={route.template}>
  <div class="band__inner">
    <p class="t-label eyebrow">ZINC / {route.layer || route.template} <span class="draft-tag">[DRAFT]</span></p>
    <h1 class="page-title">{route.title}</h1>
    {service && <p class="lede muted">{service.line}</p>}
    {study && <p class="lede muted">{study.line}</p>}
    {route.template==='services' && <p class="lede muted">One connected system. The customer experience, the demand behind it and the information that informs both.</p>}
    {route.template==='about' && <p class="lede muted">Seven people. Connected responsibilities across the work a business needs.</p>}
    {route.template==='blog' && <p class="lede muted">Source-backed thinking on building, reaching customers and measuring the work.</p>}
    {post && <><p class="t-label article-meta">{dateLabel(post.dateGmt)} / {post.author.name} / {post.layer}</p><p class="draft-notice">Draft migration preview — editorial review pending.</p></>}
  </div>
</section>

{(route.template==='services'||service) && <section class="band" data-theme="dark"><div class="band__inner">
  <p class="t-label eyebrow">The connected system</p><h2 class="section-title">Build. Demand. Intelligence.</h2>
  <div class="layer-grid mini-loop">{layers.map((layer,i)=><div class:list={['layer',{active:service?.layer===layer}]}><p class="t-label">0{i+1} / {service?.layer===layer?'Current layer':'Connected layer'}</p><h3 class="t-heading">{layer}</h3><ul class="link-list">{services.filter(s=>s.layer===layer).map(s=><li><a href={link('/services/'+s.slug+'/')} aria-current={service?.slug===s.slug?'page':undefined}>{s.title}<span aria-hidden="true">↗</span></a></li>)}</ul></div>)}</div>
</div></section>}

{service && <>
  <section class="band" data-theme="light"><div class="band__inner"><p class="t-label eyebrow">Service specification / [DRAFT]</p><h2 class="section-title">What the work includes.</h2><dl class="spec-grid"><div><dt class="t-label">Deliverables</dt><dd><ul>{service.deliverables.map(item=><li>{item}</li>)}</ul></dd></div><div><dt class="t-label">Cadence</dt><dd>{service.cadence}</dd></div><div><dt class="t-label">Client owns</dt><dd>{service.owns}</dd></div><div><dt class="t-label">Reported</dt><dd>{service.reported}</dd></div></dl></div></section>
  <section class="band" data-theme="dark"><div class="band__inner split"><div><p class="t-label eyebrow">Related work / scope varies by service</p><h2 class="section-title">{cases.find(c=>c.slug===service.caseSlug)?.title}</h2></div><div><p class="muted">[DRAFT] See the confirmed relationship and connected work. Specific results and service attribution remain subject to owner confirmation.</p><a class="arrow-link" href={link('/work/'+service.caseSlug+'/')}>Read the case study <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="band" data-theme="light"><div class="band__inner split"><div><p class="t-label eyebrow">Before the work begins</p><h2 class="section-title">Useful questions.</h2></div><div class="faq-list">{service.questions.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p class="muted">{a}</p></details>)}</div></div></section>
  <section class="band" data-theme="dark"><div class="band__inner"><p class="t-label eyebrow">Connect the next part</p><h2 class="section-title">Start with {service.title.toLowerCase()}.</h2><a class="button" href={link('/contact/',{service:service.slug})}>Start an Inquiry</a><div class="related-links">{service.related.map(slug=><a href={link('/services/'+slug+'/')}>{services.find(s=>s.slug===slug)?.title} ↗</a>)}</div></div></section>
</>}

{route.template==='work' && <>
  <section class="band" data-theme="dark"><div class="band__inner"><p class="t-label eyebrow">Selected client relationships</p><div class="client-grid">{clients.map(name=><div class="client-name"><span>{name}</span><small class="t-label">[LOGO PENDING]</small></div>)}</div></div></section>
  {cases.map((c,i)=><section class="band" data-theme={i===0?'light':'dark'}><div class="band__inner case-preview"><div><p class="t-label eyebrow">Case study / 0{i+1}</p><h2 class="section-title">{c.title}</h2><p class="lede">[DRAFT] {c.line}</p><p class="muted">{c.layers.join(' / ')}</p><a class="arrow-link" href={link('/work/'+c.slug+'/')}>Read the case study ↗</a></div><figure class="device-frame"><img src={photo(c.images[0]).src} width={photo(c.images[0]).width} height={photo(c.images[0]).height} alt={c.title+' source screenshot'} loading="lazy"/></figure></div></section>)}
</>}
{study && <>
  <section class="band result-band" data-theme="dark"><div class="band__inner"><p class="t-label eyebrow">Results / awaiting source confirmation</p><div class="receipt-grid">{study.receipts.map(receipt=><p class="receipt">{receipt}</p>)}</div><a class="arrow-link" href={study.url} rel="noopener noreferrer">Visit the public client site ↗</a></div></section>
  <section class="band" data-theme="light"><div class="band__inner split"><div><p class="t-label eyebrow">01 / The situation</p><h2 class="section-title">The next business need.</h2></div><div><p class="lede">{study.situation}</p><p class="muted">[DRAFT] This preview records the confirmed scope of the relationship. Dates, commercial outcomes and client-approved results are still being verified.</p></div></div></section>
  <section class="band" data-theme="dark"><div class="band__inner"><p class="t-label eyebrow">02 / The connected work</p><h2 class="section-title">The layers in use.</h2><div class="layer-grid mini-loop">{layers.map((layer,i)=><div class:list={['layer',{active:study.layers.includes(layer)}]}><p class="t-label">0{i+1} / {study.layers.includes(layer)?'Active layer':'Scope to confirm'}</p><h3 class="t-heading">{layer}</h3><p class="muted">[DRAFT] {study.work.find(w=>w[0]===layer)?.[1]}</p><ul class="link-list">{services.filter(s=>study.services.includes(s.slug)&&s.layer===layer).map(s=><li><a href={link('/services/'+s.slug+'/')}>{s.title} ↗</a></li>)}</ul></div>)}</div></div></section>
  <section class="band" data-theme="light"><div class="band__inner"><p class="t-label eyebrow">03 / The work on screen</p><h2 class="section-title">Built for the work.</h2><p class="muted">Source screenshots. Application and reporting surfaces are shown as images only.</p><div class="screens-grid">{study.images.map((key,i)=><figure class:list={['device-frame',{'phone-frame':key.includes('phone')||key.includes('mobile')}]} style={'--source-half:'+photo(key).width/2+'px'}><div class="device-chrome" aria-hidden="true">{key.includes('mobile')||key.includes('phone')?'—':'○ ○ ○'}</div><div class="device-viewport" tabindex="0" role="region" aria-label={study.title+' screenshot '+(i+1)}><img src={photo(key).src} width={photo(key).width} height={photo(key).height} alt={study.title+' — '+key.replace(/-/g,' ')} loading="lazy"/></div><figcaption class="t-label">{key.replace(/-/g,' ')} / original capture</figcaption></figure>)}</div><p class="draft-notice">[OWNER CONFIRM] Client testimonial and attribution pending. No quote is presented as approved.</p></div></section>
  <section class="band" data-theme="dark"><div class="band__inner"><p class="t-label eyebrow">Next case</p><h2 class="section-title">{cases.find(c=>c.slug===study.next)?.title}</h2><a class="arrow-link" href={link('/work/'+study.next+'/')}>Continue through the work ↗</a></div></section>
</>}
{route.template==='about' && <>
  <section class="band" data-theme="dark"><div class="band__inner split"><h2 class="section-title">The business sets the work.</h2><div><p class="lede">[DRAFT] ZINC brings build, demand and intelligence into one working relationship.</p><p class="muted">The team’s roles span business strategy, content, ecommerce, applications and code. Responsibilities are made explicit for each engagement.</p></div></div></section>
  <MockupBands pairing={pairing} part="team" basePath={basePath}/>
  <section class="band" data-theme="dark"><div class="band__inner split"><div><p class="t-label eyebrow">How an engagement runs / [DRAFT]</p><h2 class="section-title">A clear working sequence.</h2></div><ol class="commitments">{[['Understand','Agree on the business problem, the sources and the people responsible.'],['Define','Set the scope, decision points and measures that will guide the work.'],['Build and review','Bring complete working increments to a shared review.'],['Measure and adjust','Check outcomes and choose the next priorities from evidence.']].map(([name,body])=><li><div><h3 class="t-heading">{name}</h3><p>{body}</p><span class="draft-tag">[OWNER CONFIRM]</span></div></li>)}</ol></div></section>
</>}
{route.template==='blog' && <section class="band" data-theme="dark"><div class="band__inner"><div class="filter-bar" data-blog-filters><p class="t-label">Filter by layer</p>{['All',...layers].map((layer,i)=><button type="button" data-filter={layer} aria-pressed={i===0}>{layer}</button>)}</div><p class="t-label result-count" data-result-count aria-live="polite">18 articles</p><p class="draft-notice">Draft migration preview — editorial review pending. Layer assignments are draft editorial groupings.</p><div class="article-grid" data-blog-list>{posts.map(p=><article class="article-card" data-layer={p.layer}><p class="t-label muted">{dateLabel(p.dateGmt)} / {p.layer}</p><h2 class="t-heading"><a href={link('/blog/'+p.slug+'/')}>{p.title}</a></h2><p class="muted">{p.blocks.find(b=>b.type==='p')?.runs?.map(r=>r.text).join('').slice(0,180)}…</p><a class="arrow-link" href={link('/blog/'+p.slug+'/')}>Read the full article ↗</a></article>)}</div><div class="empty-state" data-empty hidden><h2 class="t-heading">No articles in this layer yet.</h2><p>Return to the full archive to continue reading.</p><button class="button" type="button" data-clear-filter>Clear filter</button></div></div></section>}
{post && <>
  <section class="band article-band" data-theme="light"><div class="band__inner article-layout"><aside class="article-sidebar"><p class="t-label">Source article / {post.id}</p><p class="muted">Originally published {dateLabel(post.dateGmt)}.</p><p class="draft-tag">Legacy search terminology expanded for this preview. Full editorial review remains pending.</p><a class="arrow-link" href={link('/blog/')}>Back to articles ↗</a></aside><article class="prose" data-source-id={post.id} data-source-blocks={post.blocks.length}>{post.blocks.map((block,i)=>block.type==='heading'?<h2 id={'section-'+i}>{block.runs?.map(run=>run.text).join('')}</h2>:block.type==='ul'||block.type==='ol'?<Fragment>{block.type==='ol'?<ol>{block.items?.map(item=><li>{item.map(run=>run.href?<a href={run.href.startsWith('/')?link(run.href):run.href}>{run.text}</a>:run.text)}</li>)}</ol>:<ul>{block.items?.map(item=><li>{item.map(run=>run.href?<a href={run.href.startsWith('/')?link(run.href):run.href}>{run.text}</a>:run.text)}</li>)}</ul>}</Fragment>:block.type==='quote'?<blockquote>{block.runs?.map(run=>run.href?<a href={run.href.startsWith('/')?link(run.href):run.href}>{run.text}</a>:run.text)}</blockquote>:<p>{block.runs?.map(run=>run.href?<a href={run.href.startsWith('/')?link(run.href):run.href}>{run.text}</a>:run.text)}</p>)}</article></div></section>
  <section class="band" data-theme="dark"><div class="band__inner split"><div><p class="t-label eyebrow">Source author</p><h2 class="section-title">{post.author.name}</h2><p class="muted">{post.author.description||'[OWNER CONFIRM] Author biography pending.'}</p><p class="draft-tag">Attribution from public source record {post.author.id}.</p></div><div><h3 class="t-heading">Related services</h3><ul class="link-list">{post.related.map(slug=><li><a href={link('/services/'+slug+'/')}>{services.find(s=>s.slug===slug)?.title} ↗</a></li>)}</ul><a class="arrow-link" href={link('/blog/')}>Return to all articles ↗</a></div></div></section>
</>}
{(route.template==='privacy'||route.template==='terms') && <section class="band" data-theme="dark"><div class="band__inner legal-layout"><aside><p class="draft-notice">[DRAFT — OWNER/LEGAL REVIEW REQUIRED]</p><p class="muted">This public design preview does not present an approved legal policy. Production terms and disclosures require review before launch.</p></aside><div class="prose">{(route.template==='privacy'?[
['About this preview','This site is a public design draft for ZINC Digital. Its contact interface demonstrates a possible inquiry journey. The demo does not send or retain the information entered into it. Use sample information while reviewing the design.'],
['Information in an inquiry','The planned production form includes a name, company, work email, website, service interests, budget, timeline and message. Production collection, delivery, access and retention rules must be confirmed before the form is connected.'],
['Hosting and technical requests','Loading this preview requests files from its hosting provider. The provider may process technical request information under its own policies. This draft does not make a promise about provider log retention.'],
['Measurement and cookies','No advertising or analytics integration is connected to this mockup. The planned production site includes Google Analytics and advertising measurement. The final policy must describe the actual configuration and applicable choices.'],
['Sharing and service providers','The production policy must identify the purposes for which information is used and the providers involved in hosting, inquiry delivery and measurement. These details are awaiting owner review.'],
['Retention and requests','Retention periods, deletion procedures and the process for handling access or correction requests must be documented before launch. Do not rely on this draft as a statement of those procedures.'],
['External links','Links to client sites, social platforms and reference sources lead to independently operated services. Their information practices are governed by their own policies.'],
['Contact and changes','Questions about the planned policy can be directed to hello@zincdigital.co. An effective date and reviewed policy will replace this marked draft before production launch.']
]:[
['Purpose of this preview','This public website is a design preview for ZINC Digital. Content marked as draft, receipt pending or owner confirmation has not been approved as a final commercial representation.'],
['No engagement created','Browsing this preview or completing its non-sending demo does not create a client relationship, request a service or establish an agreement. A separate written agreement defines any actual engagement.'],
['Scope and service descriptions','Service pages illustrate proposed ways of describing deliverables, ownership, cadence and reporting. An agreed scope must establish the work, responsibilities, fees and approvals for a specific engagement.'],
['Results and examples','Case studies contain visible markers wherever results require confirmation. No performance outcome, ranking or revenue result is guaranteed by this preview. Source screenshots demonstrate prior interfaces and are not live client applications.'],
['Content and intellectual property','Ownership and permitted use of final site content, client materials, software and third-party assets require appropriate agreements and permissions. No license to reuse a client asset is granted by displaying it here.'],
['Third-party services','Linked sites and platforms operate independently. Access to a public link does not imply that ZINC controls that service, its availability or its terms.'],
['Acceptable use','Use the preview for lawful review. Do not submit sensitive information into demo fields or attempt to access private systems through screenshots or example content.'],
['Final legal review','Liability provisions, governing law, dispute handling and an effective date must be reviewed by the owner and appropriate legal counsel. This marked draft does not assert accepted terms. Contact hello@zincdigital.co with questions.']
]).map(([heading,body],i)=><section><p class="t-label">0{i+1}</p><h2>{heading}</h2><p>{body}</p></section>)}</div></div></section>}
{route.template==='404' && <section class="band" data-theme="dark"><div class="band__inner"><p class="t-label eyebrow">404 / [DRAFT]</p><h2 class="section-title">That page is not here.</h2><p class="lede muted">The address may have changed. Continue with the services, explore the work or return to the homepage.</p><div class="related-links"><a class="button" href={link('/')}>Home</a><a href={link('/services/')}>Services ↗</a><a href={link('/contact/')}>Contact ↗</a></div></div></section>}
{route.template==='contact' && <section class="band contact-band" data-theme="dark"><div class="band__inner contact-layout"><aside><p class="t-label eyebrow">Inquiry preview</p><h2 class="section-title">The right starting point.</h2><p class="demo-notice" id="demo-notice">Demo inquiry — no message will be sent</p><p class="muted">Use sample information to explore this form. Nothing is submitted or stored.</p><a class="arrow-link" href="sms:+17865754837">Text (786) 575-4837 ↗</a></aside>
  <div class="demo-form" data-demo-form data-thanks={link('/thanks/')} role="group" aria-describedby="demo-notice">
    <p class="t-label step-label" data-step-label aria-live="polite">Inquiry details</p>
    <fieldset data-step="0"><legend class="t-heading">01 / Your business</legend><div class="field-grid"><label>Name<input id="inquiry-name" autocomplete="off" required maxlength="120" /></label><label>Company<input id="inquiry-company" autocomplete="off" required maxlength="160" /></label><label>Work email<input id="inquiry-email" type="email" autocomplete="off" required maxlength="254" /></label><label>Website URL<input id="inquiry-website" type="url" autocomplete="off" placeholder="https://" required maxlength="500" /></label></div></fieldset>
    <fieldset data-step="1"><legend class="t-heading">02 / What you need</legend>{layers.map(layer=><div class="service-options"><h3 class="t-label">{layer}</h3>{services.filter(s=>s.layer===layer).map(s=><label class="check-option"><input type="checkbox" value={s.slug} data-service />{s.title}</label>)}</div>)}<div class="field-grid"><label>Monthly budget<select id="inquiry-budget" required><option value="">Choose a range</option>{['Under $5k/mo','$5–10k/mo','$10–25k/mo','$25k+/mo'].map(x=><option>{x}</option>)}</select></label><label>Timeline<select id="inquiry-timeline" required><option value="">Choose a timeline</option>{['As soon as practical','Within three months','Three to six months','Exploring options'].map(x=><option>{x}</option>)}</select></label></div></fieldset>
    <fieldset data-step="2"><legend class="t-heading">03 / The context</legend><label>Message<textarea id="inquiry-message" rows="6" required maxlength="3000"></textarea></label><p class="muted">Demo only. The next screen previews the confirmation; it does not contact ZINC.</p></fieldset>
    <p class="form-error" data-form-error role="alert"></p><div class="form-controls" hidden data-form-controls><button type="button" class="text-button" data-back>Back</button><button type="button" class="button" data-next>Continue</button></div>
    <noscript><p>JavaScript is off. All fields remain visible. This is a non-sending demo.</p><a class="button" href={link('/thanks/')}>Preview demo confirmation</a></noscript>
  </div>
</div></section>}

{route.template==='thanks' && <section class="band" data-theme="dark"><div class="band__inner"><p class="t-label eyebrow">Preview complete</p><h2 class="section-title">Demo only — nothing was sent</h2><p class="lede muted">No inquiry was submitted and no form details were saved. You can return to the form or keep exploring the work.</p><div class="hero-actions"><a class="button" href={link('/contact/')}>Return to inquiry</a><a class="arrow-link" href={link('/work/')}>Explore the work ↗</a></div></div></section>}
<MockupBands pairing={pairing} part="footer" basePath={basePath}/>
</>}

<script>
  const filters=document.querySelector('[data-blog-filters]');
  if(filters){const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-blog-list] > [data-layer]'));const setFilter=(layer:string)=>{let count=0;cards.forEach(card=>{card.hidden=layer!=='All'&&card.dataset.layer!==layer;if(!card.hidden)count++;});document.querySelector<HTMLElement>('[data-result-count]')!.textContent=`${count} article${count===1?'':'s'}`;document.querySelector<HTMLElement>('[data-empty]')!.hidden=count>0;filters.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.filter===layer)));};filters.addEventListener('click',event=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');if(button)setFilter(button.dataset.filter!);});document.querySelector('[data-clear-filter]')?.addEventListener('click',()=>{setFilter('All');filters.querySelector<HTMLButtonElement>('[data-filter]')?.focus();});}
  const form=document.querySelector<HTMLElement>('[data-demo-form]');
  if(form) {
    const steps=Array.from(form.querySelectorAll<HTMLFieldSetElement>('[data-step]'));
    const controls=form.querySelector<HTMLElement>('[data-form-controls]')!;
    const next=form.querySelector<HTMLButtonElement>('[data-next]')!;
    const back=form.querySelector<HTMLButtonElement>('[data-back]')!;
    const label=form.querySelector<HTMLElement>('[data-step-label]')!;
    const error=form.querySelector<HTMLElement>('[data-form-error]')!;
    let step=0;
    const params=new URLSearchParams(location.search).getAll('service');
    if(params.length===1) for(const field of form.querySelectorAll<HTMLInputElement>('[data-service]')) field.checked=field.value===params[0];
    controls.hidden=false;
    function show(focus=false){steps.forEach((el,i)=>el.hidden=i!==step);back.hidden=step===0;next.textContent=step===2?'Preview demo confirmation':'Continue';label.textContent=`Step ${step+1} of 3`;error.textContent='';if(focus){steps[step].querySelector<HTMLElement>('input,select,textarea')?.focus();}}
    function advance(){const fields=Array.from(steps[step].querySelectorAll<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement>('input,select,textarea'));const invalid=fields.find(field=>!field.checkValidity());if(invalid){error.textContent='Complete the required fields with valid sample information.';invalid.reportValidity();return;}if(step===1&&!form!.querySelector<HTMLInputElement>('[data-service]:checked')){error.textContent='Choose at least one service to continue.';return;}if(step<2){step++;show(true);}else {location.assign(form!.dataset.thanks!);}}
    next.addEventListener('click',advance);back.addEventListener('click',()=>{step--;show(true);});
    form.addEventListener('keydown',event=>{if(event.key==='Enter'&&event.target instanceof HTMLInputElement){event.preventDefault();advance();}});
    show();
  }
</script>
