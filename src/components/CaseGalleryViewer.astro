<dialog class="gallery-viewer" aria-labelledby="gallery-viewer-title">
  <div class="viewer-toolbar"><div><span class="viewer-count" aria-live="polite"></span><h2 id="gallery-viewer-title"></h2></div><button type="button" data-viewer-close aria-label="Close image viewer">Close <span aria-hidden="true">×</span></button></div>
  <div class="viewer-stage" tabindex="0" aria-label="Image detail. Use arrow keys to browse; zoom for a closer view."></div>
  <p class="viewer-status" role="status"></p>
  <div class="viewer-controls"><div><button type="button" data-viewer-prev aria-label="Previous image"><span>Previous</span></button><button type="button" data-viewer-next aria-label="Next image"><span>Next</span> </button></div><button type="button" data-viewer-zoom aria-pressed="false">Zoom in +</button><a data-viewer-original target="_blank" rel="noopener">Open full image </a></div>
</dialog>
<script>
  import { initCaseGallery } from '../scripts/case-gallery';
  initCaseGallery();
</script>
<style>
.gallery-viewer{inset:0;width:100vw;height:100dvh;max-width:none;max-height:none;margin:0;padding:24px clamp(16px,3vw,48px);border:0;background:#111314;color:#f5f3ed;font-family:var(--font-body),sans-serif;overflow:hidden}.gallery-viewer[open]{display:grid;grid-template-rows:auto minmax(0,1fr) auto auto;gap:16px}.gallery-viewer::backdrop{background:#111}.viewer-toolbar{display:flex;justify-content:space-between;align-items:center;gap:24px}.viewer-count{font:12px/1.4 var(--font-mono),sans-serif;color:#bfc3c5}.viewer-toolbar h2{font:500 clamp(18px,2vw,26px)/1.3 var(--font-body),sans-serif;letter-spacing:-.025em;margin:6px 0 0}.gallery-viewer button,.gallery-viewer a{min-height:44px;background:transparent;border:1px solid #555b5e;border-radius:6px;padding:10px 16px;color:#f5f3ed;cursor:pointer;text-decoration:none;font:14px/1.4 var(--font-body),sans-serif}.gallery-viewer button:hover,.gallery-viewer a:hover{background:#292e30;border-color:#a1aaae}.gallery-viewer :focus-visible{outline:2px solid #65d7d5;outline-offset:4px}.gallery-viewer button:disabled{opacity:.35;cursor:default}.viewer-toolbar button{flex-shrink:0}.viewer-toolbar button span{font-size:23px;margin-left:16px}.viewer-stage{overflow:auto;display:flex;align-items:center;justify-content:center;min-height:0;background:#eae9e5;border-radius:6px}.viewer-stage :global(img){display:block;max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain}.viewer-stage.is-zoomed{display:block;cursor:zoom-out}.viewer-stage.is-zoomed :global(img){max-width:none;max-height:none;width:var(--zoom-width);height:auto;margin:auto}.viewer-controls{display:flex;justify-content:space-between;align-items:center;gap:16px}.viewer-controls>div{display:flex;gap:10px}.viewer-status{margin:0;color:#c5c9ca;font-size:13px;min-height:0}.viewer-status:empty{display:none}@media(max-width:600px){.gallery-viewer{padding:16px;gap:12px}.viewer-toolbar{align-items:start;gap:12px}.viewer-toolbar h2{font-size:17px}.viewer-toolbar button{padding:8px 12px}.viewer-toolbar button span{margin-left:6px}.viewer-controls{gap:10px;flex-wrap:wrap}.viewer-controls>div{flex:1}.viewer-controls>div button{min-width:45px}.viewer-controls>div span{display:inline}.viewer-controls a{font-size:12px;padding:10px 12px}.viewer-controls button{font-size:12px;padding:10px 12px}}
</style>
