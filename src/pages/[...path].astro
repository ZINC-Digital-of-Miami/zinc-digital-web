---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeBands from '../components/home/HomeBands.astro';
import Page from '../components/Page.astro';
import { routes, type Route } from '../data/site';
export function getStaticPaths() {
  return routes.map((route) => ({ params: { path: route.path === '/' ? undefined : route.path.replace(/^\/|\/$/g, '') }, props: { route } }));
}
interface Props { route: Route }
const { route } = Astro.props;
---
<SiteLayout route={route}>
  {route.template === 'home' ? <HomeBands /> : <Page route={route} />}
</SiteLayout>
