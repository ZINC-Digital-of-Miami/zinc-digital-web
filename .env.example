# Copy to .env (local) or set in Vercel → Project → Environment Variables. Never commit real values.

# --- Public site -------------------------------------------------------------
# 'demo' (default) keeps the designed non-sending contact form. 'live' posts to /api/inquiries.
PUBLIC_INQUIRY_MODE=demo
PUBLIC_SUPABASE_URL=            # https://zeetlqskfvsfbllrhzre.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY= # publishable key (RLS applies); the older PUBLIC_SUPABASE_ANON_KEY is still read as a fallback
# Optional staff notification for new inquiries (Resend, from hello@zincdigital.co — domain must be verified in Resend).
# Resend is a paid service beyond its free tier. The route refuses to send unless EMAIL_PROVIDER_APPROVED=true (owner decision).
EMAIL_PROVIDER_APPROVED=false
RESEND_API_KEY=
INQUIRY_NOTIFY_TO=hello@zincdigital.co

# --- Admin / staff API (server only) -----------------------------------------
SUPABASE_SECRET_KEY=            # secret key; server and build only, never PUBLIC_ (older name SUPABASE_SERVICE_ROLE still read)
SUPABASE_DB_URL=                # local .env only: Session pooler URI for pg_dump and scripts/db-test.mjs
# OpenAI embeddings and Anthropic messages are metered APIs; API keys are not subscription use.
# Research routes return 503 until the owner approves the spend: RESEARCH_PROVIDERS_APPROVED=true
RESEARCH_PROVIDERS_APPROVED=false
OPENAI_API_KEY=                 # text-embedding-3-small for research retrieval
ANTHROPIC_API_KEY=              # 'claude' model + fallback when the Codex bridge is offline
CODEX_BRIDGE_URL=               # tiny HTTP server on the Codex CLI machine (POST /complete, SSE)
CODEX_BRIDGE_TOKEN=
