---
import Img from './Img.astro';
import { casePresentations } from '../data/case-presentations';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const presentation = casePresentations[slug];
const headingId = `case-presentation-${slug}`;
---

{presentation && <section class="cp-section" aria-labelledby={headingId}>
  <div class="wrap">
    <header class="cp-heading rv">
      <div><span class="kick">The work in context</span><h2 class="disp cp-title" id={headingId}>{presentation.title}</h2></div>
      <p class="cp-intro">{presentation.intro}</p>
    </header>
    <div class:list={['cp-grid', { 'cp-pair': presentation.frames.length === 2 }]}>
      {presentation.frames.map((frame, index) => <figure style={`--case-delay:${index * 90}ms`} class:list={['cp-card rv', `cp-${frame.kind}`]}>
        <div class="cp-topline"><span class="cp-surface">{frame.surface}</span><span class="cp-label">{frame.label}</span></div>
        <div class="cp-stage">
          <div class="cp-screen">
            {['feed', 'vertical', 'shopping'].includes(frame.kind) && <div class="cp-client"><strong>{presentation.client}</strong><span>Creative presentation</span></div>}
            <div class="cp-media"><Img k={frame.asset} alt={frame.alt} sizes={frame.kind === 'app' ? '(max-width: 600px) 74vw, 300px' : '(max-width: 700px) 90vw, (max-width: 1100px) 45vw, 640px'} /></div>
          </div>
        </div>
        <figcaption class="cp-caption"><h3>{frame.title}</h3><p>{frame.caption}</p>
        </figcaption>
      </figure>)}
    </div>
  </div>
</section>}

<style>
  .cp-section{padding:clamp(64px,9vw,120px) 0;border-top:1px solid var(--line);color:var(--ink)}
  .cp-heading{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:32px;align-items:end;margin-bottom:36px}
  .cp-title{font-size:clamp(42px,5.5vw,82px);max-width:15ch;margin-top:18px;overflow-wrap:break-word}
  .cp-intro{font-family:var(--fb);font-size:18px;line-height:1.65;color:var(--muted);margin:0;max-width:48ch}
  .cp-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;align-items:start}
  .cp-grid.cp-pair{grid-template-columns:repeat(2,minmax(0,1fr))}
  .cp-card{margin:0;min-width:0;border:1px solid var(--line);border-radius:24px;background:var(--bg2)}
  .cp-topline{display:flex;align-items:start;justify-content:space-between;gap:12px;padding:18px 20px;border-bottom:1px solid var(--line);font-family:var(--fm);font-size:12px;line-height:1.5;overflow-wrap:anywhere}
  .cp-surface{font-weight:600;color:var(--ink)}
  .cp-label{color:var(--muted);text-align:right;max-width:17ch}
  .cp-stage{display:flex;align-items:center;justify-content:center;min-height:320px;padding:24px;background:var(--bg)}
  .cp-screen{min-width:0;width:100%;border:1px solid var(--line);border-radius:16px;background:var(--bg);box-shadow:0 12px 28px rgba(0,0,0,.06)}
  .cp-client{padding:16px;display:grid;gap:5px;font-family:var(--fb);overflow-wrap:anywhere}
  .cp-client strong{font-size:14px;line-height:1.4}
  .cp-client span{font-family:var(--fm);font-size:10px;line-height:1.5;color:var(--muted)}
  .cp-media{line-height:0;padding:0 12px 12px}
  .cp-media :global(picture){display:block}
  .cp-media :global(img){display:block;width:100%;height:auto;max-height:470px;object-fit:contain;border-radius:10px;filter:none}
  .cp-vertical .cp-screen{max-width:290px;background:#101113;color:#F5F6F7;border-color:#292B30;border-radius:28px}
  .cp-vertical .cp-client span{color:#B8B9BD}
  .cp-vertical .cp-media{min-height:350px;display:flex;align-items:center;justify-content:center;padding:0 12px 20px}
  .cp-shopping .cp-screen{border-top:3px solid var(--tealt)}
  .cp-sheet .cp-media{padding:12px}
  .cp-sheet .cp-stage{min-height:0}
  .cp-sheet .cp-media :global(img){height:auto;max-height:none;object-fit:contain;object-position:center}
  .cp-catalog .cp-screen,.cp-identity .cp-screen,.cp-app .cp-screen{border:0;background:transparent;box-shadow:none}
  .cp-catalog .cp-media,.cp-identity .cp-media,.cp-app .cp-media{padding:0}
  .cp-identity .cp-stage{background:#F5F6F7}
  .cp-app .cp-stage{min-height:0;padding:26px 24px}
  .cp-app .cp-screen{max-width:300px}
  .cp-app .cp-media :global(img){max-height:none;border-radius:0}
  .cp-caption{padding:24px 20px 26px;border-top:1px solid var(--line);overflow-wrap:anywhere}
  .cp-caption h3{font-family:var(--fd);font-size:clamp(27px,2.5vw,34px);font-weight:800;line-height:1.05;text-transform:uppercase;margin:0}
  .cp-caption p{font-family:var(--fb);font-size:15px;line-height:1.65;color:var(--muted);margin:12px 0 0}
  :global(html[data-theme="dark"]) .cp-screen{box-shadow:none}
  @media(max-width:1100px){.cp-topline{padding:16px;flex-direction:column;gap:4px}.cp-label{text-align:left;max-width:none}.cp-stage{padding:18px}.cp-caption{padding:22px 18px}.cp-client{padding:12px}}
  @media(max-width:700px){.cp-heading{grid-template-columns:1fr;gap:20px}.cp-intro{font-size:17px}.cp-grid,.cp-grid.cp-pair{grid-template-columns:1fr;gap:24px}.cp-topline{flex-direction:row;gap:16px}.cp-label{text-align:right;max-width:17ch}.cp-stage{padding:24px 18px}.cp-app .cp-screen{max-width:300px}.cp-title{max-width:16ch}}
</style>
