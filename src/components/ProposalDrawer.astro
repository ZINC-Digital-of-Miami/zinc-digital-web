---
import ContactForm from './ContactForm.astro';
import {services} from '../data/site';
import {proposalPillar} from '../lib/proposal-pillar';
interface Props { primaryService: string; sourcePath: string }
const {primaryService,sourcePath}=Astro.props;
const slug=proposalPillar(primaryService);
const service=services.find(s=>s.slug===slug);
const label=service?.title || 'Your next project';
const copy: Record<string,string>={
 'seo':'Turn search priorities into a scoped plan.',
 'ai-search-optimization':'Plan how your business is found in AI search.',
 'local-seo':'Put your local market at the centre of the brief.',
 'shopify':'Scope the next step for your Shopify store.',
 'web-design':'Start with what your website needs to do.',
 'apps':'Define the workflow your application should improve.',
 'google-search-ads':'Build a brief around your search campaign goals.',
 'shopping-ads':'Connect your catalog, campaigns and commercial goals.',
 'social-ads':'Give your next paid social campaign a clear brief.',
 'tiktok-ads':'Set the direction for your TikTok campaigns.',
 'business-intelligence':'Start with the decisions your reporting needs to support.',
};
const href='/contact/'+(slug?'?service='+slug:'');
---
<aside class="proposal-bar" aria-label={'Request a '+label+' proposal'} data-proposal-bar data-service-slug={slug}>
  <div class="proposal-bar-copy"><span class="proposal-eyebrow">From insight to a brief</span><strong>{label}</strong><span class="proposal-description">{slug?copy[slug]:'Tell us what you want to achieve.'}</span></div>
  <a class="proposal-open" href={href} data-proposal-open data-service-slug={slug}>Request a proposal <span aria-hidden="true">↗</span></a>
</aside>
<dialog class="proposal-drawer" data-proposal-drawer data-service-slug={slug} aria-labelledby="proposal-title" aria-describedby="proposal-description">
  <div class="proposal-drawer-head"><span class="proposal-eyebrow">ZINC / Request for proposal</span><button type="button" data-proposal-close class="proposal-close" aria-label="Close proposal drawer">Close <span aria-hidden="true">×</span></button></div>
  <div class="proposal-drawer-body">
    <p class="proposal-service">{label}</p>
    <h2 id="proposal-title">A clear brief.<br/>A useful next step.</h2>
    <p id="proposal-description">{slug?copy[slug]:'Tell us what you want to achieve.'} Tell us about your business, scope and timing.</p>
    <ContactForm compact serviceSlug={slug} sourcePath={sourcePath} values={{services:slug?[slug]:[]}} />
  </div>
</dialog>
<script>
 import {initProposalDrawer} from '../scripts/proposal-drawer';
 initProposalDrawer();
</script>
<style>
 :global(body:has([data-proposal-bar])){padding-bottom:128px}
 :global(html:has([data-proposal-bar])){scroll-padding-bottom:140px}
 .proposal-bar{position:fixed;z-index:80;bottom:max(18px,env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);width:min(1120px,calc(100% - 48px));display:flex;align-items:center;justify-content:space-between;gap:28px;padding:20px 24px;border-left:3px solid var(--mag);background:var(--color-near-black);color:var(--color-snow);box-shadow:0 8px 32px rgb(0 0 0 / .18)}
 .proposal-bar-copy{display:grid;grid-template-columns:auto 1fr;gap:3px 24px;align-items:baseline;min-width:0}.proposal-eyebrow{font-family:var(--fm);font-size:11px;text-transform:uppercase;letter-spacing:.08em}.proposal-bar .proposal-eyebrow{grid-column:1/-1;color:var(--color-gray-on-dark)}
 .proposal-bar strong{font-family:var(--fd);font-weight:800;font-size:23px;line-height:1.2;letter-spacing:-.02em}.proposal-description{color:var(--color-gray-on-dark);font-size:14px;line-height:1.4;max-width:35ch}
 .proposal-bar .proposal-open{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:48px;flex-shrink:0;padding:12px 18px;background:var(--color-snow);color:var(--color-near-black);font-family:var(--fm);font-size:12px;text-transform:uppercase;letter-spacing:.025em}.proposal-open span{font-size:23px;line-height:1}.proposal-bar .proposal-open:hover{background:var(--color-teal);color:var(--color-near-black)}
 .proposal-drawer{position:fixed;inset:0 0 0 auto;margin:0;width:min(640px,100%);height:100dvh;max-height:100dvh;max-width:100%;padding:0;border:0;border-left:1px solid var(--line);background:var(--bg);color:var(--ink);overflow:auto;overscroll-behavior:contain;font-family:var(--fb)}
 .proposal-drawer::backdrop{background:rgb(0 0 0 / .56)}.proposal-drawer[open]{animation:proposal-enter .24s ease-out}.proposal-drawer-head{display:flex;align-items:center;justify-content:space-between;gap:12px;position:sticky;top:0;z-index:1;background:var(--bg);border-bottom:1px solid var(--line);border-top:3px solid var(--mag);padding:14px 30px}.proposal-close{display:flex;align-items:center;gap:16px;min-width:80px;min-height:44px;padding:4px 0 4px 8px;border:0;background:none;color:var(--ink);font-family:var(--fm);font-size:12px;cursor:pointer}.proposal-close span{font-family:var(--fb);font-size:28px;font-weight:300}
 .proposal-drawer-body{padding:30px 36px max(40px,env(safe-area-inset-bottom));}.proposal-service{display:inline-block;margin:0 0 18px;padding:0 0 8px;border-bottom:2px solid var(--tealt);font-family:var(--fm);font-size:12px;text-transform:uppercase;letter-spacing:.04em}.proposal-drawer h2{font-family:var(--fd);font-size:clamp(34px,4vw,46px);font-weight:800;letter-spacing:-.035em;line-height:1.05;margin:0}.proposal-drawer #proposal-description{font-size:15px;line-height:1.65;color:var(--muted);margin:18px 0 30px;max-width:50ch}
 .proposal-drawer :global(.p-form legend){font-size:26px;line-height:1.2}.proposal-drawer :global(.p-fields){grid-template-columns:1fr 1fr;gap:18px}.proposal-drawer :global(.p-form input),.proposal-drawer :global(.p-form select),.proposal-drawer :global(.p-form textarea){font-size:16px;min-width:0;max-width:100%}.proposal-drawer :global(.p-form .p-check input){min-height:0}.proposal-drawer :global(.p-steps){margin-bottom:16px}.proposal-drawer :global(.p-form .p-muted){font-size:13px;line-height:1.6}.proposal-drawer :global(.p-ctrls){padding-bottom:8px}.proposal-drawer :global(.p-form .btn){border-radius:0}
 :is(.proposal-close,.proposal-open):focus-visible{outline:3px solid var(--tealt);outline-offset:4px}
 @keyframes proposal-enter{from{transform:translateX(30px);opacity:.5}to{transform:translateX(0);opacity:1}}
 @media(max-width:900px){.proposal-description{display:none}.proposal-bar-copy{display:block}.proposal-bar .proposal-eyebrow{display:block;margin-bottom:5px}}
 @media(max-width:600px){.proposal-bar{width:calc(100% - 24px);bottom:max(12px,env(safe-area-inset-bottom));padding:14px;gap:14px}.proposal-bar strong{font-size:18px;display:block}.proposal-bar .proposal-eyebrow{display:none}.proposal-bar .proposal-open{font-size:12px;gap:10px;padding:10px;max-width:48%}.proposal-open span{font-size:20px}.proposal-drawer-head{padding:10px 20px}.proposal-drawer-body{padding:26px 22px max(32px,env(safe-area-inset-bottom))}.proposal-drawer :global(.p-fields){grid-template-columns:1fr}.proposal-drawer h2{font-size:38px}}
 @media(prefers-reduced-motion:reduce){.proposal-drawer[open]{animation:none}}
</style>
