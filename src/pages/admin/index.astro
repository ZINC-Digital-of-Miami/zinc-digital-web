---
export const prerender=false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import {requireStaff} from '../../lib/auth';
import {inquiries,contentList,score,type InquiryRow,type ContentItem} from '../../lib/admin-data';
import {googleConfig} from '../../lib/google';
import {deployments,type Deployment} from '../../lib/vercel';
const staff=requireStaff(Astro);if(staff instanceof Response)return staff;
let leads:InquiryRow[]=[],items:ContentItem[]=[],error='',deploys:Deployment[]=[];
try{[leads,items]=await Promise.all([inquiries(Astro),contentList(Astro)]);}catch(e){error=(e as Error).message;}
try{deploys=await deployments();}catch{}
const failed=leads.filter(r=>r.notify_status==='failed'),issues=items.filter(r=>score(r).issues.length);
const average=items.length?Math.round(items.reduce((n,x)=>n+score(x).score,0)/items.length):null;
const connected=!!googleConfig().account;
---
<AdminLayout view="dashboard" title="Dashboard">
{error&&<p class="a-error" role="alert">{error}</p>}
<div data-google-metrics><section class="a-kpis"><div class="a-kpi"><span class="a-label a-muted">Organic clicks · 30 days</span><div class="a-number" data-metric="clicks">{connected?'Loading…':'Unavailable'}</div><span class="a-count">Search Console</span></div><div class="a-kpi"><span class="a-label a-muted">Indexed pages</span><div class="a-number" data-metric="indexed">{connected?'Loading…':'Unavailable'}</div><span class="a-count">Sitemap URLs</span></div><div class="a-kpi"><span class="a-label a-muted">New inquiries</span><div class="a-number">{error?'—':leads.filter(r=>r.stage==='new'&&!r.archived_at).length}</div><span class="a-count">Database</span></div><div class="a-kpi"><span class="a-label a-muted">Average SEO score</span><div class="a-number">{average??'—'}</div><span class="a-count">Field score · pages and posts</span></div></section>
<p class="a-notice" data-google-error role="status" hidden={connected}>{connected?'':'Connect Google for Analytics and Search Console metrics.'}</p>
<section class="a-grid a-section"><div class="a-panel"><span class="a-label">Organic sessions · 30 days</span><div class="a-chart" data-series>{connected?'Loading…':'Connect Google Analytics to see the chart.'}</div><p class="a-count" data-metric="period"></p></div><div class="a-panel"><span class="a-label">Needs attention</span><ul class="a-list">{failed.length>0&&<li><a class="a-link" href="/admin/inquiries/">{failed.length} failed inquiry notifications</a></li>}{issues.length>0&&<li><a class="a-link" href="/admin/seo/">{issues.length} pages or posts with SEO field issues</a></li>}{deploys[0]?.state==='ERROR'&&<li><a class="a-link" href="/admin/backend/">The latest deployment failed</a></li>}{!failed.length&&!issues.length&&deploys[0]?.state!=='ERROR'&&<li class="a-muted">No issues found in the connected sources.</li>}</ul></div></section>
<section class="a-panel a-section"><span class="a-label">Top pages</span><ul class="a-list" data-top-pages><li>{connected?'Loading…':'Connect Google Analytics to see page views.'}</li></ul><p class="a-count">Data updated <span data-metric="updated">—</span></p></section></div>
<script>import '../../scripts/admin/metrics';</script>
</AdminLayout>
