---
import {Font} from 'astro:assets';
import {adminThemeScript} from '../lib/admin-theme';
import '../styles/tokens.css';
import '../styles/themes.css';
import '../styles/admin.css';
import {asset} from '../data/site';
import {shellData} from '../lib/admin-data';
import {requireStaff} from '../lib/auth';
interface Props {view:string;title?:string}
const {view,title=view}=Astro.props;
const staff=requireStaff(Astro);if(staff instanceof Response)return staff;
const shell=await shellData(Astro);
const nav=[['dashboard','Dashboard',''],['research','Research',shell.counts.research],['inquiries','Inquiries',shell.counts.inquiries],['pages','Pages',shell.counts.pages],['posts','Posts',shell.counts.posts],['seo','SEO',''],['stats','Stats',''],['backend','Backend',''],['staff','Staff',shell.counts.staff]];
---
<html lang="en" data-theme="dark"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{title} | ZINC admin</title><link rel="icon" href="/favicon.png"/>
<Font cssVariable="--font-display" preload/><Font cssVariable="--font-body"/><Font cssVariable="--font-mono"/>
<script is:inline set:html={adminThemeScript}/>
</head><body><a class="a-skip" href="#admin-main">Skip to content</a><div class="za">
<aside class="a-side"><a class="a-logo" href="/admin/"><img src={asset('wordmark-black').src} alt="ZINC" width="110" height="22"/><span class="a-label a-muted">Admin</span></a><button class="a-button a-nav-toggle" type="button" data-admin-menu-toggle aria-expanded="true" aria-controls="admin-navigation">Menu · {title}</button><nav id="admin-navigation" aria-label="Admin">{nav.map(([key,label,count])=><a class="a-nav" href={key==='dashboard'?'/admin/':'/admin/'+key+'/'} aria-current={view===key?'page':undefined}><span>{label}</span><span class="a-count">{count??'—'}</span></a>)}</nav>
<div class="a-side-bottom"><span class="a-label a-muted"><i class:list={['a-dot',{error:!shell.connected}]}></i> {shell.connected?'Database connected':'Connection unavailable'}</span><button class="a-button" type="button" data-theme-toggle>Dark mode</button><a href="/">← View site</a><span class="a-count">{staff.email}</span><form method="post" action="/api/admin/signout/"><button class="a-button" type="submit">Sign out</button></form></div></aside>
<main class="a-main" id="admin-main"><header class="a-header"><div><div class="a-label a-muted">ZINC / Admin / {view}</div><h1 class="a-title">{title}</h1></div><div class="a-actions"><span class="a-chip"><i class:list={['a-dot',{error:!shell.connected}]}></i>{shell.connected?'Database available':'Database unavailable'}</span><slot name="action"/></div></header><div data-admin-region><slot/></div></main>
</div><div class="a-toast" data-toast hidden role="status"><span data-toast-text></span><button data-toast-undo type="button" hidden>Undo</button><button data-toast-dismiss type="button" aria-label="Dismiss notification">×</button></div>
<dialog class="a-drawer" data-confirm-dialog aria-labelledby="confirm-title" aria-describedby="confirm-message"><div class="a-drawer-head"><h2 class="a-heading" id="confirm-title">Confirm action</h2></div><p id="confirm-message" data-confirm-message></p><form method="dialog" class="a-actions"><button class="a-button" value="cancel" autofocus>Keep editing</button><button class="a-button primary" value="continue">Continue</button></form></dialog>
<script>import '../scripts/admin/shell';</script></body></html>
