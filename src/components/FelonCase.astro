---
import type {ImageMetadata} from 'astro';
import PageRail from './PageRail.astro';
import ApprovedImage from './ApprovedImage.astro';
import FelonGallery from './FelonGallery.astro';
import apparel from '../data/felon-apparel.json';
import brand from '../data/felon-brand.json';
const files=import.meta.glob<{default:ImageMetadata}>('../assets/felon-*/*.{jpg,png}',{eager:true});
const apparelItems=(group:string)=>apparel.filter(x=>x.group===group).map(x=>({image:files['../assets/felon-apparel/'+x.file].default,label:x.label}));
const brandItems=(group:string)=>brand.filter(x=>x.group===group).map(x=>({image:files['../assets/felon-brand/'+x.file].default,label:x.label}));
const sections=[{id:'brand-creative',title:'Brand & campaign creative',line:'The Felon identity in campaign artwork.'},{id:'merchandise',title:'Merchandise',line:'The spade emblem on mugs and stickers.'},{id:'shop-signage',title:'Shop & signage',line:'Brand details, signage and views of the retail space.'}];
---
<article class="felon-case">
  <header class="zn-page-hero felon-hero"><div class="wrap felon-hero-grid"><div><p class="kick">ZINC / Selected work</p><h1 class="disp">Felon<br/>Motorwerk<span>.</span></h1><p class="felon-lede">Web design, apparel<br/>and brand applications.</p><a class="arrow" href="#apparel">Explore the apparel ↓</a></div><div class="felon-hero-art"><ApprovedImage name="felon.png" alt="Felon Motorwerk motorcycle brand creative" loading="eager" sizes="(max-width: 800px) 92vw, 52vw" /></div></div></header>
  <PageRail path="/work/felon-motorwerk/" title="Felon Motorwerk" />
  <nav class="felon-jumps wrap" aria-label="Felon case study sections"><a href="#website">Website</a><a href="#apparel">Apparel</a>{sections.map(s=><a href={'#'+s.id}>{s.title}</a>)}</nav>
  <section id="website" class="felon-section" data-case-pages="felon-motorwerk"><div class="wrap felon-website"><div><p class="kick">Digital / Website</p><h2 class="disp">On screen.</h2><p>The Felon Motorwerk website creative, presented across devices.</p></div><figure data-case-mockup="felon-motorwerk"><ApprovedImage name="felon-white-devices.png" alt="Felon Motorwerk website creative on desktop, laptop and phone" sizes="(max-width: 800px) 90vw, 55vw" /></figure></div></section>
  <section id="apparel" class="felon-section"><div class="wrap"><div class="felon-section-head"><p class="kick">Felon Gear / Apparel design</p><h2 class="disp">Apparel<span>.</span></h2><p>Graphic tees, long sleeves, hats and women’s styles designed by ZINC for Felon.</p></div>{['T-shirts & long sleeves','Headwear','Women’s'].map(group=><div class="felon-group"><h3>{group}</h3><FelonGallery items={apparelItems(group)} apparel /></div>)}</div></section>
  {sections.map(section=><section id={section.id} class="felon-section"><div class="wrap"><div class="felon-section-head"><p class="kick">Felon / Brand applications</p><h2 class="disp">{section.title}<span>.</span></h2><p>{section.line}</p></div><FelonGallery items={brandItems(section.id)} wide /></div></section>)}
  <div class="wrap felon-back"><a class="arrow" href="/work/">Back to selected work ↗</a></div>
</article>
<style>
.felon-case{background:#f0f0ed;color:#111;--ink:#111;--muted:#595b5e;--line:#d5d6d7}.felon-hero{padding:75px 0}.felon-hero-grid{display:grid;grid-template-columns:44% 56%;align-items:center;gap:0}.felon-hero h1{font-size:clamp(68px,8.8vw,138px);line-height:.94;margin:28px 0}.felon-hero h1 span,.felon-section h2 span{color:#fa268c}.felon-lede{font-size:clamp(20px,2vw,28px);line-height:1.4;color:#c7c9cb;margin:24px 0}.felon-hero .arrow{color:#f5f6f7}.felon-hero-art{padding-left:20px}.felon-hero-art :global(img){width:100%;height:auto;display:block;mask-image:linear-gradient(to right,transparent,#000 8%)}.felon-jumps{display:flex;flex-wrap:wrap;gap:14px 30px;padding-block:24px;border-bottom:1px solid #c5c7c9}.felon-jumps a{font:12px/1.5 var(--fm);color:#111!important;padding:8px 0}.felon-section{padding:75px 0;border-bottom:1px solid #d5d6d7;scroll-margin-top:90px}.felon-section h2{font-size:clamp(48px,6vw,88px);line-height:1;margin:20px 0;color:#111}.felon-section p{font-size:17px;line-height:1.6;max-width:52ch}.felon-section .kick{font:11px/1.5 var(--fm);color:#626467}.felon-section-head{margin-bottom:42px}.felon-website{display:grid;grid-template-columns:minmax(0,35fr) minmax(0,65fr);align-items:center;gap:24px}.felon-website figure{margin:0;background:#fff;box-shadow:0 12px 30px #11111108}.felon-website :global(img){width:100%;height:auto;display:block}.felon-group+.felon-group{margin-top:48px}.felon-group h3{font:500 15px/1.5 var(--fm);padding-bottom:16px;margin:0 0 22px;border-bottom:1px solid #c5c7c9}.felon-back{padding-block:40px}.felon-back a{color:#111!important}.felon-case a:focus-visible{outline:3px solid #008d91;outline-offset:5px}@media(max-width:800px){.felon-hero-grid,.felon-website{grid-template-columns:1fr}.felon-hero{padding:40px 0}.felon-hero-art{padding:30px 0 0}.felon-hero-art :global(img){mask-image:none}.felon-section{padding:48px 0}.felon-website{gap:25px}.felon-hero h1{font-size:clamp(65px,13vw,104px)}}
</style>
