---
import BeforeAfter from './BeforeAfter.astro';
import DeviceComposition from './DeviceComposition.astro';
import ClientMaterialCase from './ClientMaterialCase.astro';
import PageRail from "./PageRail.astro";
import ServicesVisual from "./ServicesVisual.astro";
import WorkOverview from "./WorkOverview.astro";
import ApprovedImage from "./ApprovedImage.astro";
// Page.astro — every non-home template, ported from ZINC Site.dc.html.
import Img from './Img.astro';
import SummitBrand from './SummitBrand.astro';
import { articleTables } from '../lib/article-tables';
import { articleSources } from '../data/article-sources';
import WorkLane from './WorkLane.astro';
import CaseImage from './CaseImage.astro';
import CaseStudyHero from './CaseStudyHero.astro';
import CaseStudyFooter from './CaseStudyFooter.astro';
import BearClawScreens from './BearClawScreens.astro';
import CaseScreens from './CaseScreens.astro';
import { caseScreens } from '../data/case-screens';
import AuthorCard from './AuthorCard.astro';
import ArticleShare from './ArticleShare.astro';
import ArticleSources from './ArticleSources.astro';
import ArticleIllustration from './ArticleIllustration.astro';
import { articleIllustrations } from '../data/article-illustrations';
import { authors, authorFor, authorPath } from '../data/authors';
import FelonCase from './FelonCase.astro';
import MiamiTacticalCase from './MiamiTacticalCase.astro';
import WebsiteCase from './WebsiteCase.astro';
import LasVegasSafetyCase from './LasVegasSafetyCase.astro';
import {websiteCases, type WebsiteCaseSlug} from '../data/website-cases';
import CasePresentations from './CasePresentations.astro';
import CaseScene from './CaseScene.astro';
import { workLanes, laneNames } from '../data/work-lanes';
import { casePresentations } from '../data/case-presentations';
import ContactForm from './ContactForm.astro';
import { articleImages } from '../data/article-images';
import {categoryPosts} from '../data/blog-categories';
import { blogPillars, pillarFor, readingPath } from '../data/blog-strategy';
import type { Inquiry } from '../lib/inquiry';
import { services, cases, layers, layerMeta, contract, readout, team, sequence, privacy, terms, lede, asset, svcBy, caseBy, pad, link, dateLabel, excerpt, type Route, type Layer } from '../data/site';
interface Props { route: Route; form?: { values?: Partial<Inquiry>; error?: string } }
const { route, form } = Astro.props;
const {posts:allPosts}=await (await import('../lib/content')).loadPublished();
const posts=route.blogCategory?categoryPosts(route.blogCategory,allPosts):allPosts;
const categoryService=route.blogCategory?services.find(s=>s.slug===route.blogCategory):undefined;
const pillarCategories=services.filter(s=>allPosts.some(p=>p.related.includes(s.slug)));
const {renderArticleMarkdown}=await import('../lib/markdown');
const t = route.template;
const svc = t === 'service' ? svcBy(route.slug!) : null;
const serviceCase = svc?.caseSlug ? caseBy(svc.caseSlug) : null;
const serviceProofAssets: Record<string, string> = { apps: 'uos-current-technicians-desktop' };
const serviceProof = svc && serviceCase ? serviceProofAssets[svc.slug] || serviceCase.hero : null;
const serviceScene = svc ? ({'web-design':'build-uos', apps:'intelligence-uos', 'business-intelligence':'intelligence-fusion'} as Record<string,string>)[svc.slug] : undefined;
const serviceCaseHref = serviceCase ? '/work/' + serviceCase.slug + '/' + (svc?.slug === 'apps' ? '#operations-app' : svc?.slug === 'web-design' ? '#website' : svc?.layer === 'Demand' ? '#work-demand' : '') : '';
const laneScenes: Record<string,string> = {Build:'build-uos', Demand:'demand-summit', Intelligence:'intelligence-fusion'};
const study = t === 'case' ? caseBy(route.slug!) : null;
const profile = t === 'author' ? authors.find(a=>a.id===route.slug)! : null;
const authorPosts = profile ? posts.filter(p=>authorFor(p.author.name)?.id===profile.id) : [];
const post = t === 'article' ? posts.find((p) => p.slug === route.slug)! : null;
const postAuthor = post ? authorFor(post.author.name) : undefined;
const urlLabel = 'zincdigital.co' + route.path;
const eyebrow = 'ZINC / ' + (route.layer || ({ '404': '404', case: 'case' } as Record<string, string>)[t] || t);
const pageLede = categoryService ? 'Articles about '+categoryService.title+', organised around the questions that help you choose, set up and improve the work.' : svc ? svc.line : study ? study.line : t === 'privacy' || t === 'terms' || t === 'article' ? '' : lede[t] || '';
const meta = post ? dateLabel(post.dateGmt) + ' / ' + post.author.name + ' / ' + post.layer : t === 'work' ? cases.length + ' cases / Build · Demand · Intelligence / Miami · Panama City · Las Vegas' : t === 'services' ? services.length + ' services / 3 layers / one connected system' : '';
const titleCls = route.title.length > 34 ? 'long' : '';
const revealHeader = t !== 'blog' && t !== 'article' && t !== 'author';
const layerGrid = layers.map((layer, i) => ({ layer, on: svc ? svc.layer === layer : true, label: pad(i) + ' / ' + (svc && svc.layer === layer ? 'Current layer' : 'Connected layer'), services: services.filter((s) => s.layer === layer) }));
const dots = Array.from({ length: 144 }, (_, i) => ({ cls: (i * 7) % 13 === 0 ? 't' : '', delay: ((i % 12) * 0.12 + Math.floor(i / 12) * 0.08).toFixed(2) + 's' }));
// case section numbering counts only rendered sections
let sec: Record<string, string> = {};
if (study) { let n = 0; const nx = () => pad(n++); sec = { sit: nx(), app: nx() }; if (study.before) sec.ba = nx(); if (!study.nonprofit) sec.layers = nx(); sec.shots = nx(); if (study.brand.length) sec.brand = nx(); if (study.results.length) sec.results = nx(); if (study.quote) sec.quote = nx(); }
const isPhone = (k: string) => /phone|mobile/.test(k);
// These assets already contain their device hardware; do not frame them twice.
const isDevicePresentation = (k: string) => k.startsWith('uos-current-') || ['lvs-mobile', 'lvs-laptop', 'lvs-devices', 'smd-cover', 'smd-devices'].includes(k);
const imageLabels: Record<string, string> = {
  'smd-logo-concepts': 'Logo concepts — wave and mountain variations',
  'uos-archive-logo': 'U.S. Oil Solutions — The Cooking Oil Experts wordmark',
  'bear-claw-home-desktop': 'Home page · desktop',
  'bear-claw-home-tablet': 'Home page · tablet',
  'bear-claw-home-mobile': 'Home page · mobile',
  'bear-claw-product-desktop': 'Product page · desktop',
  'bear-claw-product-tablet': 'Product page · tablet',
  'bear-claw-product-mobile': 'Product page · mobile',
  'bear-claw-about-desktop': 'About page · desktop',
  'bear-claw-about-tablet': 'About page · tablet',
  'bear-claw-about-mobile': 'About page · mobile',
  'bear-claw-quote-desktop': 'Request a quote page · desktop',
  'bear-claw-quote-tablet': 'Request a quote page · tablet',
  'bear-claw-quote-mobile': 'Request a quote page · mobile',
  'bear-claw-website': 'Product website · form release and quote requests',
  'bear-claw-wordmark-orange': 'Wordmark · orange',
  'lampstand-home': 'The Lampstand · public ministry website · October 2026',
  'lampstand-mobile': 'The Lampstand · mobile website · October 2026',
  'straight-street-home': 'Straight Street · public ministry website · October 2026',
  'straight-street-mobile': 'Straight Street · mobile website · October 2026',
  'fusion-v16-dashboard': 'Forecasting platform · market dashboard · in development, October 2026 · private figures removed',
  'fusion-v16-strategy': 'Forecasting platform · procurement strategy and scenarios · in development, October 2026 · private figures removed',
  'fusion-v16-legislation': 'Forecasting platform · policy intelligence · in development, October 2026 · private figures removed',
  'fusion-v16-sentiment': 'Forecasting platform · fund positioning and market sentiment · in development, October 2026 · private figures removed',

  'uos-current-technicians-desktop': 'Supervisor dashboard · technician assignments and check-ins · identifying details removed',
  'uos-current-technicians-mobile': 'Mobile technician roster · identifying details removed',
  'uos-current-schedule-mobile': 'Restaurant scheduling · identifying details removed',
  'uos-current-groups-mobile': 'Restaurant groups · identifying details removed',
  'uos-current-fryers-desktop': 'Fryer records and service history · identifying details removed',
  'uos-current-fryers-mobile': 'Mobile fryer records and scheduling · identifying details removed',
  'uos-current-oncall-desktop': 'On-call visits and rescheduling · identifying details removed',
  'uos-current-oncall-mobile': 'Mobile on-call visits · identifying details removed',
  'uos-current-menu-mobile': 'Issues, users, reports and special tasks · identifying details removed',
  'uos-current-special-mobile': 'Special-task scheduling · identifying details removed',
  'uos-second-site-desktop': 'Second public website · desktop design in development, October 2026',
  'uos-second-site-mobile': 'Second public website · mobile design in development, October 2026',
  'uos-app-desktop': 'Operations application · desktop sign-in',
  'uos-app-phone': 'Operations application · mobile sign-in',
  'uos-opening-checklist': 'Shift opening · oil supply and equipment checks',
  'uos-fryer-tasks': 'Restaurant visit · assigned fryer-service tasks',
  'uos-service-choice': 'Fryer service · TPM reading and filtration or replacement',
  'uos-visit-progress': 'Visit progress · pending and completed fryer services',
  'uos-service-complete': 'Service completion · photo capture and checkout',
  'uos-special-tasks': 'Supervisor workflow · special tasks and visit completion',
  'uos-restaurant-mobile': 'Mobile workflow · restaurant settings and fryer details',
  'uos-visit-list': 'Technician shift · assigned locations and visit start',
  'lvs-hero': 'Rebuilt ecommerce store across devices',
  'lvs-before': 'Ecommerce site before the rebuild',
  'lvs-laptop': 'Rebuilt ecommerce store · laptop view',
  'lvs-mobile': 'Rebuilt ecommerce store · mobile view',
  'lvs-devices': 'Rebuilt ecommerce store across devices',
  'lvs-banner': 'Store launch promotional artwork',
  'lvs-storefront-first-aid': 'Ecommerce catalog · first-aid products, product search and quick reorder',
  'lvs-launch-flyer': 'New-store launch · product categories and ordering information',
  'lvs-launch-flyer-photo': 'Store launch artwork · photographic version',
  'lvs-food-service-net30-banner': 'Wholesale merchandising · food-service supplies',
  'lvs-food-service-product-hero': 'Food-service catalog artwork · containers, gloves and hair nets',
  'lvs-logo-black': 'Primary brand mark',
  'lvs-brand-1': 'Chemicals service-line identity',
  'lvs-brand-3': 'Training service-line identity',
  'lvs-product-1': 'Brand mark on a light background',
  'lvs-product-2': 'Brand mark on a dark background',
  'lvs-product-3': 'Wordmark application',
  'smd-hero': 'Website presentation',
  'smd-cover': 'Website · laptop view',
  'smd-devices': 'Website across devices',
  'smd-home-1': 'Eight-month performance comparison · landscape',
  'smd-home-2': 'Eight-month performance comparison · portrait',
  'smd-brand-book': 'Marine-construction brand book · identity, palette and typography',
  'smd-dock-ad-previews': 'Dock-construction campaign · ad-placement previews',
  'smd-seawall-ad-previews': 'Seawall campaign · ad-placement previews',
};
const cap = (k: string) => imageLabels[k] || 'Project view';
const presentedAssets = new Set(study ? [...(casePresentations[study.slug]?.frames.map(frame => frame.asset) || []), ...(caseScreens[study.slug]?.pages.flatMap(page => Object.values(page.images)) || [])] : []);
const archiveGallery = study?.slug === 'us-oil-solutions' || Boolean(study?.nonprofit);
const GalleryContainer = archiveGallery ? 'details' : 'div';
const websiteImages = study?.slug === 'us-oil-solutions' ? study.images.filter(k => k.startsWith('uos-second-site-')) : [];
const galleryImages = study?.images.filter(k => !presentedAssets.has(k) && !websiteImages.includes(k) && !(study.slug === 'summit-marine-development' && k === 'smd-brand-book')) || [];
const brandImages = study?.brand.filter(k => !presentedAssets.has(k)) || [];
const markdownArticle = post?.markdown !== undefined ? renderArticleMarkdown(post.markdown) : undefined;
const articleSections = (markdownArticle?.sections || post?.blocks.flatMap((block, i) => block.type === 'heading' ? [{ id: 'section-' + i, label: (block.runs || []).map((run) => run.text).join('') }] : []) || []).map(section => ({...section,label:section.label.replace(/^(?:Step )?\d+[.:]\s+/, '')}));
const articleImage = post ? articleImages[post.slug] : undefined;
const supportingIllustration = post ? articleIllustrations[post.slug] : undefined;
const markdownHeadings = markdownArticle ? [...markdownArticle.html.matchAll(/<h[2-6] id=/g)] : [];
const illustrationOffset = markdownHeadings[Math.floor(markdownHeadings.length / 2)]?.index ?? markdownArticle?.html.length ?? 0;
const markdownParts = markdownArticle ? [markdownArticle.html.slice(0, illustrationOffset), markdownArticle.html.slice(illustrationOffset)] : [];
const blockHeadings = post?.blocks.flatMap((block, i) => block.type === 'heading' ? [i] : []) || [];
const illustrationBlock = blockHeadings[Math.floor(blockHeadings.length / 2)] ?? Math.floor((post?.blocks.length || 0) / 2);
const articlePillar = post ? pillarFor(post.slug) : undefined;
const publishedPillar = articlePillar && posts.find(p => p.slug === articlePillar.slug);
const nextArticles = post ? readingPath(post.slug, posts) : [];
const restoredTables = articleTables(post?.slug || '',post?.blocks || []);
const sourceListBlocks = post?.blocks.flatMap((block,i)=>block.type==='heading' && block.runs?.map(r=>r.text).join('')==='Trusted Source Links' && post.blocks[i+1]?.type==='ul' ? [post.blocks[i+1]] : []) || [];
const repeatedTakeaway = new Set(post?.blocks.flatMap((block,i) => block.type === 'p' && block.runs?.map(r=>r.text).join('') === 'The Operator Takeaway' && post.blocks[i-1]?.type === 'heading' && post.blocks[i-1]?.runs?.map(r=>r.text).join('') === 'The Operator Takeaway' ? [i] : []) || []);
const listedSourceUrls = articleSources({blocks:sourceListBlocks}).map(s=>s.url);
const feat = posts[0];
const categoryGuides = blogPillars.filter(pillar=>posts.some(p=>p.slug===pillar.slug));
const topics = services.filter((s) => posts.some((p) => p.related.includes(s.slug)));
const legal = t === 'terms' ? terms : t === 'privacy' ? privacy : [];
import { canonicalContentLink } from '../data/redirects';
type Run = { text: string; href?: string };
const runsOf = (b: { runs?: Run[] }) => b.runs || [];
---
{t !== 'case' && t !== 'work' && (
  <section class:list={["p-intro", "zn-page-hero", { "zn-long-title": route.title.length > 35, "p-intro-contact": t === "contact", "p-intro-article": t === "article" }]} >
    <div class="sph" data-par="0.07" style="width:560px;height:560px;right:-150px;top:-60px;animation:float1 11s ease-in-out infinite"></div>
    <div class:list={["wrap", {"zn-service-hero":t === "services"}]}>
      <div class="meta lab" style="padding-top:0"><span>{eyebrow}</span></div>
      <hr class="rule" />
      <h1 class:list={['disp p-title', titleCls, {'zn-insights-title':t === 'blog'}, { rv: revealHeader }]}>{t === "blog" && !categoryService ? <>&lt;insights<span>.py</span>/&gt;</> : route.title}</h1>
      {pageLede && <p class:list={['p-lede', { rv: revealHeader }]}>{pageLede}</p>}
      {meta && <p class:list={['lab', { rv: revealHeader }]} style="margin:28px 0 0">{post ? <>{dateLabel(post.dateGmt)} / {postAuthor ? <a href={authorPath(postAuthor.id)} rel="author">{post.author.name}</a> : post.author.name} / {post.layer}</> : meta}</p>}
      {svc && <a class="zn-hero-action" href={'/contact/?service='+svc.slug}>Discuss this service </a>}
      {t === 'services' && <><a class="zn-hero-action" href="#service-directory">Find your service </a><div class="zn-service-art"><ServicesVisual /></div></>}
      {post && <nav class="p-article-categories lab" aria-label="Blog categories">Categories: {services.filter(s=>post.related.includes(s.slug)).map(s=><a href={"/blog/category/"+s.slug+"/"}>{s.title}</a>)}</nav>}
      {categoryService && <p><a class="arrow" href={"/services/"+categoryService.slug+"/"}>Explore our {categoryService.title} service</a></p>}
      {articleImage && <figure class="p-article-hero"><Img k={articleImage.asset} alt={articleImage.alt} sizes="(max-width: 900px) 90vw, 1100px" widths={[480,720,960,1280]} decoding="sync" loading="eager" fetchpriority="high" /></figure>}
    </div>
  </section>
  <PageRail path={route.path} title={t === "blog" && !categoryService ? "Insights" : route.title} />
)}

{svc && (<>
  <section class="p-band"><div class="wrap"><span class="kick rv">Service specification</span><h2 class="disp p-sec rv">What the work includes.</h2>
    <dl class="p-spec rv rv-stag"><div><dt class="lab">Deliverables</dt><dd><ul>{svc.deliverables.map((d, i) => <li><i>{pad(i)}</i><span>{d}</span></li>)}</ul></dd></div><div><dt class="lab">Cadence</dt><dd>{svc.cadence}</dd></div><div><dt class="lab">Client owns</dt><dd>{svc.owns}</dd></div><div><dt class="lab">Reported</dt><dd>{svc.reported}</dd></div></dl>
  </div></section>
  <section class="s-open studio-service-opening"><div class="wrap s-open-in">
    <div class="rv"><span class="kick">{layerMeta[svc.layer].kick}</span><h2 class="disp p-sec">{layerMeta[svc.layer].line}</h2><p class="p-body p-muted" style="margin-top:22px">{layerMeta[svc.layer].body}</p></div>
    <div class="s-vis s-vis-proof rv"><div class="s-motif" aria-hidden="true">
      {svc.layer === 'Build' && <div class="s-wire"><i style="grid-area:1/1/2/7"></i><i style="grid-area:2/1/5/5"></i><i style="grid-area:2/5/4/7"></i><i style="grid-area:4/5/5/7"></i><i style="grid-area:5/1/7/3"></i><i style="grid-area:5/3/7/5"></i><i style="grid-area:5/5/7/7;background:var(--teal);border-color:var(--teal)"></i></div>}
      {svc.layer === 'Demand' && <div class="s-curve"><svg viewBox="0 0 400 400" aria-hidden="true"><line x1="20" y1="360" x2="380" y2="360" stroke="var(--line)" stroke-width="1.5"></line><line x1="20" y1="40" x2="20" y2="360" stroke="var(--line)" stroke-width="1.5"></line><path class="fillp" d="M20 356 C120 350 180 300 230 200 S330 60 380 40 L380 360 L20 360 Z"></path><path class="ln" pathLength="1" d="M20 356 C120 350 180 300 230 200 S330 60 380 40"></path><circle class="pt" cx="380" cy="40" r="7" fill="#FC0781"></circle></svg><div class="s-ax lab"><span>Low intent</span><span>Ready to buy</span></div></div>}
      {svc.layer === 'Intelligence' && <div class="s-dots" aria-hidden="true">{dots.map((d) => <i class={d.cls} style={'animation-delay:' + d.delay}></i>)}</div>}
    </div>{serviceProof && serviceCase && <figure class="s-service-proof"><a href={serviceCaseHref} aria-label={'Explore ' + serviceCase.title}><>{serviceScene ? <CaseScene name={serviceScene} alt={serviceCase.title + (svc.slug === 'apps' ? ' operations application mockup; identifying details removed' : svc.layer === 'Intelligence' ? ' BI application in development; private figures removed' : ' project presentation')} /> : <Img k={serviceProof} alt={serviceCase.title + ' — ' + cap(serviceProof)} sizes="(max-width: 900px) 90vw, 480px" />}</></a><figcaption><span class="lab">Related engagement / {serviceCase.title}</span><p>{serviceScene ? svc.slug === 'web-design' ? 'Public website / Second build in development' : svc.slug === 'apps' ? 'Standalone operations app / Technician and supervisor workflows' : svc.layer === 'Intelligence' ? 'BI application / In development · Private figures removed' : 'Storefront and campaign work' : cap(serviceProof)}</p><a class="arrow" href={serviceCaseHref}>Explore the work </a></figcaption></figure>}</div>
  </div></section>
  <section class="p-band thin"><div class="wrap"><span class="kick rv">{layerMeta[svc.layer].second}</span><h2 class="disp p-sec rv">{layerMeta[svc.layer].secondTitle}</h2>
    {svc.layer === 'Build' && <ol class="s-blocks rv-stag">{sequence.map(([name, body], i) => <li><span class="lab">{pad(i)} / {name}</span><p>{body}</p></li>)}</ol>}
    {svc.layer === 'Demand' && <div class="s-blocks rv-stag">{contract.map(([k, v]) => <div><span class="lab">{k}</span><p>{v}</p></div>)}</div>}
    {svc.layer === 'Intelligence' && <dl class="s-readout rv">{readout.map(([k, v]) => <div><dt><span class="mdot"></span>{k}</dt><dd>{v}</dd></div>)}</dl>}
  </div></section>


  <section class="p-band thin"><div class="wrap p-split"><div class="rv"><span class="kick">Before the work begins</span><h2 class="disp p-sec">Useful questions.</h2></div><div class="p-faq rv">{svc.questions.map(([qq, a]) => <details><summary>{qq}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></div></section>
  <section class="p-band thin"><div class="wrap"><span class="kick rv">Connect the next part</span><h2 class="disp p-sec rv">Start with {svc.title.toLowerCase()}.</h2><div class="p-related rv"><a class="btn fill" href={link('/contact/', { service: svc.slug })}>Start an Inquiry</a><span class="brk"></span>{svc.related.map((s) => <a href={'/services/' + s + '/'}>{svcBy(s).title} </a>)}</div></div></section>
</>)}

{(t === 'services') && (
  <section class="p-band studio-lanes" id="service-directory"><div class="wrap"><span class="kick rv">The connected system</span><h2 class="disp p-sec rv">Build. Demand. Intelligence.</h2>
    <div class="p-layers rv rv-stag">{layerGrid.map((l) => <div id={l.layer.toLowerCase()} class:list={['p-layer', 'studio-lane-card', { on: l.on }]}><div class="p-layer-mot" aria-hidden="true"><div class="ring rgA"></div><div class="ring rgB"></div><div class="ring rgC"></div><div class="cdot"></div></div><span class="lab">{l.label}</span><h3 class="disp p-layer-h">{l.layer}</h3>{t === 'services' && <div class="studio-lane-image"><CaseScene name={laneScenes[l.layer]} alt={l.layer + ' project mockups'} /></div>}<ul class="p-links">{l.services.map((s) => <li><a class={svc?.slug === s.slug ? 'cur' : ''} href={'/services/' + s.slug + '/'} aria-current={svc?.slug === s.slug ? 'page' : undefined}><span>{s.title}</span></a></li>)}</ul></div>)}</div>
  </div></section>
)}

{t === 'work' && (route.path === '/work/' ? <WorkOverview /> : <WorkLane lane={route.layer || 'Build'} />)}

{study && <><CaseStudyHero study={study} /><PageRail path={route.path} title={route.title} /><div id="case-story" class="case-story-anchor"></div></>}

{study && ['carla-funk-photography','ballad-health','meade-tractor','general-shale'].includes(study.slug) && <ClientMaterialCase study={study} />}
{study?.slug === 'felon-motorwerk' && <FelonCase />}
{study?.slug === 'miami-tactical' && <MiamiTacticalCase />}
{study?.slug === 'las-vegas-safety' && <LasVegasSafetyCase />}
{study && study.slug in websiteCases && <WebsiteCase slug={study.slug as WebsiteCaseSlug} />}
{study && !(study.slug in websiteCases) && !['carla-funk-photography','ballad-health','meade-tractor','general-shale','felon-motorwerk','miami-tactical','las-vegas-safety'].includes(study.slug) && (<>

  {study.slug === 'us-oil-solutions' && <nav class="wrap c-project-stages" aria-label="Project stages"><a href="#original-website">01 / First website</a><a href="#operations-app">02 / Operations app · 2024–2025</a><a href="#website">03 / Second website · In progress</a></nav>}
  <section class="p-band"><div class="wrap"><div class="c-facts rv rv-stag"><div><span class="lab">{study.nonprofit ? 'Organization' : 'Client'}</span><p>{study.client || study.title}</p></div><div><span class="lab">{study.contextLabel || 'Location'}</span><p>{study.location}</p></div>{study.timeline && <div><span class="lab">Timeline</span><p>{study.timeline}</p></div>}<div><span class="lab">Scope</span><p>{study.scope}</p></div></div>
