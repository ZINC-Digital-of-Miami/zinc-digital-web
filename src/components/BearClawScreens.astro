---
import Img from './Img.astro';

const pages = [
  { key: 'home', title: 'Home', path: '/', detail: 'The product introduction, adapted to each screen.' },
  { key: 'product', title: 'Product', path: '/product', detail: 'Product information with room for the details.' },
  { key: 'about', title: 'About', path: '/about', detail: 'The company story in the same visual language.' },
  { key: 'quote', title: 'Request a quote', path: '/quote', detail: 'A dedicated page for the next conversation.' },
];
const devices = [
  { key: 'desktop', title: 'Desktop', viewport: '1440 × 900', sizes: '(max-width: 720px) 84vw, (max-width: 1000px) 80vw, 620px', widths: [480, 960, 1440] },
  { key: 'tablet', title: 'Tablet', viewport: '834 × 1112', sizes: '(max-width: 720px) 45vw, (max-width: 1000px) 44vw, 350px', widths: [480, 834, 1200] },
  { key: 'mobile', title: 'Mobile', viewport: '390 × 844', sizes: '(max-width: 720px) 29vw, (max-width: 1000px) 28vw, 230px', widths: [390, 780] },
];
---

<section class="bc-screens" aria-labelledby="bc-screens-title">
  <div class="wrap">
    <header class="bc-heading">
      <div>
        <span class="kick">Responsive website</span>
        <h2 class="disp" id="bc-screens-title">Every page.<br />Every screen.</h2>
      </div>
      <p>Home, product, about and quote pages, shown on desktop, tablet and mobile.</p>
    </header>

    <div class="bc-pages">
      {pages.map(page => <article class="bc-page" aria-labelledby={`bc-page-${page.key}`}>
        <header class="bc-page-heading">
          <div>
            <h3 class="disp" id={`bc-page-${page.key}`}>{page.title}</h3>
            <p>{page.detail}</p>
          </div>
          <a class="bc-live" href={`https://bear-claw-usa.vercel.app${page.path}`} target="_blank" rel="noopener noreferrer" aria-label={`View the Bear Claw ${page.title.toLowerCase()} page (opens in a new tab)`}>View page <span aria-hidden="true">↗</span></a>
        </header>

        <div class="bc-stage">
          {devices.map(device => <figure class={`bc-device bc-${device.key}`}>
            <div class="bc-hardware">
              <div class="bc-display">
                <Img k={`bear-claw-${page.key}-${device.key}`} alt={`Bear Claw ${page.title.toLowerCase()} page in its ${device.title.toLowerCase()} layout`} sizes={device.sizes} widths={device.widths} />
              </div>
            </div>
            <figcaption><span>{device.title}</span><span class="bc-viewport">{device.viewport}</span></figcaption>
          </figure>)}
        </div>
      </article>)}
    </div>
  </div>
</section>

<style>
  .bc-screens{padding:clamp(64px,9vw,120px) 0;border-top:1px solid var(--line);color:var(--ink)}
  .bc-heading{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:end;margin-bottom:clamp(40px,6vw,80px)}
  .bc-heading h2{font-size:clamp(44px,6vw,86px);margin-top:18px}
  .bc-heading p{margin:0;max-width:38ch;font-size:18px;line-height:1.65;color:var(--muted)}
  .bc-pages{display:grid;gap:clamp(48px,7vw,96px)}
  .bc-page{min-width:0}
  .bc-page-heading{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:0 0 26px}
  .bc-page-heading h3{font-size:clamp(30px,3.3vw,46px);line-height:1}
  .bc-page-heading p{margin:12px 0 0;font-size:16px;line-height:1.5;color:var(--muted)}
  .bc-live{display:inline-flex;align-items:center;justify-content:space-between;gap:24px;min-height:44px;flex-shrink:0;border-bottom:1px solid var(--ink);font-family:var(--fm);font-size:13px;text-transform:uppercase;letter-spacing:.04em;cursor:pointer}
  .bc-live:hover{color:var(--tealt);border-color:var(--tealt)}
  .bc-live:focus-visible{outline:2px solid var(--tealt);outline-offset:5px}
  .bc-stage{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,.8fr) minmax(0,.55fr);align-items:end;gap:clamp(16px,2.4vw,36px);padding:clamp(24px,3.8vw,54px);border:1px solid var(--line);background:var(--bg2)}
  .bc-device{min-width:0;margin:0}
  .bc-hardware{position:relative;padding:12px 8px 9px;border:1px solid #64666a;border-radius:13px;background:linear-gradient(145deg,#393b3f,#111214 40%,#25272a);box-shadow:0 2px 2px #0003,0 16px 24px -12px #0005,inset 0 0 0 1px #ffffff19}
  .bc-hardware::before{content:"";position:absolute;top:5px;left:50%;width:3px;height:3px;border-radius:50%;background:#62656b;transform:translateX(-50%)}
  .bc-display{background:#080808;line-height:0}
  .bc-display :global(picture),.bc-display :global(img){display:block;width:100%;height:auto;max-height:none;filter:none}
  .bc-desktop .bc-hardware{margin-bottom:8px}
  .bc-desktop .bc-hardware::after{content:"";position:absolute;bottom:-7px;left:-3%;width:106%;height:7px;border:1px solid #777a80;border-top:1px solid #c0c2c6;border-radius:1px 1px 50% 50% / 1px 1px 6px 6px;background:linear-gradient(#a7a9ae,#55585d);box-shadow:0 3px 3px #0002}
  .bc-tablet .bc-hardware{padding:16px 9px;border-radius:18px}
  .bc-tablet .bc-hardware::before{top:6px;width:4px;height:4px}
  .bc-mobile .bc-hardware{padding:17px 7px 15px;border-radius:20px}
  .bc-mobile .bc-hardware::before{top:6px;width:18px;height:3px;border-radius:5px;background:#474a50}
  .bc-mobile .bc-hardware::after{content:"";position:absolute;bottom:6px;left:35%;width:30%;height:3px;border-radius:3px;background:#686b71}
  .bc-device figcaption{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;min-height:38px;padding-top:18px;font-family:var(--fm);font-size:11px;line-height:1.5;text-transform:uppercase;letter-spacing:.04em}
  .bc-viewport{color:var(--muted);white-space:nowrap}
  :global(html[data-theme="dark"]) .bc-hardware{box-shadow:0 2px 2px #0008,0 16px 24px -12px #000b,inset 0 0 0 1px #ffffff19}
  @media(max-width:1000px){
    .bc-stage{grid-template-columns:minmax(0,1fr) minmax(0,.64fr);gap:36px clamp(24px,6vw,70px);padding:clamp(24px,5vw,48px)}
    .bc-desktop{grid-column:1/-1}
    .bc-tablet{width:100%;max-width:390px;justify-self:end}
    .bc-mobile{width:100%;max-width:250px;justify-self:start}
  }
  @media(max-width:720px){
    .bc-heading{grid-template-columns:1fr;gap:24px}
    .bc-heading p{font-size:17px}
    .bc-page-heading{align-items:flex-start;flex-direction:column;gap:12px}
    .bc-page-heading p{max-width:32ch}
    .bc-stage{padding:24px 14px;gap:28px 16px}
    .bc-hardware{padding:10px 5px 6px;border-radius:9px}
    .bc-hardware::before{top:4px;width:2px;height:2px}
    .bc-tablet .bc-hardware{padding:12px 5px;border-radius:12px}
    .bc-tablet .bc-hardware::before{top:5px;width:3px;height:3px}
    .bc-mobile .bc-hardware{padding:13px 4px 12px;border-radius:13px}
    .bc-mobile .bc-hardware::before{top:5px;width:14px;height:2px}
    .bc-mobile .bc-hardware::after{bottom:5px;height:2px}
    .bc-device figcaption{display:grid;gap:2px;padding-top:12px;font-size:10px}
  }
</style>
