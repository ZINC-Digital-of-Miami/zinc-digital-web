---
export const prerender=false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import Drawer from '../../components/admin/Drawer.astro';
import {requireStaff} from '../../lib/auth';
import {createServerClient} from '../../lib/supabase';
import {when} from '../../lib/admin-data';
const staff=requireStaff(Astro);if(staff instanceof Response)return staff;
const{data,error}=await createServerClient(Astro).from('staff').select('*').order('created_at');
---
<AdminLayout view="staff" title="Staff">{staff.role==='owner'&&<button slot="action" class="a-button primary" data-open-dialog="invite-staff">Invite staff</button>}{error&&<p class="a-error">Staff could not be loaded.</p>}<div class="a-table-wrap"><table class="a-table"><thead><tr><th>Name / email</th><th>Role</th><th>Joined / sign-in</th><th>Actions</th></tr></thead><tbody>{(data||[]).map(member=><tr><td>{member.name||member.email}<small class="a-count">{member.email}</small></td><td>{member.role}</td><td>{when(member.created_at)}<small class="a-count" data-staff-status={member.user_id}>Sign-in status loading…</small></td><td>{staff.role==='owner'?<button class="a-button" data-open-dialog={'staff-'+member.user_id}>Manage</button>:<span class="a-muted">Read only</span>}</td></tr>)}</tbody></table></div>
{staff.role==='owner'&&<><Drawer id="invite-staff" title="Invite staff"><form class="a-form" data-admin-form data-endpoint="/api/admin/staff/" data-body='{"action":"invite"}'><label class="a-field"><span>Name</span><input class="a-input" name="name" maxlength="100" required/></label><label class="a-field"><span>Work email</span><input class="a-input" type="email" name="email" maxlength="254" required/></label><p class="a-muted">Invite a @zincdigital.co or @zincmiami.com address.</p><label class="a-field"><span>Role</span><select class="a-input" name="role"><option value="editor">Editor</option><option value="owner">Owner</option></select></label><p class="a-error" data-form-error role="alert" hidden></p><button class="a-button primary" type="submit">Send invitation</button></form></Drawer>{(data||[]).map(member=><Drawer id={'staff-'+member.user_id} title={member.name||member.email}><p>{member.email}</p><form class="a-form" data-admin-form data-endpoint="/api/admin/staff/" data-body={JSON.stringify({action:'role',id:member.user_id})}><label class="a-field"><span>Role</span><select class="a-input" name="role"><option value="editor" selected={member.role==='editor'}>Editor</option><option value="owner" selected={member.role==='owner'}>Owner</option></select></label><p class="a-error" data-form-error role="alert" hidden></p><button class="a-button primary" type="submit">Save role</button></form><div class="a-actions a-section"><button class="a-button" data-endpoint="/api/admin/staff/" data-body={JSON.stringify({action:'resend',id:member.user_id})} data-success="Invitation resent.">Resend invitation</button><button class="a-button danger" data-endpoint="/api/admin/staff/" data-body={JSON.stringify({action:'revoke',id:member.user_id,confirm:true})} data-confirm="Revoke this unaccepted invitation?">Revoke invitation</button><button class="a-button danger" data-endpoint="/api/admin/staff/" data-body={JSON.stringify({action:'offboard',id:member.user_id,confirm:true})} data-confirm="Remove this person's admin access and account?">Offboard</button></div><p class="a-muted">At least one owner must remain.</p></Drawer>)}</>}
</AdminLayout>

<script>
async function statuses(){try{const res=await fetch('/api/admin/staff/');if(!res.ok)return;const data=await res.json();for(const member of data.staff){const el=document.querySelector('[data-staff-status="'+member.user_id+'"]');if(el)el.textContent=member.confirmed===undefined?'Account':member.confirmed?'Accepted · '+(member.last_sign_in_at?new Date(member.last_sign_in_at).toLocaleString('en-US',{timeZone:'America/Chicago'})+' CT':'No sign-in yet'):'Invitation pending';}}catch{}}
void statuses();document.addEventListener('admin:refresh',()=>void statuses());
</script>
