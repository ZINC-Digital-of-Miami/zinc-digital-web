---
import Img from './Img.astro';

interface Props {
  title: string;
  desktop: string;
  tablet?: string;
  mobile?: string;
  loading?: 'eager' | 'lazy';
}
const { title, desktop, tablet, mobile, loading = 'lazy' } = Astro.props;
// Real source captures beneath level hardware. Narrow screens use the supplied
// responsive captures when available; desktop-only evidence stays on desktop.
const screens = [
  { device: 'desktop', asset: desktop, sizes: '(max-width: 700px) 50vw, 680px', widths: [480, 768, 1100, 1536] },
  ...(tablet ? [{ device: 'tablet', asset: tablet, sizes: '(max-width: 700px) 16vw, 220px', widths: [280, 480, 768] }] : []),
  ...(mobile ? [{ device: 'mobile', asset: mobile, sizes: '(max-width: 700px) 10vw, 140px', widths: [280, 420, 640] }] : []),
];
---
{!mobile && !tablet ? <div class="desktop-capture"><Img k={desktop} alt={`${title} — desktop view`} loading={loading} sizes="(max-width: 700px) 92vw, 900px" /></div> : <div class="device-composition" data-device-composition>
  {screens.map(screen => <div class={`device-composition__screen device-composition__${screen.device}`} data-device={screen.device}>
    <Img k={screen.asset} alt={`${title} — source screen presented on ${screen.device === 'mobile' ? 'a phone' : 'a ' + screen.device}`} loading={loading} fetchpriority={loading === 'eager' && screen.device === 'desktop' ? 'high' : 'low'} sizes={screen.sizes} widths={screen.widths} quality={95} />
  </div>)}

</div>}
<style>
  .desktop-capture{width:100%;padding:12px;background:transparent;border:1px solid #555;border-radius:8px}.desktop-capture :global(img){width:100%;height:auto;display:block}
  .device-composition{position:relative;isolation:isolate;width:100%;aspect-ratio:3/2;overflow:visible;background:transparent}
  .device-composition__screen{position:absolute;overflow:hidden;background:#111;line-height:0;border:5px solid #222629;border-radius:9px;box-shadow:0 14px 32px #0005}
  .device-composition__screen :global(picture){display:block;width:100%;height:100%}
  .device-composition__screen :global(img){display:block;width:100%;height:100%;object-fit:cover;object-position:top center;filter:none;transform:none}
  .device-composition__desktop{border-bottom-width:16px;left:0;top:5%;width:85%;height:72%;z-index:1}
  .device-composition__laptop{border-bottom-width:9px;left:56.95%;top:45.6%;width:36.8%;height:33%;z-index:2}
  .device-composition__tablet{left:61%;top:36%;width:26%;height:55%;z-index:3}
  .device-composition__mobile{border-radius:16px;left:81%;top:52%;width:17%;height:43%;z-index:4}
  .device-composition :global(.device-composition__frame){position:absolute;inset:0;width:100%;height:100%;z-index:5;pointer-events:none;object-fit:contain}
</style>
