---
import PageRail from "../PageRail.astro";
import ApprovedImage from '../ApprovedImage.astro';
const slides=[{name:'build',image:'bear-white-devices.png',alt:'Bear Claw USA website on desktop, laptop, tablet and phone'},{name:'demand',image:'demand-summit.png',alt:'Summit Marine Development campaign creative on phones and desktop'},{name:'intelligence',image:'intelligence-fusion.png',alt:'ZINC Fusion v16 forecasting dashboard on desktop and tablet; private figures removed'}];
---
<section aria-label="ZINC Digital and our work" class="zn-hero" id="hero"><div class="wrap"><div class="zn-mast"><h1><span class="zn-stable-word">ZINC DIGITAL</span><span>.</span></h1><p><span>Other agencies deliver the scope.</span><br/>ZINC delivers the business.</p></div><div class="zn-stage" data-lane="build">{slides.map((slide,i)=><div class="zn-hero-picture" data-zn-picture={slide.name} hidden={i!==0}><a href={i===0?'/work/bear-claw-usa/':i===1?'/work/summit-marine-development/':'/work/zinc-fusion-v16/'} aria-label={i===0?'Explore the Bear Claw USA project':i===1?'Explore the Summit Marine Development project':'Explore the ZINC Fusion project'}><ApprovedImage name={slide.image} alt={slide.alt} loading={i===0?'eager':'lazy'} sizes="(max-width: 760px) 100vw, 75vw" /></a></div>)}<div class="zn-copy"><h2 id="zn-title">BUILD<span>.</span></h2><p id="zn-description">Websites, commerce<br/>and applications.</p></div></div><div aria-label="Explore our three lanes" class="zn-tabs"><button aria-pressed="true" data-zn-lane="build" type="button">BUILD </button><button aria-pressed="false" data-zn-lane="demand" type="button">DEMAND </button><button aria-pressed="false" data-zn-lane="intelligence" type="button">INTELLIGENCE </button></div></div></section><PageRail path="/" title="Home" /><script>
const root=document.querySelector('.zn-hero');
if(root){
const content={build:['BUILD','Websites, commerce<br>and applications.'],demand:['DEMAND','Search. Campaigns.<br>The path to a customer.'],intelligence:['INTELLIGENCE','Reporting and systems<br>for the next decision.']};
root.querySelectorAll<HTMLButtonElement>('[data-zn-lane]').forEach(button=>button.addEventListener('click',()=>{const key=button.dataset.znLane as keyof typeof content;root.querySelector<HTMLElement>('.zn-stage')!.dataset.lane=key;root.querySelector('#zn-title')!.innerHTML=content[key][0]+'<span>.</span>';root.querySelector('#zn-description')!.innerHTML=content[key][1];root.querySelectorAll<HTMLElement>('[data-zn-picture]').forEach(p=>p.hidden=p.dataset.znPicture!==key);root.querySelectorAll('[data-zn-lane]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));}));
}
</script><style>
 @media(max-width:760px){
  .zn-stage[data-lane="build"]{display:flex;flex-direction:column}
  .zn-stage[data-lane="build"]::before{display:none}
  .zn-stage[data-lane="build"] .zn-copy{position:relative;left:auto;top:auto;max-width:none;order:-1;padding:12px 0 18px}
  .zn-stage[data-lane="build"] .zn-hero-picture :global(img){width:100%;aspect-ratio:1.5;object-fit:contain;mask-image:none;mix-blend-mode:normal}
 }
</style>
