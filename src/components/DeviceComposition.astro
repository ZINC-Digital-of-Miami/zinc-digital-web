---
import DeviceFrame from './DeviceFrame.astro';
interface Props { title: string; desktop: string; tablet?: string; mobile?: string; loading?: 'eager' | 'lazy' }
const { title, desktop, tablet, mobile, loading = 'lazy' } = Astro.props;
---
<div class:list={['device-composition',{'device-composition--single':!tablet && !mobile}]} data-device-composition>
  <div class="device-composition__laptop"><DeviceFrame device="laptop" asset={desktop} title={title+' — desktop website'} loading={loading} sizes="(max-width:700px) 85vw, 900px" /></div>
  {tablet && <div class="device-composition__tablet"><DeviceFrame device="tablet" asset={tablet} title={title+' — tablet website'} loading={loading} sizes="(max-width:700px) 28vw, 300px" /></div>}
  {mobile && <div class="device-composition__phone"><DeviceFrame device="phone" asset={mobile} title={title+' — mobile website'} loading={loading} sizes="(max-width:700px) 18vw, 180px" /></div>}
</div>
<style>
.device-composition{position:relative;isolation:isolate;width:100%;aspect-ratio:3/2}
.device-composition__laptop{position:absolute;width:86%;left:0;top:9%;filter:drop-shadow(0 18px 16px #0003)}
.device-composition__tablet{position:absolute;width:29%;right:0;top:15%;filter:drop-shadow(-10px 15px 12px #0003)}
.device-composition__phone{position:absolute;width:16%;right:22%;bottom:6%;filter:drop-shadow(-8px 12px 10px #0003)}
.device-composition--single .device-composition__laptop{width:96%;left:2%;top:2%}
</style>
