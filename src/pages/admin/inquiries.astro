---
export const prerender=false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import Drawer from '../../components/admin/Drawer.astro';
import {requireStaff} from '../../lib/auth';
import {createServerClient} from '../../lib/supabase';
import {inquiries,stages,when,type InquiryRow} from '../../lib/admin-data';
const staff=requireStaff(Astro);if(staff instanceof Response)return staff;
let rows:InquiryRow[]=[],error='';
try{rows=await inquiries(Astro);}catch(e){error=(e as Error).message;}
const active=rows.filter(r=>!r.archived_at),archived=rows.filter(r=>r.archived_at);
const events=rows.length?await createServerClient(Astro).from('inquiry_events').select('inquiry_id,kind,payload,created_at,actor').in('inquiry_id',rows.map(r=>r.id)).order('created_at',{ascending:false}).limit(500):{data:[],error:null};
---
<AdminLayout view="inquiries" title="Inquiries">
{error&&<p class="a-error" role="alert">{error}</p>}
<section class="a-board a-section" aria-label="Inquiry stages">{stages.map(([key,label,next])=><div class="a-board-column"><div class="a-label">{label} · {active.filter(r=>r.stage===key).length}</div><p class="a-muted">{next}</p>{active.filter(r=>r.stage===key).map(r=><button type="button" class="a-inquiry a-row-button" data-open-dialog={'inquiry-'+r.id}><strong>{r.company||r.name}</strong><span>{r.name}</span><small>{r.services.join(' / ')} · {r.budget}</small><small>{when(r.created_at)}</small><span class="a-chip">Notification {r.notify_status}</span></button>)}{!active.some(r=>r.stage===key)&&<p class="a-empty">No {label.toLowerCase()} inquiries.</p>}</div>)}</section>
<section class="a-panel a-section"><h2 class="a-heading">Archived · {archived.length}</h2>{archived.length?<ul class="a-list">{archived.map(r=><li class="a-actions"><button class="a-row-button" data-open-dialog={'inquiry-'+r.id}>{r.company||r.name}</button><button class="a-button" data-endpoint="/api/admin/inquiries/" data-body={JSON.stringify({id:r.id,archived:false})} data-success="Inquiry restored.">Restore</button></li>)}</ul>:<p class="a-empty">No archived inquiries.</p>}</section>
{rows.map(r=><Drawer id={'inquiry-'+r.id} title={r.company||r.name}>
<dl class="a-details">{[['Name',r.name],['Email',r.email],['Website',r.website],['Services',r.services.join(', ')],['Budget',r.budget],['Timeline',r.timeline],['Message',r.message],['Source',r.source_path],['Received',when(r.created_at)],['Notification',r.notify_status]].map(([key,value])=><><dt>{key}</dt><dd>{value||'—'}</dd></>)}</dl>
<form class="a-form" data-admin-form data-endpoint="/api/admin/inquiries/" data-body={JSON.stringify({id:r.id})}><label class="a-field"><span>Stage</span><select class="a-input" name="stage">{stages.map(([key,label])=><option value={key} selected={r.stage===key}>{label}</option>)}</select></label><label class="a-field"><span>Notes</span><textarea class="a-input" name="notes" rows="5" maxlength="20000">{r.notes}</textarea></label><label class="a-field"><span>Next step</span><textarea class="a-input" name="next_step" rows="2" maxlength="2000">{r.next_step}</textarea></label><p class="a-error" data-form-error role="alert" hidden></p><button class="a-button primary" type="submit">Save changes</button></form>
<div class="a-actions a-section"><a class="a-button" href={'mailto:'+r.email}>Email</a><button class="a-button" data-endpoint="/api/admin/inquiries/" data-body={JSON.stringify({id:r.id,archived:!r.archived_at})} data-success={r.archived_at?'Inquiry restored.':'Inquiry archived.'}>{r.archived_at?'Restore':'Archive'}</button>{r.notify_status==='failed'&&<button class="a-button" data-endpoint="/api/admin/notify/" data-body={JSON.stringify({id:r.id})} data-success="Notification resend completed.">Resend notification</button>}</div>
<h3 class="a-heading a-section">History</h3>{events.error?<p class="a-error">History could not be loaded.</p>:(events.data||[]).filter(event=>event.inquiry_id===r.id).map(event=><div class="a-event"><strong>{event.kind}</strong> · {when(event.created_at)}<div class="a-muted">{event.actor?'Staff action':'Website action'}</div></div>)}
</Drawer>)}
</AdminLayout>
