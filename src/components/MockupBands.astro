---
import Hero from './bands/Hero.astro';
import {services,layers,cases,team,posts,assets,clients,commitments,toSitePath,dateLabel} from '../data/mockup';
interface Props {part?:'home'|'loop'}
const {part='home'}=Astro.props;
const link=(path:string)=>toSitePath(path);
const asset=(key:string)=>assets[key as keyof typeof assets];
---

{part==='home' && <>
  <Hero supporting="[DRAFT] Supporting statement under editorial review." draft={false} ctaHref={link('/contact/')} />
  <section class="band logo-band" data-theme="light" data-home-band="clients"><div class="band__inner"><p class="t-label eyebrow">Selected client relationships</p><div class="client-grid">{clients.map(name=><div class="client-name" tabindex="0"><span>{name}</span><small class="t-label">[LOGO PENDING]</small></div>)}</div><img class="light-wordmark" src={assets["wordmark-white"].src} width={892} height={222} alt="ZINC" loading="lazy" /><img class="brand-seal dark-seal" src={assets['mark-white'].src} width={2000} height={2000} alt="ZINC Digital circuit mark" loading="lazy" /></div></section>
</>}
{(part==='home'||part==='loop') && <section class="band loop-band" data-theme="light" data-home-band={part==='home'?'loop':undefined}><div class="band__inner"><div class="section-heading"><div><p class="t-label eyebrow">One system / three connected layers</p><h2 class="section-title">The work connects.</h2></div><p class="muted narrow">[DRAFT] What you build shapes demand. What you learn shapes both.</p></div>
<div class="loop-scene"><svg class="loop-circuit" viewBox="0 0 1200 220" fill="none" aria-hidden="true" preserveAspectRatio="none"><path class="circuit-base" d="M60 45 H1140 V180 H60 Z"/><path class="circuit-trace" pathLength="1" d="M60 45 H1140 V180 H60 Z"/><circle cx="60" cy="45" r="8"/><circle cx="600" cy="45" r="8"/><circle cx="1140" cy="45" r="8"/></svg><div class="layer-grid">{layers.map((layer,i)=><div class="layer"><p class="t-label">0{i+1}</p><h3 class="layer-title">{layer}</h3><ul class="link-list">{services.filter(s=>s.layer===layer).map(s=><li><a href={link('/services/'+s.slug+'/')}>{s.title}<span aria-hidden="true">↗</span></a></li>)}</ul></div>)}</div></div>
</div></section>}
{part==='home' && <>
  {cases.map((study,i)=><section class="band case-band" data-theme="light" data-home-band={study.slug}><div class="band__inner"><div class="section-heading"><p class="t-label eyebrow">Selected work / 0{i+1}</p><p class="t-label muted">{study.layers.join(' / ')}</p></div><h2 class="case-title"><a href={link('/work/'+study.slug+'/')}>{study.title}</a></h2><div class="case-preview"><div class="case-description"><p class="lede">[DRAFT] {study.line}</p><div class="case-mini-loop" aria-label={'Active layers: '+study.layers.join(', ')}>{layers.map(layer=><span class:list={[{active:study.layers.includes(layer)}]}><i aria-hidden="true"></i>{layer}{!study.layers.includes(layer)&&<small>Scope to confirm</small>}</span>)}</div><p class="muted">{study.situation}</p>{i===0?<ul class="plain-list"><li>TikTok · Shopping · Meta ads</li><li>Blog content · Web updates</li><li>Reporting system</li></ul>:<ol class="timeline"><li>Website</li><li>SEO</li><li>Two apps</li><li>Next build [OWNER CONFIRM]</li></ol>}<p class="receipt">{study.receipts[0]}</p><a class="arrow-link" href={link('/work/'+study.slug+'/')}>Inside the work ↗</a><a class="text-link" href={study.url} rel="noopener noreferrer">Visit the public client site ↗</a></div><figure class="device-frame"><div class="device-chrome" aria-hidden="true">○ ○ ○</div><img src={asset(study.images[0]).src} width={asset(study.images[0]).width} height={asset(study.images[0]).height} alt={i===0?'Once Upon a Book Club storefront':'U.S. Oil Solutions application screenshot'} loading="lazy" /><figcaption class="t-label">{i===0?'Storefront / source screenshot':'Application / screenshot only'}</figcaption></figure></div></div></section>)}
  <section class="band" data-theme="light" data-home-band="commitments"><div class="band__inner split"><div><p class="t-label eyebrow">How we work / draft commitments</p><h2 class="section-title">The working agreement.</h2></div><ol class="commitments">{commitments.map((line,i)=><li><span class="t-label">0{i+1}</span><div><p>{line}</p><span class="draft-tag">[OWNER CONFIRM]</span></div></li>)}</ol></div></section>
</>}
{part==='home' && <section class="band team-band" data-theme="light" data-home-band="team"><div class="band__inner"><div class="section-heading"><div><p class="t-label eyebrow">The people doing the work</p><h2 class="section-title">One connected team.</h2></div>{part==='home'&&<a class="arrow-link" href={link('/about/')}>Meet ZINC ↗</a>}</div><div class="team-grid" data-team>{team.map(person=><article class="person" data-person={person.id} style={person.photo?"--portrait-ratio:"+asset(person.photo).width/asset(person.photo).height:undefined}>{person.photo?<img src={asset(person.photo).src} width={asset(person.photo).width} height={asset(person.photo).height} alt={person.name} loading="lazy" />:<div class="photo-pending"><span class="t-label">[PHOTO PENDING]</span></div>}<h3>{person.name}</h3><p class="muted">{person.role}</p></article>)}</div></div></section>}
{part==='home' && <section class="band" data-theme="light" data-home-band="articles"><div class="band__inner"><div class="section-heading"><div><p class="t-label eyebrow">Latest articles / migration previews</p><h2 class="section-title">Notes on the work.</h2></div><a class="arrow-link" href={link('/blog/')}>All articles ↗</a></div><div class="article-grid">{posts.slice(0,3).map(post=><article class="article-card"><p class="t-label muted">{dateLabel(post.dateGmt)} / {post.layer}</p><h3 class="t-heading"><a href={link('/blog/'+post.slug+'/')}>{post.title}</a></h3><p class="draft-tag">Draft migration preview</p><a class="arrow-link" href={link('/blog/'+post.slug+'/')}>Read article ↗</a></article>)}</div></div></section>}
{part==='home' && <footer class="band site-footer" data-theme="light" data-home-band="footer"><div class="band__inner"><p class="t-label eyebrow">ZINC / Miami · Panama City · Nationwide</p><div class="footer-lead"><h2 class="section-title">The next part starts here.</h2><span class="draft-tag">[DRAFT]</span></div><div class="footer-grid"><div><a class="button" href={link('/contact/')}>Start an Inquiry</a><a class="arrow-link" href="sms:+17865754837">Text (786) 575-4837 ↗</a><a class="text-link" href="mailto:hello@zincdigital.co">hello@zincdigital.co</a></div><div><h3 class="t-label">Miami HQ</h3><address>1900 N Bayshore Dr<br/>Miami, FL 33132</address><h3 class="t-label">Panama City satellite</h3><address>97 Oak Ave Suite 7<br/>Panama City, FL 32401</address></div><nav aria-label="Social links"><a href="https://www.facebook.com/zincdigitalofmiami">Facebook ↗</a><a href="https://www.instagram.com/zincdigitalofmiami/">Instagram ↗</a><a href="https://x.com/zinc_of">X ↗</a><a href="https://www.linkedin.com/company/zinc-digital-of-miami/">LinkedIn ↗</a><span class="draft-tag">YouTube [OWNER CONFIRM]</span></nav><img class="brand-seal" src={assets['mark-black'].src} width={2000} height={2000} loading="lazy" alt="ZINC Digital circuit mark"/></div><div class="footer-bottom"><img src={assets['wordmark-black'].src} width={assets['wordmark-black'].width} height={assets['wordmark-black'].height} alt="ZINC"/><p class="t-label muted">Public design draft</p><nav aria-label="Legal"><a href={link('/privacy/')}>Privacy</a><a href={link('/terms/')}>Terms</a></nav></div></div></footer>}

<script>
  for(const grid of document.querySelectorAll<HTMLElement>('[data-team]')) {
    const shuffle=()=>{if(grid.contains(document.activeElement))return;const cards=Array.from(grid.children);for(let i=cards.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[cards[i],cards[j]]=[cards[j],cards[i]];}grid.append(...cards);};
    if(!matchMedia('(prefers-reduced-motion: reduce)').matches){shuffle();const observer=new IntersectionObserver(entries=>{if(entries.some(e=>e.isIntersecting)){shuffle();observer.disconnect();}},{threshold:0.15});observer.observe(grid);}
  }
</script>
