---
import { authors } from '../../data/authors';
import Drawer from './Drawer.astro';
import ContentForm from './ContentForm.astro';
import PublishBar from './PublishBar.astro';
import {contentList,score,unpublished,type ContentItem} from '../../lib/admin-data';
interface Props{kind:'page'|'post'}
const{kind}=Astro.props;
let items:ContentItem[]=[],error='';try{items=await contentList(Astro);}catch(e){error=(e as Error).message;}
const rows=items.filter(x=>x.kind===kind);
---
{error&&<p class="a-error" role="alert">{error}</p>}
<div class="a-tools"><label class="a-field"><span class="a-label">Search {kind==='page'?'pages':'posts'}</span><input class="a-input" type="search" data-list-search placeholder="Search titles and addresses"/></label><label class="a-field"><span class="a-label">Status</span><select class="a-input" data-list-filter><option value="">All statuses</option><option value="published">Published</option><option value="draft">Draft</option></select></label></div>
<p class="a-muted" data-list-results role="status" aria-live="polite" aria-atomic="true">{rows.length} {kind==='page'?'pages':'posts'}</p>
<div class="a-table-wrap" tabindex="0" role="region" aria-label={kind==='page'?'Pages table':'Posts table'}><table class="a-table"><thead><tr><th scope="col">{kind==='page'?'Page':'Post'}</th><th scope="col">Type / layer</th><th scope="col">Status</th><th scope="col">Metadata</th><th scope="col">Publishing</th></tr></thead><tbody>{rows.map((item,i)=><tr data-status={item.status} data-layer={item.layer} data-search-row={(item.title+' '+item.path+' '+item.layer+' '+item.status).toLowerCase()}><td><button class="a-row-button" type="button" data-open-dialog={'content-'+i}>{item.title}<small>{item.path}</small></button></td><td>{kind==='page'?item.template:item.layer}</td><td>{item.status}</td><td>{score(item).score}</td><td>{(item.pending??(item.saved&&(!item.live_at||!item.updated_at||item.updated_at>item.live_at)))?'Unpublished changes':item.live_at?'Published':'Repository content'}</td></tr>)}</tbody></table></div>
<p class="a-empty" data-list-empty hidden={rows.length>0||!!error}>{kind==='post'?'No posts yet. Create your first draft.':'No pages found.'}</p>
{rows.map((item,i)=><Drawer id={'content-'+i} title={item.title}><ContentForm item={item}/></Drawer>)}
{kind==='post'&&<Drawer id="new-post" title="New post"><form class="a-form" data-admin-form data-endpoint="/api/admin/content/" data-body='{"kind":"post","status":"draft","create":true}'><label class="a-field"><span>Title</span><input class="a-input" name="title" required maxlength="200"/></label><label class="a-field"><span>Slug</span><input class="a-input" name="slug" required maxlength="200" pattern="[a-z0-9]+(-[a-z0-9]+)*" placeholder="new-post-address"/></label><label class="a-field"><span>Layer</span><select class="a-input" name="layer"><option>Build</option><option>Demand</option><option>Intelligence</option></select></label><label class="a-field"><span>Excerpt</span><textarea class="a-input" name="excerpt" rows="3" maxlength="2000"></textarea></label><label class="a-field"><span>Author</span><select class="a-input" name="author"><option>Team ZINC</option>{authors.map(a=><option>{a.name}</option>)}</select></label><label class="a-field"><span>Markdown body</span><textarea class="a-input" name="body" rows="12" maxlength="200000" required></textarea></label><p class="a-error" data-form-error role="alert" hidden></p><button class="a-button primary" type="submit">Create draft</button></form></Drawer>}
<PublishBar pending={unpublished(items)}/>
