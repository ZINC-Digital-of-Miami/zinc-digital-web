---
import {compareSnapshots,scoreTrend,trafficComparisons,type ScoreSnapshot,type ScoreHistory} from '../../lib/seo-review-dashboard';
import SeoRfpFunnel from './SeoRfpFunnel.astro';
import SeoContentPerformance from './SeoContentPerformance.astro';
interface Props {snapshot:ScoreSnapshot|null;history:ScoreHistory[];at?:string;evidence:readonly unknown[];anomaly?:{status:string;detail:string}}
const {snapshot,history,at,evidence,anomaly}=Astro.props;
const previous=history.filter(h=>h.at!==at&&(!at||Date.parse(h.at)<Date.parse(at))).at(-1);
const comparison=snapshot?compareSnapshots(snapshot,previous?.scorecard):null;
const trend=scoreTrend(history);
const date=(v:string)=>new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit',timeZone:'America/Chicago'}).format(new Date(v))+' CT';
const compactDate=(v:string)=>new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',timeZone:'America/Chicago'}).format(new Date(v));
const number=(v:number)=>new Intl.NumberFormat('en-US',{maximumFractionDigits:1}).format(v);
const delta=(v:number)=>`${v>0?'+':''}${number(v)}`;
const selectedCategories=['Metadata','Indexability','Content'].map(name=>({name,value:snapshot?.categories.find(c=>c.name===name)}));
const arc='M 18 105 A 87 87 0 0 1 192 105';
const chartPoints=trend.points;
const earliest=chartPoints.length?Date.parse(chartPoints[0].at):0,latest=chartPoints.length?Date.parse(chartPoints.at(-1)!.at):0;
const x=(v:string)=>earliest===latest?340:56+(Date.parse(v)-earliest)/(latest-earliest)*564;
const y=(score:number)=>198-score/100*160;
const line=chartPoints.map(p=>`${x(p.at)},${y(p.mean)}`).join(' ');
const traffic=trafficComparisons(evidence);
const search=Astro.url.searchParams.get('pageSearch')||'',state=Astro.url.searchParams.get('pageState')||'all',sort=Astro.url.searchParams.get('scoreSort')||'lowest';
let pages=(snapshot?.pages||[]).filter(p=>p.path.toLowerCase().includes(search.toLowerCase())&&(state==='all'||state==='attention'&&(p.grade==='blocked'||p.failed>0||p.warnings>0)||state==='scored'&&p.score!==null||state==='unavailable'&&p.score===null&&p.grade!=='excluded'||state==='excluded'&&p.grade==='excluded'));
if(sort==='highest')pages=[...pages].sort((a,b)=>(b.score??-1)-(a.score??-1));if(sort==='path')pages=[...pages].sort((a,b)=>a.path.localeCompare(b.path));
const pageCount=Math.max(1,Math.ceil(pages.length/25)),requestedPage=Number(Astro.url.searchParams.get('scorePage')||1),pageNumber=Number.isSafeInteger(requestedPage)?Math.max(1,Math.min(pageCount,requestedPage)):1;
const visible=pages.slice((pageNumber-1)*25,pageNumber*25),deltas=new Map(comparison?.pageDeltas.map(p=>[p.path,p.delta])||[]);
const preserved=[...Astro.url.searchParams.entries()].filter(([key])=>!['pageSearch','pageState','scoreSort','scorePage'].includes(key));
const pageLink=(n:number)=>{const q=new URLSearchParams(Astro.url.searchParams);q.set('scorePage',String(n));return '/admin/analysis/?'+q+'#page-scores';};
const editor=(path:string)=>{const article=path.match(/^\/blog\/([a-z0-9-]+)\/$/);return '/admin/seo/?'+new URLSearchParams({kind:article?'post':'page',key:article?article[1]:path});};
---
<section class="analysis-dashboard" aria-label="SEO score and traffic dashboard">
 <SeoRfpFunnel evidence={evidence}/>
 <div class="analysis-overview">
  <div class="analysis-score">
   <div class="a-label a-muted">Overall HTML checklist</div>
   <svg class="analysis-gauge" viewBox="0 0 210 144" role="img" aria-label={snapshot?.mean===null||!snapshot?'Overall checklist score unavailable':`Overall checklist score ${snapshot.mean} out of 100`}>
    <path class="gauge-track" d={arc} pathLength="100"/>
    {snapshot?.mean!==null&&snapshot&&<path class="gauge-value" d={arc} pathLength="100" stroke-dasharray={`${snapshot.mean} 100`}/>}
    <text class="gauge-number" x="105" y="98" text-anchor="middle">{snapshot?.mean===null||!snapshot?'—':number(snapshot.mean)}</text><text class="gauge-unit" x="105" y="122" text-anchor="middle">OUT OF 100</text>
    <text class="gauge-tick" x="18" y="133" text-anchor="middle">0</text><text class="gauge-tick" x="192" y="133" text-anchor="middle">100</text>
   </svg>
   <p class="analysis-change">{comparison?.available?<><strong>{delta(comparison.meanDelta!)} pts</strong><span>across {comparison.commonPages} matching pages</span></>:<><strong>Baseline</strong><span>{snapshot?comparison?.reason:'Refresh site checks to record the first measured baseline.'}</span></>}</p>
   <p class="a-count">{snapshot?`${snapshot.scored} scored · ${snapshot.blocked} blocked · ${snapshot.excluded} excluded · ${snapshot.unavailable} unavailable`:'No measured pages yet.'}</p>
  </div>
  <figure class="analysis-history">
   <div class="analysis-chart-head"><div><h2>Score history</h2><p class="a-muted">The same scored pages, measured over time.</p></div>{at&&<span class="a-count">As of {date(at)}</span>}</div>
   {chartPoints.length?<>
    <svg viewBox="0 0 660 242" role="img" aria-label={`Checklist score history across ${trend.commonPages} common pages: `+chartPoints.map(p=>`${date(p.at)}, ${p.mean} out of 100`).join('; ')}>
     {[0,50,100].map(t=><g><line class="chart-guide" x1="56" x2="620" y1={y(t)} y2={y(t)}/><text class="chart-label" x="42" y={y(t)+4} text-anchor="end">{t}</text></g>)}
     {chartPoints.length>1&&<polyline class="chart-line" points={line}/>}
     {chartPoints.map(p=><g><circle class="chart-dot" cx={x(p.at)} cy={y(p.mean)} r="4"><title>{date(p.at)} · {p.mean}/100</title></circle></g>)}
     <text class="chart-label" x="56" y="225">{compactDate(chartPoints[0].at)}</text><text class="chart-label" x="620" y="225" text-anchor="end">{chartPoints.length>1?compactDate(chartPoints.at(-1)!.at):'First baseline'}</text>
    </svg>
    <figcaption class="a-count">{chartPoints.length===1?'One snapshot is recorded. A later comparable snapshot will establish a change.':`${chartPoints.length} recorded snapshots · ${trend.commonPages} matching pages · fixed 0–100 scale.`}</figcaption>
   </>:<div class="analysis-empty-chart"><span class="a-label">No trend recorded</span><p>Run site checks to start the score history. Improvement requires at least two comparable measurements.</p></div>}
   <p class="analysis-method a-count">These are deterministic checks of rendered HTML, not Google scores or ranking predictions. Overall score is the mean of eligible page scores. Category scores weight applicable checklist points; missing evidence earns no invented score.</p>
  </figure>
 </div>
 <div class="analysis-categories">{selectedCategories.map(c=><div class="category-gauge"><svg viewBox="0 0 210 144" role="img" aria-label={`${c.name} checklist score ${c.value?c.value.score+' out of 100':'unavailable'}`}><path class="gauge-track" d={arc} pathLength="100"/>{c.value&&<path class="gauge-value" d={arc} pathLength="100" stroke-dasharray={`${c.value.score} 100`}/>}<text class="gauge-number" x="105" y="98" text-anchor="middle">{c.value?number(c.value.score):'—'}</text><text class="gauge-unit" x="105" y="123" text-anchor="middle">OUT OF 100</text></svg><div><h3>{c.name}</h3><p class="a-count">{c.value?`${c.value.pages} pages · ${number(c.value.points)} / ${number(c.value.maxPoints)} applicable points`:'No applicable category measurements yet.'}</p></div></div>)}</div>
 <section class="analysis-anomaly" aria-labelledby="anomaly-title"><div><p class="a-label a-muted">Exception review</p><h2 id="anomaly-title">Anomalies &amp; changes</h2></div><div>{anomaly?<><p class="a-count">{anomaly.status}</p><p>{anomaly.detail}</p></>:<p class="a-muted">Claude’s anomaly analysis awaits an approved review. Site checks below show observed failures and warnings; they do not establish a traffic anomaly or its cause.</p>}</div></section>
 <section class="analysis-traffic" aria-labelledby="traffic-comparison-title"><h2 id="traffic-comparison-title">Traffic comparison</h2><p class="a-muted">Native source periods remain separate. Sessions, clicks and key events measure different things.</p>{traffic.length?<div class="traffic-comparisons">{traffic.map(row=>{const maximum=Math.max(row.current||0,row.previous||0,1),format=(v:number|null)=>v===null?'Unavailable':row.percentage?number(v*100)+'%':number(v);const changed=row.current!==null&&row.previous!==null?row.percentage?delta((row.current-row.previous)*100)+' pp':delta(row.current-row.previous):'No comparison';return <div class="traffic-comparison"><div class="traffic-label"><h3>{row.label}</h3><span class="a-count">{row.source} · {changed}</span></div><div class="traffic-bars">{[{name:'Previous',value:row.previous,period:row.previousPeriod},{name:'Current',value:row.current,period:row.currentPeriod}].map(p=><div class="traffic-period"><span class="a-count">{p.name}</span><svg viewBox="0 0 320 16" role="img" aria-label={`${p.name} ${row.label}: ${format(p.value)}`}><rect class="traffic-track" width="320" height="10" y="3"/>{p.value!==null&&<rect class:list={['traffic-bar',{'traffic-current':p.name==='Current'}]} width={p.value/maximum*320} height="10" y="3"/>}</svg><strong>{format(p.value)}</strong></div>)}</div><details><summary class="a-count">Periods &amp; source limits</summary><p class="a-count">Previous: {row.previousPeriod}<br/>Current: {row.currentPeriod}<br/>{row.note}</p></details></div>;})}</div>:<p class="a-empty">No verified traffic comparison is saved in this snapshot. Refresh site checks to collect native Google evidence.</p>}</section>
 <section id="page-scores" class="analysis-pages" aria-labelledby="page-scores-title"><div class="analysis-chart-head"><div><h2 id="page-scores-title">Page scores</h2><p class="a-muted">Prioritize the actual page and its failed checks.</p></div>{snapshot&&<span class="a-count">{snapshot.total} measured targets</span>}</div>
  <form class="analysis-filters" method="get" action="/admin/analysis/">{preserved.map(([name,value])=><input type="hidden" name={name} value={value}/>)}<label class="a-field"><span>Find a page</span><input class="a-input" type="search" name="pageSearch" value={search} placeholder="Page path" maxlength="150"/></label><label class="a-field"><span>Show</span><select class="a-input" name="pageState"><option value="all" selected={state==='all'}>All pages</option><option value="attention" selected={state==='attention'}>Needs attention</option><option value="scored" selected={state==='scored'}>Scored</option><option value="unavailable" selected={state==='unavailable'}>Blocked / unavailable</option><option value="excluded" selected={state==='excluded'}>Intentionally excluded</option></select></label><label class="a-field"><span>Sort</span><select class="a-input" name="scoreSort"><option value="lowest" selected={sort==='lowest'}>Lowest score first</option><option value="highest" selected={sort==='highest'}>Highest score first</option><option value="path" selected={sort==='path'}>Page path</option></select></label><button type="submit" class="a-button">Apply</button></form>
  {visible.length?<><div class="analysis-table" tabindex="0" role="region" aria-label="Measured page scores"><table><thead><tr><th scope="col">Page</th><th scope="col">Score</th><th scope="col">Change</th><th scope="col">Checks</th><th scope="col">Action</th></tr></thead><tbody>{visible.map(p=><tr><th scope="row"><a class="a-link" href={p.path}>{p.path}</a><small>{p.grade}</small></th><td class="numeric">{p.score===null?'—':number(p.score)+' / 100'}</td><td class="numeric">{deltas.has(p.path)?delta(deltas.get(p.path)!)+' pts':'No comparison'}</td><td>{p.failed} failed · {p.warnings} warnings</td><td><a class="a-link" href={editor(p.path)}>Open SEO editor</a></td></tr>)}</tbody></table></div><nav class="analysis-pagination" aria-label="Page score pagination"><span class="a-count">{(pageNumber-1)*25+1}–{Math.min(pageNumber*25,pages.length)} of {pages.length}</span><div>{pageNumber>1&&<a class="a-button" href={pageLink(pageNumber-1)}>Previous</a>}{pageNumber<pageCount&&<a class="a-button" href={pageLink(pageNumber+1)}>Next</a>}</div></nav></>:<p class="a-empty">{snapshot?'No pages match these filters.':'No page measurements are saved yet.'}</p>}
 </section>
 <SeoContentPerformance evidence={evidence}/>
</section>
<style>
 .analysis-dashboard :is(h2,h3),.analysis-change strong,.traffic-period strong{font-family:var(--font-display),sans-serif;font-weight:800;letter-spacing:-.025em}.analysis-table thead th{font-family:var(--font-mono),sans-serif;font-weight:400;font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:var(--muted)} .analysis-dashboard{margin:28px 0 36px;min-width:0}.analysis-overview{display:grid;grid-template-columns:minmax(230px,.8fr) minmax(0,2fr);border:1px solid var(--line);border-radius:14px;overflow:hidden}.analysis-score{background:var(--pn);padding:26px;text-align:center;border-right:1px solid var(--line)}.analysis-gauge{display:block;width:min(100%,280px);margin:20px auto 0}.gauge-track,.gauge-value{fill:none;stroke:var(--line);stroke-width:9;stroke-linecap:round}.gauge-value{stroke:var(--tealt)}.gauge-number{font-family:var(--font-display),sans-serif;font-size:43px;font-weight:800;fill:var(--ink);font-variant-numeric:tabular-nums}.gauge-unit,.gauge-tick,.chart-label{font-family:var(--font-mono),monospace;fill:var(--muted);font-size:9px;letter-spacing:.06em}.gauge-tick{font-size:10px}.analysis-change{display:grid;gap:5px;margin:10px 0 18px}.analysis-change strong{font-size:20px}.analysis-change span{font-size:13px;color:var(--muted)}.analysis-history{margin:0;padding:26px;min-width:0}.analysis-chart-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;flex-wrap:wrap}.analysis-chart-head h2,.analysis-traffic h2,.analysis-pages h2,.analysis-anomaly h2{margin:0;font-size:21px}.analysis-chart-head p{margin:5px 0}.analysis-history svg{display:block;width:100%;margin-top:12px;overflow:visible}.chart-guide{stroke:var(--line);stroke-width:1}.chart-line{fill:none;stroke:var(--tealt);stroke-width:3;stroke-linejoin:round}.chart-dot{fill:var(--ink);stroke:var(--bg);stroke-width:2}.chart-label{font-size:11px;letter-spacing:0}.analysis-method{max-width:78ch;line-height:1.7}.analysis-empty-chart{min-height:215px;display:flex;flex-direction:column;justify-content:center;border-bottom:1px solid var(--line);margin-bottom:16px;max-width:64ch}.analysis-empty-chart p{color:var(--muted)}.analysis-categories{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-bottom:1px solid var(--line);margin-top:16px;padding:8px 0 24px;gap:22px}.category-gauge{display:flex;align-items:center;gap:16px;min-width:0}.category-gauge svg{width:112px;flex:0 0 112px}.category-gauge .gauge-number{font-size:38px}.category-gauge h3{font-size:16px;margin:0}.category-gauge p{line-height:1.6;margin:7px 0 0}.analysis-anomaly{display:grid;grid-template-columns:1fr 2fr;gap:28px;padding:28px 0;border-bottom:1px solid var(--line)}.analysis-anomaly p{margin-top:5px;line-height:1.7}.analysis-traffic,.analysis-pages{padding-top:28px}.traffic-comparisons{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 36px;margin-top:24px}.traffic-comparison{border-top:1px solid var(--line);padding:18px 0}.traffic-label{display:flex;justify-content:space-between;gap:12px;align-items:baseline;flex-wrap:wrap}.traffic-label h3{margin:0;font-size:16px}.traffic-bars{display:grid;gap:10px;margin:18px 0}.traffic-period{display:grid;grid-template-columns:64px minmax(40px,1fr) 100px;gap:10px;align-items:center}.traffic-period strong{text-align:right;font-size:14px;font-variant-numeric:tabular-nums}.traffic-period svg{display:block;width:100%}.traffic-track{fill:var(--line)}.traffic-bar{fill:var(--muted)}.traffic-current{fill:var(--tealt)}.traffic-comparison summary{cursor:pointer}.analysis-filters{display:flex;gap:14px;align-items:end;flex-wrap:wrap;margin:22px 0}.analysis-filters label:first-of-type{flex:1 1 220px}.analysis-filters label{flex:0 1 190px}.analysis-table{width:100%;overflow:auto;border-top:1px solid var(--line)}.analysis-table table{width:100%;border-collapse:collapse;font-size:14px}.analysis-table th,.analysis-table td{text-align:left;vertical-align:top;padding:14px 12px;border-bottom:1px solid var(--line)}.analysis-table th[scope=row]{font-weight:500;min-width:220px;max-width:420px;overflow-wrap:anywhere}.analysis-table th small{display:block;color:var(--muted);font-size:12px;margin-top:5px}.analysis-table .numeric{font-variant-numeric:tabular-nums;white-space:nowrap}.analysis-table td:last-child{min-width:130px}.analysis-pagination{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:18px}.analysis-pagination div{display:flex;gap:10px}@media(max-width:1200px){.analysis-categories{gap:14px}.category-gauge{display:block;text-align:center}.category-gauge svg{width:120px;display:block;margin:auto}.traffic-comparisons{grid-template-columns:1fr}}@media(max-width:760px){.analysis-overview{grid-template-columns:1fr}.analysis-score{border-right:0;border-bottom:1px solid var(--line);padding:22px}.analysis-gauge{width:230px;margin-top:12px}.analysis-history{padding:22px}.analysis-categories{grid-template-columns:1fr;gap:8px;padding-bottom:20px}.category-gauge{display:flex;text-align:left;padding:8px 0;gap:20px}.category-gauge svg{margin:0;width:105px;flex-basis:105px}.analysis-anomaly{grid-template-columns:1fr;gap:12px}.analysis-filters label{flex:1 1 160px}.analysis-filters button{width:100%}.traffic-period{grid-template-columns:56px minmax(35px,1fr) 82px;gap:8px}.traffic-period strong{font-size:13px}.analysis-table table{min-width:740px}.analysis-pagination{align-items:flex-start;flex-wrap:wrap}}
</style>
