---
import { Image } from 'astro:assets';
import laptop from '../assets/devices/laptop-space-black.png';
import tablet from '../assets/devices/tablet-space-black.png';
import tabletLandscape from '../assets/devices/tablet-landscape-space-black.png';
import phone from '../assets/devices/phone-black-titanium.png';
import monitor from '../assets/devices/monitor-dark.png';
import Img from './Img.astro';
interface Props {
  device?: 'laptop' | 'tablet' | 'tablet-landscape' | 'phone' | 'monitor';
  asset: string;
  title: string;
  loading?: 'eager' | 'lazy';
  sizes?: string;
  position?: string;
  fit?: 'cover' | 'contain';
}
const { device = 'monitor', asset, title, loading = 'lazy', sizes = '90vw', position = 'top center', fit = 'cover' } = Astro.props;
// Native screen apertures belong to the hardware, never its consuming layout.
const frames = {
  laptop: { image: laptop, x: 400, y: 300, w: 3456, h: 2234, radius: '1.1%' },
  tablet: { image: tablet, x: 99, y: 100, w: 1668, h: 2420, radius: '3%' },
  'tablet-landscape': { image: tabletLandscape, x: 100, y: 99, w: 2420, h: 1668, radius: '3%' },
  phone: { image: phone, x: 102, y: 100, w: 1206, h: 2622, radius: '10.5% / 4.8%' },
  monitor: { image: monitor, x: 200, y: 200, w: 5120, h: 2880, radius: '0' },
};
const frame = frames[device];
const { width, height } = frame.image;
---
<div class:list={['hardware-device', `hardware-device--${device}`]} data-device-frame={device} style={`aspect-ratio:${width}/${height};--screen-x:${frame.x / width * 100}%;--screen-y:${frame.y / height * 100}%;--screen-w:${frame.w / width * 100}%;--screen-h:${frame.h / height * 100}%;--screen-radius:${frame.radius};--screen-position:${position};--screen-fit:${fit}`}>
  <div class="hardware-device__screen"><Img k={asset} alt={title} loading={loading} sizes={sizes} widths={[280,480,768,1100,1440,1920,2560,2880]} quality={95} /></div>
  <Image class="hardware-device__hardware" src={frame.image} alt="" aria-hidden="true" loading={loading} format="webp" quality={95} widths={[480,768,1100,1536,2048,2880].filter(w => w <= width)} sizes={sizes} />
</div>
<style>
.hardware-device{position:relative;isolation:isolate;width:100%;max-width:none;padding:0;border:0;border-radius:0;line-height:0}
.hardware-device__screen{position:absolute;left:var(--screen-x);top:var(--screen-y);width:var(--screen-w);height:var(--screen-h);border-radius:var(--screen-radius);overflow:hidden;background:#111}
.hardware-device .hardware-device__screen :global(picture),.hardware-device .hardware-device__screen :global(img){display:block;width:100%;height:100%;max-height:none;margin:0;aspect-ratio:auto;object-fit:var(--screen-fit);object-position:var(--screen-position);border:0;border-radius:0;box-shadow:none;padding:0;mask-image:none;mix-blend-mode:normal;transform:none;filter:none}
.hardware-device.hardware-device :global(img.hardware-device__hardware){position:absolute;inset:0;z-index:1;display:block;width:100%;height:100%;max-height:none;margin:0;aspect-ratio:auto;object-fit:contain;border:0;border-radius:0;box-shadow:none;padding:0;mask-image:none;mix-blend-mode:normal;transform:none;filter:none;pointer-events:none}
</style>
