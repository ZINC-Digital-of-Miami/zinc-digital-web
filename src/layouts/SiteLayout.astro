---
// SiteLayout.astro — one shell for every route (home included).
// Head: title, description, canonical, OG/Twitter, JSON-LD — all server-rendered.
// Body: header with theme toggle, mobile nav row, <slot/>, CTA band, footer,
// then the shell script (theme, cursor, grain, progress, reveal, pins, magnetic).
import Img from '../components/Img.astro';
import LaneFooter from '../components/LaneFooter.astro';
import { workLanes } from '../data/work-lanes';
import {analyticsEnabled, googleTagScript} from '../lib/analytics';
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { articleImages } from '../data/article-images';
import { articleEditorial } from '../data/article-editorial';
import { pillarFor } from '../data/blog-strategy';
import { authors, authorFor, authorPath } from '../data/authors';
import '../styles/tokens.css';
import '../styles/themes.css';
import '../styles/site.css';
import '../styles/studio.css';
import { SITE, PHONE, SMS, PHONE_LABEL, EMAIL, SOCIAL, STUDIOS, ADMIN_PATH, asset, describe, ogKind, svcBy, caseBy, excerpt, noindexPaths, type Route } from '../data/site';

interface Props { route: Route }
const { route } = Astro.props;
const analytics = analyticsEnabled(import.meta.env.PUBLIC_ANALYTICS, import.meta.env.VERCEL_ENV);
if (analytics && Astro.csp) {
  Astro.csp.insertDirective("connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.google.com https://*.g.doubleclick.net https://pagead2.googlesyndication.com https://www.googleadservices.com https://ad.doubleclick.net");
  Astro.csp.insertDirective("img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://*.google.com https://*.g.doubleclick.net https://pagead2.googlesyndication.com https://www.googleadservices.com");
  Astro.csp.insertDirective("frame-src https://www.googletagmanager.com");
}
const {posts}=await (await import('../lib/content')).loadPublished();
const t = route.template;
const path = route.path;
const title = (route.metaTitle || route.title) + ' | ZINC';
const desc = route.metaDescription || (route.template==='article'?excerpt(posts.find(p=>p.slug===route.slug)!,155):describe(route));
const canonical = SITE + path;
const articleImage = t === 'article' ? articleImages[route.slug!] : undefined;
const imageFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/articles/*.{png,jpg,jpeg,webp}', { eager: true });
const imageFile = articleImage ? imageFiles['../assets' + asset(articleImage.asset).src]?.default : undefined;
const heroArtwork = articleImage || (t === 'blog' && posts[0] ? articleImages[posts[0].slug] : undefined);
const laneImages = import.meta.glob<{ default: ImageMetadata }>('../assets/lanes/*-hero.png', { eager: true });
const laneHero = t === 'home' || t === 'work' ? laneImages['../assets/lanes/' + (t === 'home' ? 'build' : (route.layer || 'Build').toLowerCase()) + '-hero.png']?.default : undefined;
const heroFile = laneHero || (heroArtwork ? imageFiles['../assets' + asset(heroArtwork.asset).src]?.default : undefined);
const heroPreload = heroFile ? await getImage({ src: heroFile, widths: laneHero ? [480, 768, 1100, 1536] : [480, 720, 960, 1280, heroFile.width].filter(width => width <= heroFile.width), format: 'avif', ...(laneHero ? {quality:88} : {}) }) : undefined;
const heroSizes = laneHero ? '(max-width: 700px) 100vw, 75vw' : '(max-width: 900px) 90vw, ' + (t === 'blog' ? '600px' : '1100px');
const socialImage = imageFile ? await getImage({ src: imageFile, width: 1200, height: 630, fit: 'cover', format: 'webp', quality: 82 }) : undefined;
const ogImg = SITE + (socialImage?.src || '/og/' + ogKind(route) + '.png');
const socialAlt = articleImage?.alt || 'ZINC Digital — ' + route.title;
const noindex = route.noindex || noindexPaths.has(path);
const wordmark = asset('wordmark-black');

// ---- JSON-LD ----
const ORG = { '@type': 'Organization', '@id': SITE + '/#org', name: 'ZINC Digital', url: SITE + '/', logo: SITE + wordmark.src, email: EMAIL, telephone: PHONE, sameAs: SOCIAL.map(([, u]) => u) };
const loc = (s: (typeof STUDIOS)[number]) => ({ '@type': 'ProfessionalService', '@id': SITE + '/#' + s.id, name: 'ZINC Digital — ' + s.name.replace(' satellite', ''), parentOrganization: { '@id': SITE + '/#org' }, url: SITE + '/', telephone: PHONE, image: ogImg, address: { '@type': 'PostalAddress', streetAddress: s.street, addressLocality: s.city, addressRegion: 'FL', postalCode: s.zip, addressCountry: 'US' } });
const seg = path.split('/').filter(Boolean);
const names: Record<string, string> = { services: 'Services', work: 'Work', blog: 'Articles', about: 'About', authors: 'Authors', contact: 'Contact', privacy: 'Privacy', terms: 'Terms', thanks: 'Thanks' };
const crumbs = [{ name: 'Home', url: SITE + '/' }, ...seg.flatMap((s, i) => t === 'author' && i === 0 ? [] : [{ name: i === seg.length - 1 && i > 0 ? route.title : names[s] || route.title, url: SITE + '/' + seg.slice(0, i + 1).join('/') + '/' }])];
const graph: unknown[] = [ORG, ...STUDIOS.map(loc), { '@type': 'WebSite', '@id': SITE + '/#site', url: SITE + '/', name: 'ZINC Digital', publisher: { '@id': SITE + '/#org' } }, { '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })) }];
const personNode = (author: typeof authors[number]) => ({ '@type':'Person', '@id':SITE+authorPath(author.id)+'#person', name:author.schemaName, ...(author.suffix?{honorificSuffix:author.suffix}:{}), url:SITE+authorPath(author.id), jobTitle:author.role, description:author.bio, image:SITE+asset(author.photo).src, worksFor:{'@id':SITE+'/#org'} });
if (t === 'article') {
  const p = posts.find(x=>x.slug===route.slug)!;
  const author = authorFor(p.author.name);
  const byline = author ? personNode(author) : {'@type':p.author.name==='Team ZINC'?'Organization':'Person', name:p.author.name, ...(p.author.name==='Team ZINC'?{url:SITE+'/about/'}:{})};
  const stamp = (value:string) => /Z$|[+-]\d\d:\d\d$/.test(value)?value:value+'Z';
  graph.push({'@type':'Article', '@id':canonical+'#article', headline:p.title, description:desc, datePublished:stamp(p.dateGmt), dateModified:stamp(p.modifiedGmt), image:ogImg, keywords:articleEditorial[p.slug]?.keywords, articleSection:pillarFor(p.slug)?.title, author:byline, publisher:{'@id':SITE+'/#org'}, mainEntityOfPage:canonical});
}
if (t === 'author') {
  const author = authors.find(a=>a.id===route.slug)!;
  const person = personNode(author);
  graph.push(person, {'@type':'ProfilePage', '@id':canonical+'#profile', url:canonical, name:author.name, mainEntity:{'@id':person['@id']}});
}
if (t === 'service') { const s = svcBy(route.slug!); graph.push({ '@type': 'Service', name: s.title, serviceType: s.title, description: s.line, provider: { '@id': SITE + '/#org' }, areaServed: 'US', url: canonical }, { '@type': 'FAQPage', mainEntity: s.questions.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }); }
if (t === 'case') { const c = caseBy(route.slug!); graph.push({ '@type': 'CreativeWork', name: c.title + ' — case study', description: c.line, url: canonical, creator: { '@id': SITE + '/#org' }, about: c.application ? { '@type': 'SoftwareApplication', name: c.title, applicationCategory: 'BusinessApplication', operatingSystem: 'Web' } : { '@type': 'Organization', name: c.title, url: c.url } }); }
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });

const navOn = (k: string) => ({ work: t === 'work' || t === 'case', services: t === 'services' || t === 'service', about: t === 'about', blog: t === 'blog' || t === 'article' || t === 'author' } as Record<string, boolean>)[k] ? 'nlink on' : 'nlink';
const showCta = t !== 'work' && t !== 'home' && t !== 'contact' && t !== 'thanks';
---
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta property="og:site_name" content="ZINC Digital" />
    <meta property="og:title" content={route.metaTitle || route.title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={t === 'article' ? 'article' : 'website'} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:image:alt" content={socialAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={route.metaTitle || route.title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImg} />
    <meta name="twitter:image:alt" content={socialAlt} />
    <meta name="theme-color" content="#F5F6F7" />
    {heroPreload && <link rel="preload" as="image" type="image/avif" href={heroPreload.src} imagesrcset={heroPreload.srcSet.attribute} imagesizes={heroSizes} fetchpriority="high" />}
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />
    <script is:inline>
      // Design default is light; only a stored choice switches to dark (no OS-preference drift).
      (function(){document.documentElement.classList.add('js');try{var t=localStorage.getItem('zinc-theme');if(t==='dark')document.documentElement.setAttribute('data-theme','dark');}catch(e){}})();
    </script>
    <script type="application/ld+json" set:html={ld} />
    {analytics && <>
      <script is:inline set:html={googleTagScript(import.meta.env.PUBLIC_ADS_CONVERSION_LABEL)} />
    </>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="zs-grain" aria-hidden="true"></div>
    <div class="zs-cur" id="zsCur" aria-hidden="true"></div>
    {/* #zsRoot scopes the Design's inner-page rules in site.css; its homepage has no such root. */}
    <div class="zb" id={t === 'home' ? undefined : 'zsRoot'} data-layer={route.layer || ''} data-template={t}>
      <header class="nav">
        <div class="wrap nav-in">
          <i class="sprog" id="zsProg" aria-hidden="true"></i>
          <a class="nav-logo" href="/" aria-label="ZINC home"><span class="wl-shell-wordmark">ZINC<i>.</i></span></a>
          <nav class="nlinks" aria-label="Main navigation">
            <a class={navOn('work')} href="/work/" aria-current={t === 'work' ? 'page' : undefined}>Work</a>
            <a class={navOn('services')} href="/services/" aria-current={t === 'services' ? 'page' : undefined}>Services</a>
            <a class={navOn('about')} href="/about/" aria-current={t === 'about' ? 'page' : undefined}>About</a>
            <a class={navOn('blog')} href="/blog/" aria-current={t === 'blog' ? 'page' : undefined}>Articles</a>
          </nav>
          <button type="button" class="theme-t" id="themeToggle" aria-label="Switch between light and dark"><span class="ic"></span><span data-theme-label>Dark mode</span></button>
          <a class="btn fill" href="/contact/" style="min-height:44px;padding:0 18px">Start an inquiry</a>
          <button type="button" class="menu-toggle" id="mobileMenuToggle" aria-haspopup="dialog" aria-controls="mobileMenu" aria-expanded="false"><span>Menu</span><span class="menu-glyph" aria-hidden="true"><i></i><i></i></span></button>
        </div>
      </header>
      <nav class="mnav" aria-label="Main navigation (mobile)">
        <a class={navOn('work')} href="/work/">Work</a>
        <a class={navOn('services')} href="/services/">Services</a>
        <a class={navOn('about')} href="/about/">About</a>
        <a class={navOn('blog')} href="/blog/">Articles</a>
        <a href="/contact/">Contact</a>
      </nav>
      <dialog class="mobile-menu" id="mobileMenu" aria-labelledby="mobileMenuTitle">
        <div class="menu-background" aria-hidden="true"><img src={wordmark.src} alt="" width={wordmark.width} height={wordmark.height} /></div>
        <div class="menu-head"><a href="/" aria-label="ZINC home"><img src={wordmark.src} alt="ZINC" width={wordmark.width} height={wordmark.height} /></a><button type="button" class="menu-close" data-menu-close aria-label="Close navigation" autofocus><span aria-hidden="true"></span></button></div>
        <div class="menu-body"><h2 class="menu-title" id="mobileMenuTitle">Explore ZINC</h2><nav class="menu-links" aria-label="Mobile navigation">{[['Work','/work/'],['Services','/services/'],['About','/about/'],['Articles','/blog/'],['Contact','/contact/']].map(([name, href], i) => <a href={href} class:list={{on: path.startsWith(href)}} aria-current={path === href ? 'page' : undefined} style={'--menu-order:' + i}><span>{name}</span><span class="menu-arrow" aria-hidden="true">↗</span></a>)}</nav></div>
        <div class="menu-foot"><span>Build. Demand. Intelligence.</span><a href={SMS}>Text {PHONE_LABEL} <span aria-hidden="true">↗</span></a></div>
      </dialog>

      <main id="main"><slot /></main>

      {showCta && (
        <section class="band cta">
          <div class="sph" data-par="0.06" style="width:520px;height:520px;left:-140px;top:-80px;animation:float2 12s ease-in-out infinite"></div>
          <div class="wrap cta-grid">
            <div>
              <span class="kick rv"><span class="mdot"></span> Work with ZINC</span>
              <h2 class="disp cta-h rv" style="margin-top:18px">Start an <span class="hit">inquiry.</span></h2>
              <div class="p-related rv" style="margin-top:36px"><a class="btn fill" href="/contact/">Open the form</a><a class="btn ghost" href={SMS}>Text {PHONE_LABEL}</a></div>
            </div>
            <div class="rv" style="width:clamp(160px,18vw,260px);aspect-ratio:1"><div class="badge"><div class="bring2"></div><Img k="zinc-badge" class="bimg" alt="" sizes="260px" /><div class="bring"></div><div class="borbit"><div class="bdot"></div></div></div></div>
          </div>
        </section>
      )}

      <LaneFooter next={t === 'work' ? workLanes[route.layer || 'Build'].next : 'Build'} label={t === 'work' ? 'Next:' : 'Explore:'} />
      <footer class="foot">
        {t !== 'thanks' && t !== 'work' && <div class="mq" aria-hidden="true"><div class="mqtrack" style="animation-duration:30s"><span class="mqi">Start an inquiry <span class="o">or text {PHONE_LABEL}</span> <span class="d">·</span></span><span class="mqi">Start an inquiry <span class="o">or text {PHONE_LABEL}</span> <span class="d">·</span></span></div></div>}
        <div class="wrap">
          {t === 'home' && <div class="fbig rv" aria-hidden="true"><span>Build.</span><span>Demand.</span><span>Intelligence.</span></div>}
          <div class="fgrid">
            {STUDIOS.map((s) => <div><h2>{s.name}</h2><div class="fmeta">{('streetLabel' in s && s.streetLabel) || s.street}<br />{s.city}, FL {s.zip}</div></div>)}
            <div><h2>Contact</h2><div class="fmeta"><a href={'mailto:' + EMAIL} style="text-decoration:underline;text-decoration-color:var(--line)">{EMAIL}</a><br /><a href={SMS}>Text {PHONE_LABEL} ↗</a></div><div class="socs">{SOCIAL.map(([n, u]) => <a href={u} rel="noopener">{n} ↗</a>)}</div></div>
          </div>
          <div class="fbot">
            <a href="/" aria-label="ZINC home"><img src={wordmark.src} alt="ZINC" width={wordmark.width} height={wordmark.height} loading="lazy" /></a>
            <span>© 2026 ZINC Digital · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a>{ADMIN_PATH && <> · <a href={ADMIN_PATH}>Admin</a></>}</span>
            <span><span class="mdot" style="margin-right:10px"></span>Coded in Miami. With cafecitos.</span>
          </div>
        </div>
      </footer>
    </div>

    <script>
      import { initShell } from '../scripts/shell';
      initShell();
    </script>
  </body>
</html>
