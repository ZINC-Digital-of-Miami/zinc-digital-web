---
import PreviewLayout from '../layouts/PreviewLayout.astro';
import MockupPage from '../components/MockupPage.astro';
import { activeRoutes, type Route } from '../data/mockup';
export function getStaticPaths() {
  return activeRoutes.map(route => ({params:{path:route.path==='/'?undefined:route.path.replace(/^\/|\/$/g,'')},props:{route}}));
}
interface Props {route:Route}
const {route}=Astro.props;
---
<PreviewLayout title={route.title+' | ZINC'}>
  <MockupPage route={route} />
</PreviewLayout>
