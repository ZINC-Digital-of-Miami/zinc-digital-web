---
import Img from './Img.astro';
import BeforeAfter from './BeforeAfter.astro';
import CasePresentations from './CasePresentations.astro';
import { caseBy } from '../data/site';
interface Props { imageLinks: Record<string,string>; }
const { imageLinks }=Astro.props;
const study=caseBy('once-upon-a-book-club');
const screens=[
  {key:'ouabc-bi-demand-current',title:'Plan around demand.',copy:'The demand calendar puts seasonal search interest beside the products and content being planned.'},
  {key:'ouabc-bi-funnel-current',title:'See where visits stop.',copy:'The store’s funnel follows visits into carts, checkout and purchase, with the source and reporting window kept visible.'},
  {key:'ouabc-bi-ads-current',title:'Read each channel on its own terms.',copy:'Advertising views keep platform-attributed purchases distinct from the store’s order record.'},
];
const moreScreens=[['ouabc-bi-products-current','Seasonal product records'],['ouabc-bi-season-current','Season outlook'],['ouabc-bi-bookmark-current','Guided walkthrough'],['ouabc-bi-work-current','Dated work and content'],['ouabc-bi-meetings-current','Meeting records'],['ouabc-bi-admin-current','Record correction'],['ouabc-bi-creative-wip','Creative analysis · design package'],['ouabc-bi-checkout-wip','Checkout behavior · design package'],['ouabc-bi-market-context-wip','Market context · design package']];
---
<article class="ou-case">
  <header class="ou-hero wrap">
    <div><span class="kick">ZINC / Once Upon a Book Club</span><h1 class="disp">A rebuilt store.<br/>Books, boxes<br/>&amp; book lovers.</h1><p class="ou-lede">We rebuilt Once Upon a Book Club’s Shopify website. We manage its SEO, blogs, Google Shopping, Meta and TikTok ads. Now we’re building a BI app to make the reporting more useful.</p><a class="arrow" href="#website">Explore the website rebuild ↓</a></div>
    <figure class="ou-hero-image"><div class="ou-frame-label lab">Once Upon a Book Club / Shopify rebuild</div><Img k="ouabc-website-after" alt="Rebuilt Once Upon a Book Club Shopify storefront, June 2025 archive" loading="eager" fetchpriority="high" sizes="(max-width: 900px) 90vw, 60vw" /><figcaption class="lab">Books, page-numbered gifts and a store that changes with every release.</figcaption></figure>
  </header>
  <nav class="ou-jump wrap" aria-label="Case study sections"><a href="#website">Website rebuild</a><a href="#campaigns">Paid campaigns</a><a href="#search-content">SEO &amp; content</a><a href="#reporting">BI app · In progress</a></nav>
  <section class="ou-section wrap" id="website" aria-labelledby="ouWebsiteTitle">
    <div class="ou-section-head rv"><div><span class="kick">Build / Shopify</span><h2 class="disp" id="ouWebsiteTitle">A new home for<br/>the reading experience.</h2></div><p>Once Upon a Book Club pairs books with wrapped gifts, opened at specific pages in the story. The website has to explain that experience while helping readers find subscriptions, one-time boxes and bookish gifts.</p></div>
    <BeforeAfter before="ouabc-website-before" after="ouabc-website-after" />
    <div class="ou-store-links"><a class="arrow" href={imageLinks['ouabc-site']} target="_blank" rel="noopener noreferrer">View current desktop storefront ↗</a><a class="arrow" href={imageLinks['ouabc-mobile']} target="_blank" rel="noopener noreferrer">View current mobile storefront ↗</a></div>
    <div class="ou-notes rv-stag"><div><h3>Storefront rebuilt.</h3><p>A revised header, product-led homepage and clearer Book Boxes and Books &amp; Products navigation.</p></div><div><h3>Built for changing releases.</h3><p>Subscriptions, limited editions and pre-orders share the store with the growing boutique collection.</p></div><div><h3>Work continues after launch.</h3><p>We maintain product and collection content, search metadata and publication checks as the catalog changes.</p></div></div>
  </section>
  <section class="ou-campaigns" id="campaigns" aria-label="Paid campaigns"><CasePresentations slug={study.slug} /></section>
  <section class="ou-section wrap ou-search" id="search-content" aria-labelledby="ouSearchTitle">
    <div class="rv"><span class="kick">Demand / Ongoing management</span><h2 class="disp" id="ouSearchTitle">Make each release<br/>easier to find.</h2><p class="ou-body">The work connects what readers search for with the boxes available to buy—and the articles, product pages and campaigns that introduce them.</p><dl class="ou-service-list"><div><dt>SEO &amp; blogs</dt><dd>Search research, article briefs, writing, client review and publication. Product and collection titles and descriptions are kept current.</dd></div><div><dt>Google Shopping</dt><dd>Product groups, performance and availability reviewed together, with sold-out stock distinguished from feed and publication problems.</dd></div><div><dt>Technical upkeep</dt><dd>Crawl traps from tracking paths, recommendation parameters and repeated locale URLs repaired.</dd></div></dl></div>
    <figure class="ou-proof rv"><Img k="ouabc-research-private-preview" alt="Redacted Once Upon a Book Club research report preview; confidential content removed" sizes="(max-width: 900px) 90vw, 48vw" /><figcaption><span class="lab">Research supporting the next decisions</span><p>Product and channel research inform the ongoing work. This edited preview conceals the report’s findings and confidential details.</p><span class="lab ou-privacy-note">Redacted portfolio preview</span></figcaption></figure>
  </section>
  <section class="ou-bi" id="reporting" aria-labelledby="ouBiTitle"><div class="wrap">
    <div class="ou-section-head rv"><div><span class="kick">Intelligence / BI app in development</span><h2 class="disp" id="ouBiTitle">Two months invested.<br/>Before they asked.</h2></div><div><p>We took the initiative to build a business-intelligence app for Once Upon a Book Club, investing two months beyond the work they had requested. The aim: better reporting and better-informed decisions.</p><p class="ou-muted">The app is still in development. These screens show the work in progress, with private client figures removed.</p></div></div>
    <div class="ou-bi-screens">{screens.map(screen=><figure class="ou-bi-feature rv"><a href={imageLinks[screen.key]} target="_blank" rel="noopener noreferrer" aria-label={'Open full image: '+screen.title}><Img k={screen.key} alt={screen.title+' Once Upon a Book Club BI app in development; private figures removed.'} sizes="(max-width: 900px) 90vw, 1200px" /></a><figcaption><h3>{screen.title}</h3><p>{screen.copy}</p><a class="arrow" href={imageLinks[screen.key]} target="_blank" rel="noopener noreferrer">Open full image ↗</a></figcaption></figure>)}</div>
    <details class="ou-more"><summary>Explore more of the BI app <span aria-hidden="true">+</span></summary><div class="ou-more-grid">{moreScreens.map(([key,title])=><figure><a href={imageLinks[key]} target="_blank" rel="noopener noreferrer" aria-label={'Open full image: '+title}><Img k={key} alt={title+' · BI app in development; private figures removed'} sizes="(max-width: 700px) 90vw, 45vw" /></a><figcaption>{title}</figcaption></figure>)}</div></details>
  </div></section>
  <section class="ou-section wrap ou-close"><div class="rv"><span class="kick">An ongoing engagement</span><h2 class="disp">The work keeps moving<br/>with the catalog.</h2><p class="ou-body">A rebuilt website, ongoing search and paid-channel management, monthly reporting and an app being developed to connect the next decisions.</p><a class="arrow" href={study.url} target="_blank" rel="noopener noreferrer">Visit Once Upon a Book Club ↗</a></div><a class="ou-next rv" href="/work/us-oil-solutions/"><span class="lab">Next case / U.S. Oil Solutions</span><strong class="disp">Website &amp;<br/>operations app.</strong><span aria-hidden="true">↗</span></a></section>
</article>
<style>
.ou-store-links{display:flex;gap:12px 28px;flex-wrap:wrap;margin-top:12px}.ou-case{overflow:clip}.ou-case [id]{scroll-margin-top:110px}.ou-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:clamp(28px,4vw,64px);align-items:center;padding-top:clamp(48px,7vw,100px);padding-bottom:56px}.ou-hero h1{font-size:clamp(54px,6.8vw,106px);line-height:.98;margin:22px 0}.ou-lede,.ou-body{font-size:19px;line-height:1.65;max-width:52ch}.ou-hero-image{margin:0;border:1px solid var(--line);border-radius:16px;background:var(--pn);overflow:hidden;box-shadow:0 20px 50px rgb(0 0 0 / .08)}.ou-frame-label{padding:16px;border-bottom:1px solid var(--line);font-size:11px}.ou-hero-image :global(img){display:block;width:100%;height:auto}.ou-hero-image figcaption{padding:16px;font-size:11px;line-height:1.6}.ou-jump{display:flex;gap:12px 28px;flex-wrap:wrap;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding-top:12px;padding-bottom:12px}.ou-jump a{display:flex;align-items:center;min-height:44px;font:12px var(--fm);color:var(--ink)}.ou-jump a:hover{color:var(--tealt)}.ou-section{padding-top:clamp(56px,7vw,96px);padding-bottom:clamp(56px,7vw,96px)}.ou-section-head{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:32px;align-items:end}.ou-case h2{font-size:clamp(38px,4.6vw,68px);line-height:1.04;margin:16px 0 0}.ou-section-head p{font-size:18px;line-height:1.65;margin:0;max-width:55ch}.ou-section-head p+p{margin-top:16px}.ou-notes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;margin-top:32px}.ou-notes>div{border-top:2px solid var(--ink);padding-top:20px}.ou-case h3{font-size:23px;line-height:1.3;margin:0 0 12px}.ou-notes p{font-size:16px;line-height:1.65;margin:0;color:var(--muted)}.ou-search{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(28px,5vw,72px);align-items:center}.ou-service-list{margin:28px 0 0}.ou-service-list>div{border-top:1px solid var(--line);padding:18px 0}.ou-service-list dt{font-size:17px;font-weight:600}.ou-service-list dd{font-size:16px;line-height:1.65;color:var(--muted);margin:8px 0 0}.ou-proof{margin:0;background:var(--bg2);border:1px solid var(--line);border-radius:16px;overflow:hidden}.ou-proof :global(img){display:block;width:100%;height:auto}.ou-proof figcaption{padding:24px}.ou-proof p{font-size:17px;line-height:1.65}.ou-privacy-note{display:block;padding-top:16px;border-top:1px solid var(--line);font-size:11px;line-height:1.6}.ou-bi{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:clamp(56px,7vw,96px) 0;background:var(--bg2)}.ou-muted{color:var(--muted)}.ou-bi-screens{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;margin-top:40px}.ou-bi-feature{margin:0;min-width:0;border:1px solid var(--line);border-radius:16px;overflow:hidden;background:var(--bg)}.ou-bi-feature:first-child{grid-column:1/-1;display:grid;grid-template-columns:minmax(0,1.65fr) minmax(0,1fr);align-items:center}.ou-bi-feature>a{display:block;overflow:hidden}.ou-bi-feature :global(img){display:block;width:100%;height:auto}.ou-bi-feature figcaption{padding:24px}.ou-bi-feature p{font-size:16px;line-height:1.65;color:var(--muted);margin:0}.ou-more{margin-top:28px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.ou-more summary{padding:22px 0;cursor:pointer;font:16px var(--fm);min-height:60px;list-style:none;display:flex;justify-content:space-between;gap:20px}.ou-more summary::-webkit-details-marker{display:none}.ou-more[open] summary span{transform:rotate(45deg)}.ou-more-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;padding-bottom:28px}.ou-more-grid figure{margin:0;min-width:0}.ou-more-grid :global(img){width:100%;height:auto;border:1px solid var(--line);border-radius:10px;display:block}.ou-more-grid figcaption{font:12px/1.6 var(--fm);margin-top:12px}.ou-close{display:grid;grid-template-columns:1.3fr 1fr;gap:48px;align-items:center}.ou-next{display:grid;gap:20px;padding:32px;border:1px solid var(--line);border-radius:16px;background:var(--bg2);color:var(--ink)}.ou-next strong{font-size:clamp(36px,4vw,58px)}.ou-next>span:last-child{justify-self:end;font-size:28px}
@media(prefers-reduced-motion:no-preference){.ou-hero h1{animation:case-title-enter .85s cubic-bezier(.16,1,.3,1) both}.ou-hero-image{animation:case-screen-enter 1.1s cubic-bezier(.16,1,.3,1) both}.ou-bi-feature img,.ou-more-grid img{transition:transform .5s cubic-bezier(.16,1,.3,1)}.ou-bi-feature a:hover img,.ou-more-grid a:hover img{transform:scale(1.015)}}
@media(max-width:900px){.ou-hero,.ou-search{grid-template-columns:minmax(0,1fr)}.ou-hero{gap:28px}.ou-hero h1{font-size:clamp(52px,9vw,82px)}.ou-hero-image{max-width:780px}.ou-section-head{grid-template-columns:1fr;gap:22px}.ou-bi-feature:first-child{display:block}.ou-close{grid-template-columns:1fr}}
@media(max-width:600px){.ou-notes,.ou-bi-screens,.ou-more-grid{grid-template-columns:1fr}.ou-jump{gap:4px 18px}.ou-jump a{font-size:11px}.ou-lede,.ou-body{font-size:17px}.ou-section-head p{font-size:17px}.ou-bi-feature figcaption,.ou-proof figcaption{padding:20px}.ou-hero h1{font-size:clamp(45px,11.8vw,68px)}}
</style>
