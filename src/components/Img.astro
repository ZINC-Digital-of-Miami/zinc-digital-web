---
// Renders a site asset by key. Images kept under src/assets/ (case images, the brand badge) go through
// astro:assets and ship as responsive AVIF/WebP; every other asset is a dimensioned <img> from public/.
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { asset } from '../data/site';

interface Props {
  k: string;
  alt: string;
  class?: string;
  id?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  /** Height of an object-fit:cover box in vh. Its image renders wider than the viewport on tall screens, so sizes follows the height. */
  cover?: number;
}

const local = import.meta.glob<{ default: ImageMetadata }>('../assets/**/*.{png,jpg,jpeg,webp}', { eager: true });
const { k, alt, class: cls, id, loading = 'lazy', fetchpriority, sizes = '100vw', cover } = Astro.props;
const a = asset(k);
const file = local['../assets' + a.src]?.default;
const widths = file ? [...new Set([480, 960, 1440, 1920, file.width].filter((w) => w <= file.width))] : [];
// A cover box H vh tall shows the image at H vh × aspect wide, or 100vw once the screen is wider than that.
const coverWidth = cover && file ? Math.ceil((cover * file.width) / file.height) : 0;
const imgSizes = coverWidth ? `(min-aspect-ratio: ${coverWidth}/100) 100vw, ${coverWidth}vh` : sizes;
// A portrait phone only shows the centre of a wide cover image. A square crop retains the original
// image's full height and the same visible centre, while avoiding a download of the off-screen sides.
const croppedCover = file && cover && file.width > file.height;
const mobileCover = croppedCover ? await Promise.all(['avif', 'webp'].map(format => getImage({src:file,format,width:Math.min(file.height,1440),height:Math.min(file.height,1440),fit:'cover',position:'center'}))) : [];
const wideCover = croppedCover ? await Promise.all(['avif', 'webp'].map(format => getImage({src:file,format,widths,sizes:imgSizes}))) : [];
// getImage supplies lazy loading by default. Spread only dimensions so the explicit hero loading
// attribute is not duplicated (HTML parsers honor the first duplicate, leaving a hero lazy).
const wideDimensions = croppedCover ? {width:wideCover[1].attributes.width,height:wideCover[1].attributes.height} : {};
---
{croppedCover ? (
  <picture>
    {mobileCover.map(image => <source media="(max-width: 900px) and (max-aspect-ratio: 1/1)" type={'image/' + image.options.format} srcset={image.src} />)}
    <source type="image/avif" srcset={wideCover[0].srcSet.attribute} sizes={imgSizes} />
    <img {...wideDimensions} src={wideCover[1].src} srcset={wideCover[1].srcSet.attribute} sizes={imgSizes} alt={alt} class={cls} id={id} loading={loading} decoding="async" fetchpriority={fetchpriority} />
  </picture>
) : file ? (
  <Picture src={file} formats={['avif', 'webp']} fallbackFormat="webp" widths={widths} sizes={imgSizes} alt={alt} class={cls} id={id} loading={loading} decoding="async" fetchpriority={fetchpriority} />
) : (
  <img src={a.src} alt={alt} class={cls} id={id} width={a.width} height={a.height} loading={loading} decoding="async" fetchpriority={fetchpriority} />
)}
