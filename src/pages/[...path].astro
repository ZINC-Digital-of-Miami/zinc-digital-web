---
import SiteLayout from '../layouts/SiteLayout.astro';
import Page from '../components/Page.astro';
import { type Route } from '../data/site';
import {loadPublished} from '../lib/content';
// Home and Business Intelligence have dedicated page templates.
export async function getStaticPaths() {
  const {routes}=await loadPublished();
  return routes.filter((route) => route.template !== 'home' && !(route.template === 'service' && route.slug === 'business-intelligence')).map((route) => ({ params: { path: route.path.replace(/^\/|\/$/g, '') }, props: { route } }));
}
interface Props { route: Route }
const { route } = Astro.props;
---
<SiteLayout route={route}><Page route={route} /></SiteLayout>
