---
import DeviceFrame from './DeviceFrame.astro';
---
<div class="build-art" aria-label="Bear Claw product website, Andrew Neese real estate website and U.S. Oil Solutions website upgrade">
  <div class="build-laptop"><DeviceFrame device="laptop" asset="bear-claw-home-desktop" title="Bear Claw website built by ZINC" loading="eager" sizes="(max-width:600px) 80vw, 50vw" /></div>
  <div class="build-tablet"><DeviceFrame device="tablet" asset="andrew-original-website" title="Andrew Neese real estate website — original design" loading="eager" sizes="(max-width:600px) 40vw, 25vw" /></div>
  <div class="build-phone"><DeviceFrame device="phone" asset="uos-second-site-mobile" title="U.S. Oil Solutions website upgrade — mobile design in development" loading="eager" sizes="(max-width:600px) 20vw, 12vw" /></div>
</div>
<style>
.build-art{position:absolute;inset:0;z-index:-2;isolation:isolate}
.build-laptop,.build-tablet,.build-phone{position:absolute;filter:drop-shadow(0 24px 18px #0007)}
.build-laptop{width:49%;right:14%;top:29%}.build-tablet{right:3%;top:16%;width:23%}.build-phone{width:10%;right:26%;bottom:12%}
@media(max-width:600px){.build-laptop{width:70%;right:22%;top:auto;bottom:15%}.build-tablet{width:32%;right:4%;top:auto;bottom:20%}.build-phone{width:18%;right:30%;bottom:10%}}
</style>
