---
import { caseBy } from '../data/site';
import CaseStudyHero from './CaseStudyHero.astro';
import SmokyMountainScreens from './SmokyMountainScreens.astro';
import Img from './Img.astro';
import ApprovedImage from './ApprovedImage.astro';
import DeviceComposition from './DeviceComposition.astro';
import {websiteCases, type WebsiteCaseSlug} from '../data/website-cases';
interface Props {slug:WebsiteCaseSlug}
const {slug}=Astro.props;
const entry=websiteCases[slug];
const porsche=slug==='porsche-roanoke';
// Native captures shown in the shared device family; Smoky keeps its board until tablet and phone sources exist.
const onScreen: Partial<Record<WebsiteCaseSlug,{desktop:string;tablet:string;mobile:string;title:string}>> = {
  'fraim-cawley-company': {desktop:'case-fraim-services-desktop',tablet:'case-fraim-services-tablet',mobile:'case-fraim-services-mobile',title:'Fraim, Cawley & Company tax and business services page'},
  'porsche-roanoke': {desktop:'case-porsche-dealers-desktop',tablet:'case-porsche-usa-tablet',mobile:'case-porsche-dealers-mobile',title:'Illustrative presentation using porsche.com dealer search and home screens'},
};
const screens=onScreen[slug];
---
<article class="website-case" style={'--case-accent:'+entry.accent}>
  <CaseStudyHero study={caseBy(slug)} title={entry.name} description={entry.headline.replaceAll("\n", " ")} eyebrow={entry.eyebrow} href="#website" action="Explore the website work" caption={porsche ? "Illustrative device presentation" : "Website design · Across devices"} />

  {slug === 'smoky-mountain-survival' && <SmokyMountainScreens />}
  <section id="overview" class="overview wrap"><p class="kick">01 / The project</p><div class="overview-grid"><h2 class="disp">{entry.headline.split('\n').map(line=><span>{line}</span>)}</h2><div><p class="intro">{entry.intro}</p><p>{entry.description}</p><dl><div><dt>Client</dt><dd>{entry.name}</dd></div><div><dt>Scope</dt><dd>{porsche?'Dealer website · Official merchandise website':'Website'}</dd></div></dl></div></div></section>
  <section id="website" class="presentation" data-case-pages={slug}><div class="wrap"><div class="section-top"><p class="kick">02 / {porsche?'Portfolio presentation':'On screen'}</p><span>{slug === "andrew-neese" ? "Original desktop capture" : "Desktop / Tablet / Mobile"}</span></div><figure data-case-mockup={slug}>{slug === 'andrew-neese' ? <div class="original-website-scroll" tabindex="0" role="region" aria-label="Scroll the original Andrew Neese website capture"><Img k="andrew-original-website" alt="Original Andrew Neese website — complete page" sizes="(max-width:700px) 90vw, 631px" /></div> : screens ? <DeviceComposition title={screens.title} desktop={screens.desktop} tablet={screens.tablet} mobile={screens.mobile} /> : <ApprovedImage name={entry.image} alt={porsche?'Illustrative Porsche device presentation; not a capture of the Roanoke dealership websites':entry.name+' website presented across desktop and mobile devices'} sizes="90vw"/>}<figcaption>{porsche?'Illustrative device presentation. The Roanoke dealer and merchandise websites are the project scope described here.':entry.name+' / Website presentation'}</figcaption></figure></div></section>
  <section id="website-details" class="details wrap"><p class="kick">03 / {porsche?'Two websites, one dealership':'Website details'}</p><div class="detail-grid">{entry.details.map(([title,body],i)=><div><span class="number">0{i+1}</span><h2>{title}</h2><p>{body}</p></div>)}</div><div class="next"><a href="/work/" class="arrow">← All work</a><a href={'/work/'+caseBy(slug).next+'/'} class="arrow">Next case / {caseBy(caseBy(slug).next).title} ↗</a></div></section>
</article>
<style>
.website-case{background:#fff;color:#17191b;--ink:#17191b;--muted:#555;--line:#ccc}.website-hero{background:radial-gradient(ellipse at 95% 100%,#303438,transparent 55%),#090b0d;color:#fafaf7;padding:90px 0 80px}.hero-layout{display:grid;grid-template-columns:1.7fr 1fr;gap:60px;align-items:end}.website-hero .kick{color:#bbb}.website-hero h1{font-size:clamp(60px,7.7vw,124px);line-height:1.02;letter-spacing:-.05em;margin:28px 0 45px}.website-case h1 span,.website-case h2 span,.hero-line span{display:block}.website-hero a{color:#fff}.hero-note{border-top:2px solid var(--case-accent);padding-top:24px;padding-bottom:10px}.hero-note .hero-line{font-size:clamp(25px,3vw,44px);line-height:1.25;margin:25px 0;color:var(--case-accent)}.hero-note>p:last-child{font:12px/1.8 var(--fm);color:#ccc}.slash{padding:0 12px}.overview{padding-block:80px}.overview-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:60px}.overview h2{font-size:clamp(45px,5vw,76px);line-height:1.05;margin:22px 0}.overview p,.details p{font-size:17px;line-height:1.7;max-width:58ch}.overview .intro{font-size:24px;line-height:1.5}.website-case .kick{font:11px/1.5 var(--fm)}.overview dl{display:flex;flex-wrap:wrap;gap:25px;margin-top:30px;border-top:1px solid #ccc;padding-top:24px}.overview dt{font:11px var(--fm);margin-bottom:10px;color:#555}.overview dd{margin:0;font-size:15px}.presentation{padding:45px 0;background:#fff;border-block:1px solid #d5d5d5;scroll-margin-top:80px}.section-top{display:flex;flex-wrap:wrap;justify-content:space-between;gap:15px;align-items:center}.section-top>span{font:11px var(--fm);color:#555}.presentation figure{margin:20px 0 0}.presentation :global(img){display:block;width:100%;height:auto;max-height:720px;object-fit:contain}.presentation figcaption{font:11px/1.7 var(--fm);color:#5d5d5d;padding-top:25px;border-top:1px solid #ddd;margin-top:20px;max-width:85ch}.details{padding-block:70px}.detail-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin-top:35px}.number{font:11px var(--fm);color:#656565}.details h2{font-size:23px;font-weight:500;line-height:1.3}.next{display:flex;justify-content:space-between;gap:20px;border-top:1px solid #ccc;padding-top:30px;margin-top:60px}.website-case a:focus-visible{outline:3px solid #008a8e;outline-offset:5px}@media(max-width:800px){.hero-layout,.overview-grid,.detail-grid{grid-template-columns:1fr;gap:25px}.website-hero{padding:50px 0}.website-hero h1{font-size:clamp(52px,11vw,82px);overflow-wrap:break-word}.hero-note{margin-top:15px}.overview{padding-block:50px}.overview .intro{font-size:21px}.details{padding-block:50px}.detail-grid>div{border-top:1px solid #ccc;padding-top:22px}.next{font-size:13px}.presentation{padding-block:25px}}
.original-website-scroll{width:min(100%,631px);max-height:650px;overflow:auto;margin:30px auto;background:#fff;border:1px solid #d5d7da}.original-website-scroll :global(img){max-height:none;width:100%;height:auto}.original-website-scroll:focus-visible{outline:3px solid #008d91;outline-offset:4px}</style>
