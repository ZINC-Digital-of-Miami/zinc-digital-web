---
import ApprovedImage from './ApprovedImage.astro';
import DeviceComposition from './DeviceComposition.astro';
import Img from './Img.astro';
import DesktopMockup from './DesktopMockup.astro';
import type { Case } from '../data/site';

interface Props { study: Case; loading?: 'eager' | 'lazy' }
const { study, loading = 'eager' } = Astro.props;
const approved: Record<string, string> = {
  'felon-motorwerk': 'felon-white-devices.png',
};
const sources: Record<string, { desktop: string; tablet?: string; mobile?: string }> = {
  'bear-claw-usa': {desktop:'bear-claw-home-desktop',mobile:'bear-claw-product-mobile'},
  'smoky-mountain-survival': {desktop:'smoky-source-home'},
  'once-upon-a-book-club': {desktop:'ouabc-site',mobile:'ouabc-mobile'},
  'carla-funk-photography': { desktop: 'carla-home-desktop', tablet: 'carla-home-tablet', mobile: 'carla-home-mobile' },
  'us-oil-solutions': { desktop: 'case-uos-home-desktop', tablet: 'case-uos-home-tablet', mobile: 'case-uos-home-mobile' },
  'the-lampstand-va': { desktop: 'case-lampstand-home-desktop', tablet: 'case-lampstand-home-tablet', mobile: 'case-lampstand-home-mobile' },
  'straight-street-ministries': { desktop: 'case-straight-street-home-desktop', tablet: 'case-straight-street-home-tablet', mobile: 'case-straight-street-home-mobile' },
  'miami-tactical': { desktop: 'miami-tactical-website' },
  'zinc-fusion-v16': { desktop: 'fusion-v16-dashboard' },
  'fraim-cawley-company': { desktop: 'case-fraim-home-desktop', tablet: 'case-fraim-home-tablet', mobile: 'case-fraim-home-mobile' },
  'porsche-roanoke': { desktop: 'case-porsche-usa-desktop', tablet: 'case-porsche-dealers-tablet', mobile: 'case-porsche-usa-mobile' },
  'summit-marine-development': { desktop: 'smd-zinc-home-desktop' },
};
---
<figure data-case-mockup={study.slug} class="case-mockup">
  {study.slug === 'andrew-neese' ? <div class="seo-monitor"><DesktopMockup asset="andrew-original-website" ratio="1262 / 900" title="Andrew Neese original website built by ZINC" loading={loading} /></div> : ['ballad-health','meade-tractor','general-shale'].includes(study.slug) ? <div class="seo-monitor"><DesktopMockup asset={"seo-"+study.slug+"-current"} title={study.title+" — current website; past SEO engagement"} loading={loading} /></div> : approved[study.slug] ? <ApprovedImage name={approved[study.slug]} alt={study.title + ' — level desktop, laptop, tablet and phone presentation'} loading={loading} sizes="(max-width: 700px) 92vw, 65vw" />
    : study.slug === 'las-vegas-safety' ? <Img k="lvs-case-devices-restaurant" alt="Las Vegas Safety & Supply — original ZINC storefront across desktop, laptop, tablet and phone" loading={loading} quality={95} sizes="(max-width: 700px) 100vw, 85vw" />
    : <DeviceComposition title={study.title} {...(sources[study.slug] || { desktop: study.hero })} loading={loading} />}
</figure>
<style>
  .seo-monitor{width:70%;margin:0 auto}
  .case-mockup{width:100%;aspect-ratio:3/2;margin:0;display:flex;align-items:center;justify-content:center;background:#fff;overflow:hidden}
  .case-mockup> :global(picture){display:block;width:100%}
  .case-mockup> :global(img),.case-mockup> :global(picture)> :global(img){display:block;width:100%;height:auto;object-fit:contain;transform:none;filter:none}
</style>
