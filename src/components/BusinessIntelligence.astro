---
import IntelligenceScenario from './IntelligenceScenario.astro';
import { businessIntelligenceQuestions, businessIntelligenceScenarios } from '../data/business-intelligence';
import '../styles/business-intelligence.css';

// Decorative, deterministic geometry. These are conceptual connections, never client readings.
function network(width: number, height: number, seed: number, color: string, count: number, opacity: string) {
  let state = seed;
  const random = () => { state = (state * 16807) % 2147483647; return (state - 1) / 2147483646; };
  const points = Array.from({ length: count }, () => ({ x: 35 + random() * (width - 70), y: 35 + random() * (height - 70) }));
  const lines = points.flatMap((point, i) => points.slice(i + 1).filter(other => Math.hypot(point.x - other.x, point.y - other.y) < 95).map(other => ({
    x1: point.x.toFixed(2), y1: point.y.toFixed(2), x2: other.x.toFixed(2), y2: other.y.toFixed(2),
    stroke: color, 'stroke-opacity': opacity, 'stroke-width': '.8',
  })));
  const nodes = points.map((point, i) => ({ cx: point.x.toFixed(2), cy: point.y.toFixed(2), r: i % 9 === 0 ? '3' : '1.5', fill: color, 'fill-opacity': i % 9 === 0 ? '.8' : '.45' }));
  return { path: lines.map(line => `M${line.x1} ${line.y1}L${line.x2} ${line.y2}`).join(''), nodes, color, opacity };
}
const heroWeb = network(660, 400, 7, '#8c9aa8', 92, '.22');
const detailWeb = network(540, 480, 27, '#057e7e', 86, '.19');
