---
import {RESEARCH_JOBS} from '../../../lib/content-studio/research-jobs';
import {services} from '../../../data/site';
import {VOICES,CHECKS,emptyDraft,type Draft} from '../../../lib/content-studio/model';
import {pagePerformanceEvidence,sparklineSegments,type PerformancePage} from '../../../lib/seo-review-dashboard';
import {when} from '../../../lib/admin-data';
import '../../../styles/content-studio.css';
interface Props {snapshot?:any; documents:Draft[]; inventory:{slug:string;title:string;author:string;service:string;body:string}[]; storageError?:string}
const {snapshot,documents,inventory,storageError=''}=Astro.props;
const performance=pagePerformanceEvidence(snapshot?[snapshot.data]:[]);
const starter=emptyDraft();
const number=(v:number|null|undefined)=>typeof v==='number'?new Intl.NumberFormat('en-US',{maximumFractionDigits:0}).format(v):'—';
const difference=(current:number|null|undefined,previous:number|null|undefined)=>typeof current==='number'&&typeof previous==='number'?current-previous:null;
const signed=(v:number|null)=>v===null?'No earlier period':(v>0?'+':'')+number(v)+' vs earlier 28 days';
const direction=(v:number|null)=>v===null||v===0?'flat':v>0?'up':'down';
const measured=new Map((performance?.pages||[]).filter(p=>p.kind==='blog').map(p=>[p.path,p]));
const serviceTitle=new Map(services.map(s=>[s.slug,s.title]));
const savedDraft=new Map(documents.map(d=>[d.slug,d]));
const trend=(p?:PerformancePage)=>{
 if(!p||!performance)return null;
 const series=p.series.ga4.length?{metric:'views',values:p.series.ga4.map(v=>({date:v.date,value:v.views}))}:p.series.gsc.length?{metric:'search clicks',values:p.series.gsc.map(v=>({date:v.date,value:v.clicks}))}:null;
 return series?{...series,segments:sparklineSegments(series.values,performance.range.current.start,performance.range.current.end)}:null;
};
const articles=inventory.map(article=>{
 const page=measured.get('/blog/'+article.slug+'/'),viewsChange=difference(page?.current.views,page?.previous.views),clicksChange=difference(page?.current.clicks,page?.previous.clicks);
 return {...article,page,viewsChange,clicksChange,spark:trend(page),saved:savedDraft.get(article.slug)};
}).sort((a,b)=>(b.page?.current.views??-1)-(a.page?.current.views??-1)||a.title.localeCompare(b.title));
const metrics=Object.fromEntries(articles.map(a=>[a.slug,{views:number(a.page?.current.views),viewsChange:signed(a.viewsChange),clicks:number(a.page?.current.clicks),clicksChange:signed(a.clicksChange),impressions:number(a.page?.current.impressions)}]));
const state={starter,inventory,checks:CHECKS,metrics,saved:documents.map(d=>d.slug),services:Object.fromEntries(serviceTitle)};
const safeJson=JSON.stringify(state).replace(/</g,'\\u003c');
const period=performance?performance.range.current.start+' to '+performance.range.current.end:'';
---
<div class="cs" id="content-studio" data-studio>
 <div class="cs-top">
  <nav class="cs-tabs" aria-label="Content Studio"><button type="button" data-panel="articles" aria-pressed="true">Articles</button><button type="button" data-panel="pillars">Pillars</button></nav>
  <button class="a-button primary cs-big" type="button" data-new-article>+ New article</button>
 </div>
 <p class="cs-status" role="status" aria-live="polite" data-status></p>
 {storageError&&<p class="a-error" role="alert">{storageError}</p>}

 <section data-view="articles">
  <div class="cs-section-head"><div><p class="a-label a-muted">{inventory.length} published articles{period&&' · views '+period}</p><h2>Pick an article.</h2></div><div class="cs-refresh"><button class="a-button" type="button" data-refresh>Refresh numbers</button><span class="a-count">{snapshot?'Google numbers from '+when(snapshot.measuredAt):'No Google numbers collected yet'}</span></div></div>
  <div class="a-tools">
   <label class="a-field"><span class="a-label">Find an article</span><input class="a-input" type="search" data-list-search placeholder="Title, author or pillar"/></label>
   <label class="a-field"><span class="a-label">Pillar</span><select class="a-input" data-list-filter><option value="">All pillars</option>{services.map(s=><option value={s.slug}>{s.title}</option>)}</select></label>
   <label class="a-field"><span class="a-label">Order</span><select class="a-input" data-sort><option value="views">Most views</option><option value="falling">Falling fastest</option><option value="rising">Rising fastest</option><option value="title">A to Z</option></select></label>
   <label class="a-field"><span class="a-label">Saved drafts</span><select class="a-input" data-document><option value="">Open a saved draft…</option>{documents.map(d=><option value={d.slug}>{d.title||d.slug} · v{d.revision}</option>)}</select></label>
  </div>
  <p class="a-muted" data-list-results role="status" aria-live="polite" aria-atomic="true">{articles.length} articles</p>
  <div class="a-table-wrap" tabindex="0" role="region" aria-label="Articles"><table class="a-table cs-articles"><thead><tr><th scope="col">Article</th><th scope="col">Trend</th><th scope="col">Views · 28 days</th><th scope="col">Search clicks</th><th scope="col">Working copy</th></tr></thead>
   <tbody data-rows>{articles.map(a=><tr data-search-row={(a.title+' '+a.author+' '+(serviceTitle.get(a.service)||a.service)).toLowerCase()} data-layer={a.service} data-row={a.slug} data-views={a.page?.current.views??-1} data-change={a.viewsChange??0} data-title={a.title.toLowerCase()}>
    <td><button class="a-row-button cs-title-button" type="button" data-open-article={a.slug}>{a.title}<small>{a.author} · {serviceTitle.get(a.service)||a.service}</small></button></td>
    <td>{a.spark?<svg class="cs-spark" viewBox="0 0 120 36" role="img" aria-label={`Daily ${a.spark.metric}, ${period}. ${number(a.page?.current.views)} views; ${signed(a.viewsChange)}.`}><line x1="4" x2="116" y1="30" y2="30" class="cs-spark-base"/>{a.spark.segments.map(segment=>segment.length>1?<polyline class="cs-spark-line" points={segment.map(v=>`${v.x},${v.y}`).join(' ')}/>:segment.map(v=><circle class="cs-spark-dot" cx={v.x} cy={v.y} r="2"/>))}</svg>:<span class="a-count">No daily numbers</span>}</td>
    <td class="cs-number">{number(a.page?.current.views)}<small data-direction={direction(a.viewsChange)}>{signed(a.viewsChange)}</small></td>
    <td class="cs-number">{number(a.page?.current.clicks)}<small data-direction={direction(a.clicksChange)}>{signed(a.clicksChange)}</small></td>
    <td><span class="a-count" data-saved-tag={a.slug}>{a.saved?'Draft v'+a.saved.revision:'—'}</span></td>
   </tr>)}</tbody></table></div>
  <p class="a-empty" data-list-empty hidden={articles.length>0}>No published articles yet.</p>
  <details class="cs-help"><summary>What these numbers mean</summary><p>Views are GA4 page views for the latest 28 days against the 28 days before. Search clicks come from Search Console. Each trend line uses its own scale, starting at zero; gaps stay gaps. These are observations, not fixed-location rankings, AI citations or qualified leads.</p><a class="a-link" href="/admin/analysis/">Open full performance, service and pillar analysis</a></details>
 </section>

 <section data-view="pillars" hidden><p class="a-label a-muted">Coverage by service</p><h2>See what each pillar holds.</h2><p class="a-muted">Each pillar is the blog category for one service. Article count shows coverage, not quality.</p><div class="cs-pillar-grid">{services.map(s=>{const posts=inventory.filter(p=>p.service===s.slug),pillar=performance?.pillars.find(p=>p.slug===s.slug);return <article><div class="cs-pillar-title"><h3>{s.title}</h3><strong>{posts.length}</strong></div><p class="a-count">{posts.length===1?'published article':'published articles'}</p><p><a href={'/blog/category/'+s.slug+'/'} class="a-link">Category</a> · <a href={'/services/'+s.slug+'/'} class="a-link">Service</a></p><p>Views sent on to the service page: <strong>{pillar?.serviceReferrals?.current??'Unavailable'}</strong></p><details><summary>Articles in this pillar</summary><ul>{posts.map(p=><li><button type="button" class="cs-text-button" data-open-article={p.slug}>{p.title}</button></li>)}</ul>{!posts.length&&<p>No published article is assigned to this service.</p>}</details><button class="a-button" type="button" data-plan-service={s.slug}>New article here</button></article>;})}</div></section>

 <div class="cs-workspace" data-workspace hidden>
  <div class="cs-work-head">
   <button class="a-button" type="button" data-back>← All articles</button>
   <div class="cs-work-title"><p class="a-label a-muted" data-work-meta></p><h2 data-work-title>New article</h2></div>
   <div class="cs-work-actions"><a class="a-link" data-live target="_blank" rel="noopener noreferrer" hidden>View live article ↗</a><span class="a-count" data-revision>Unsaved</span><button class="a-button primary cs-big" type="button" data-save>Save private version</button></div>
  </div>
  <div class="cs-stats" data-work-stats hidden><div class="cs-stat-spark" data-work-spark></div><dl><div><dt>Views · 28 days</dt><dd data-stat="views">—</dd><small data-stat="viewsChange"></small></div><div><dt>Search clicks</dt><dd data-stat="clicks">—</dd><small data-stat="clicksChange"></small></div><div><dt>Search impressions</dt><dd data-stat="impressions">—</dd><small>Search Console</small></div></dl></div>
  <nav class="cs-steps" aria-label="Article"><button type="button" data-panel="write">Edit</button><button type="button" data-panel="brief">Brief &amp; research</button><button type="button" data-panel="review">Review &amp; release</button><button type="button" data-panel="ranks" data-ranks-step>Search positions</button></nav>

  <section class="cs-assistance" hidden data-assistance aria-labelledby="cs-proposal-title"><div class="cs-section-head"><h3 id="cs-proposal-title">Proposal</h3><div class="cs-controls"><button class="a-button primary cs-big" type="button" data-apply hidden>Use this version</button><button class="a-button" type="button" data-check-job>Check request</button><button class="a-button" type="button" data-discard>Close</button></div></div><p class="a-count" data-job-status>No request started.</p><pre data-result></pre><div data-result-images></div><p class="a-count">Using a version puts it in the editor unsaved. Nothing is published from here.</p></section>

  <section data-view="write" hidden><div class="cs-editor-grid">
   <div class="cs-manuscript"><label class="a-field"><span>Title</span><input class="a-input cs-title-input" data-field="title" maxlength="10000"/></label><label class="a-field"><span>TL;DR</span><textarea class="a-input" data-field="tldr" rows="4"/></label><label class="a-field"><span>Article · Markdown</span><textarea class="a-input cs-body" data-field="body" rows="24" placeholder="The complete article belongs here. Saving cannot publish it."/></label></div>
   <aside class="cs-fable" aria-labelledby="cs-fable-title"><p class="a-label a-muted">Fable 5.2 · High</p><h3 id="cs-fable-title">Change it.</h3>
    <label class="a-field"><span>Tell Fable what to change</span><textarea class="a-input" rows="4" maxlength="1500" data-instruction placeholder="Example: shorten the opening and get to the answer in the first two sentences."/></label>
    <button class="a-button primary cs-big cs-wide" type="button" data-assist="revise" data-custom>Make this change</button>
    <p class="a-label a-muted cs-or">Or one click</p>
    <div class="cs-quick">
     <button class="cs-action" type="button" data-assist="revise" data-instruction="Tighten the writing. Cut repetition, filler and throat-clearing. Keep every fact, link, source and heading."><strong>Tighten it</strong><span>Cut repetition and filler</span></button>
     <button class="cs-action" type="button" data-assist="revise" data-instruction="Rewrite only the opening so the reader learns the topic and the answer in the first few sentences. Leave the rest unchanged."><strong>Sharpen the opening</strong><span>Get to the point sooner</span></button>
     <button class="cs-action" type="button" data-assist="revise" data-instruction="Make the language plainer for a business owner. Explain each term the first time it appears and name concrete things. Keep the meaning, facts and structure."><strong>Make it plainer</strong><span>Explain terms, name real things</span></button>
     <button class="cs-action" type="button" data-assist="review"><strong>Challenge it</strong><span>Fable lists what is weak. No rewrite</span></button>
    </div>
    <p class="a-count">Each click is one Fable request on the owner account. Your copy is saved first, then Fable returns a proposal you can use or close.</p>
    <div class="cs-voice">{Object.entries(VOICES).map(([key,v])=><div data-voice={key} hidden={key!=='wendy'}><p class="a-label a-muted">Voice · {v.name}</p><p>{v.description}</p></div>)}</div>
    <details class="cs-more"><summary>Terra writing &amp; artwork</summary><div class="cs-quick"><button class="a-button" type="button" data-assist="write">Terra · full draft</button><button class="a-button" type="button" data-assist="creative">Terra · creative brief</button><button class="a-button" type="button" data-assist="image">Terra · illustration</button><button class="a-button" type="button" data-assist="chat">Terra · answer brief question</button><button class="a-button" type="button" data-export>Download manuscript</button></div></details>
   </aside>
  </div></section>

  <section data-view="brief" hidden><div class="cs-section-head"><div><p class="a-label a-muted">Audience → evidence → topic</p><h2>Decide what deserves an article.</h2></div><a class="a-button" href="/admin/research/">Research library</a></div>
   <div class="cs-brief-grid"><label class="a-field"><span>Draft address</span><input class="a-input" data-field="slug" value="new-article" pattern="[a-z0-9-]+" maxlength="150"/></label><label class="a-field"><span>Primary service</span><select class="a-input" data-field="service">{services.map(s=><option value={s.slug} selected={s.slug==='seo'}>{s.title}</option>)}</select></label><label class="a-field"><span>Author</span><select class="a-input" data-field="author"><option value="">Choose an author</option>{Object.entries(VOICES).map(([key,v])=><option value={key} selected={key==='wendy'}>{v.name} · {v.role}</option>)}</select></label><label class="a-field"><span>Format</span><select class="a-input" data-field="format">{['How-to','Comprehensive guide','Deep dive','Industry analysis','Comparison'].map(v=><option>{v}</option>)}</select></label><label class="a-field"><span>Target reader and situation</span><textarea class="a-input" data-field="audience" rows="3">Business owner</textarea></label><label class="a-field"><span>Search intent</span><textarea class="a-input" data-field="intent" rows="3">Learn how</textarea></label><label class="a-field"><span>The specific question</span><textarea class="a-input" data-field="question" rows="3"/></label><label class="a-field"><span>What this adds beyond existing coverage</span><textarea class="a-input" data-field="contribution" rows="3"/></label></div>
   <label class="a-field"><span>Research, supporting URLs, claims, dates and limitations</span><textarea class="a-input" data-field="research" rows="8" placeholder="Record what each source supports, when it was checked, and unresolved questions. Private experience needs approved provenance."/></label><label class="a-field"><span>Pillar overview, supporting articles and intended links</span><textarea class="a-input" data-field="links" rows="4" placeholder="Name each destination and why the reader needs it. Preserve the existing service/category."/></label>
   <p class="a-label a-muted">Fable research jobs</p><div class="cs-controls" aria-label="Research jobs">{Object.entries(RESEARCH_JOBS).map(([key,job])=><button class="a-button" type="button" data-assist={key}>{job.label}</button>)}<button class="a-button" type="button" data-assist="research">Analyze topic opportunity</button><button class="a-button" type="button" data-assist="plan">Plan</button></div>
   <p class="a-count">Fable 5.2 High works from the research saved in this brief, the article inventory and the saved Google numbers. These jobs do not fetch HYPD automatically. <a class="a-link" href="https://app.hypd.ai/library/prompts" target="_blank" rel="noopener noreferrer">HYPD prompt library</a></p>
   <details class="cs-more"><summary>Development proposals</summary><div class="cs-controls"><button class="a-button" type="button" data-assist="develop">Fable · development proposal</button><button class="a-button" type="button" data-assist="orchestrate">Fable · orchestrate workflow</button></div><p class="a-count">Proposals only. These controls do not execute code, deploy changes or launch agents.</p></details>
  </section>

  <section data-view="review" hidden><div class="cs-section-head"><div><p class="a-label a-muted">Evidence before approval</p><h2>Check the whole reader experience.</h2></div><div class="cs-gauge"><svg viewBox="0 0 100 60" role="img" aria-label="Review completion"><path d="M10 50 A40 40 0 0 1 90 50" fill="none" stroke="currentColor" opacity=".15" stroke-width="8"/><path data-gauge d="M10 50 A40 40 0 0 1 90 50" pathLength="100" fill="none" stroke="var(--tealt)" stroke-width="8" stroke-dasharray="0 100"/></svg><strong data-progress>0 / 16</strong><small>Documented checks, not an SEO score</small></div></div>
   <label class="a-field"><span>Artwork and reader downloads · URLs, purpose and verification notes</span><textarea class="a-input" data-field="resources" rows="5" placeholder="Hero + topic-specific explanatory graphic. Check exact logos, white mugs, labels, alt text, dimensions, social crops. For files: actual download/open, PDF text/links/forms save/reopen, spreadsheet formulas and specimen data."/></label><div class="cs-brief-grid"><label class="a-field"><span>Search title</span><input class="a-input" data-field="metaTitle"/></label><label class="a-field"><span>Search description</span><textarea class="a-input" data-field="description" rows="3"/></label></div>
   <p class="a-notice">Changing the article, brief, resources or metadata resets all checks. Pass means you have evidence for this version; a model response does not approve it. Publication is not available from this workspace.</p>
   <div class="cs-controls"><button class="a-button" type="button" data-inspect="draft">Inspect draft structure</button><button class="a-button" type="button" data-inspect="public">Inspect existing public SEO</button></div><div data-inspection></div><div class="cs-checks">{Object.entries(CHECKS).map(([id,label])=><div class="cs-check"><label>{label}<select class="a-input" data-check={id}><option value="pending">Pending</option><option value="pass">Pass · evidence required</option><option value="fail">Needs correction</option><option value="not-applicable">Exception requested · blocks handoff</option></select></label><label class="a-field"><span class="a-count">Evidence or reason</span><textarea class="a-input" data-evidence={id} rows="2" maxlength="3000"/></label></div>)}</div><div class="cs-controls"><button class="a-button" type="button" data-history>View saved versions</button></div><div data-history-results></div><div class="cs-review-comments"><h3>Review comments</h3><label class="a-field"><span>Comment on this saved version</span><textarea class="a-input" rows="3" maxlength="8000" data-review-comment/></label><div class="cs-controls"><button class="a-button" type="button" data-add-comment>Save comment</button><button class="a-button" type="button" data-read-comments>Read comments</button><button class="a-button" type="button" data-handoff>Export reviewed release package</button></div><p class="a-count">Owner-only handoff after every check passes. Exception requests block handoff. Export does not publish. Article-specific holds remain enforced.</p><div data-comments></div></div></section>

  <section data-view="ranks" hidden><p class="a-label a-muted">Search Console · this article</p><h2>Follow queries and positions.</h2><p class="a-muted">Matched 28-day periods, all devices and countries. These are observed average positions, not fixed-location Miami or Panama City ranks.</p><input type="hidden" data-rank-article/><div class="cs-controls"><button class="a-button" type="button" data-saved-ranks>Read saved report</button><button class="a-button" type="button" data-rank-history>History</button><button class="a-button primary" type="button" data-ranks>Refresh query positions</button></div><div data-rank-results><p>No report read yet.</p></div></section>
 </div>

 <footer class="cs-footer"><span>Private working copies · publishing stays separate</span><span>Wendy’s article-cluster rewrite: rejected by owner, hold in place</span></footer>
</div>
<script type="application/json" id="content-studio-state" set:html={safeJson}/>
<script>import '../../../scripts/admin/content-studio';</script>
