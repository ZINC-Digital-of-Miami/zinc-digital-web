---
import MockupBands from './MockupBands.astro';
import {services,layers,cases,team,posts,assets,toSitePath,dateLabel,type Route,type Pairing} from '../data/mockup';
interface Props {route:Route;pairing:Pairing;basePath?:string}
const {route,basePath=''}=Astro.props;
const link=(path:string,query?:Record<string,string>)=>toSitePath(path,basePath,query);
const service=services.find(s=>s.slug===route.slug);
const study=cases.find(c=>c.slug===route.slug);
const post=posts.find(p=>p.slug===route.slug);
const photo=(key:string)=>assets[key as keyof typeof assets];
---
{route.template==='home' ? <MockupBands basePath={basePath}/> : <>
<section class="band page-intro" data-theme="light" data-template={route.template}>
  <div class="band__inner">
    <p class="t-label eyebrow">ZINC / {route.layer || route.template} <span class="draft-tag">[DRAFT]</span></p>
    <h1 class="page-title">{route.title}</h1>
    {service && <p class="lede muted">{service.line}</p>}
    {study && <p class="lede muted">{study.line}</p>}
    {route.template==='services' && <p class="lede muted">One connected system. The customer experience, the demand behind it and the information that informs both.</p>}
    {route.template==='about' && <p class="lede muted">Seven people. Connected responsibilities across the work a business needs.</p>}
    {route.template==='blog' && <p class="lede muted">Source-backed thinking on building, reaching customers and measuring the work.</p>}
    {post && <><p class="t-label article-meta">{dateLabel(post.dateGmt)} / {post.author.name} / {post.layer}</p><p class="draft-notice">Draft migration preview — editorial review pending.</p></>}
  </div>
</section>

{(route.template==='services'||service) && <section class="band" data-theme="dark"><div class="band__inner">
  <p class="t-label eyebrow">The connected system</p><h2 class="section-title">Build. Demand. Intelligence.</h2>
  <div class="layer-grid mini-loop">{layers.map((layer,i)=><div class:list={['layer',{active:service?.layer===layer}]}><p class="t-label">0{i+1} / {service?.layer===layer?'Current layer':'Connected layer'}</p><h3 class="t-heading">{layer}</h3><ul class="link-list">{services.filter(s=>s.layer===layer).map(s=><li><a href={link('/services/'+s.slug+'/')} aria-current={service?.slug===s.slug?'page':undefined}>{s.title}<span aria-hidden="true">↗</span></a></li>)}</ul></div>)}</div>
</div></section>}

{service && <>
  <section class="band" data-theme="light"><div class="band__inner"><p class="t-label eyebrow">Service specification / [DRAFT]</p><h2 class="section-title">What the work includes.</h2><dl class="spec-grid"><div><dt class="t-label">Deliverables</dt><dd><ul>{service.deliverables.map(item=><li>{item}</li>)}</ul></dd></div><div><dt class="t-label">Cadence</dt><dd>{service.cadence}</dd></div><div><dt class="t-label">Client owns</dt><dd>{service.owns}</dd></div><div><dt class="t-label">Reported</dt><dd>{service.reported}</dd></div></dl></div></section>
  <section class="band" data-theme="dark"><div class="band__inner split"><div><p class="t-label eyebrow">Related work / scope varies by service</p><h2 class="section-title">{cases.find(c=>c.slug===service.caseSlug)?.title}</h2></div><div><p class="muted">[DRAFT] See the confirmed relationship and connected work. Specific results and service attribution remain subject to owner confirmation.</p><a class="arrow-link" href={link('/work/'+service.caseSlug+'/')}>Read the case study <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="band" data-theme="light"><div class="band__inner split"><div><p class="t-label eyebrow">Before the work begins</p><h2 class="section-title">Useful questions.</h2></div><div class="faq-list">{service.questions.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p class="muted">{a}</p></details>)}</div></div></section>
  <section class="band" data-theme="dark"><div class="band__inner"><p class="t-label eyebrow">Connect the next part</p><h2 class="section-title">Start with {service.title.toLowerCase()}.</h2><a class="button" href={link('/contact/',{service:service.slug})}>Start an Inquiry</a><div class="related-links">{service.related.map(slug=><a href={link('/services/'+slug+'/')}>{services.find(s=>s.slug===slug)?.title} ↗</a>)}</div></div></section>
</>}

{route.template==='contact' && <section class="band contact-band" data-theme="dark"><div class="band__inner contact-layout"><aside><p class="t-label eyebrow">Inquiry preview</p><h2 class="section-title">The right starting point.</h2><p class="demo-notice" id="demo-notice">Demo inquiry — no message will be sent</p><p class="muted">Use sample information to explore this form. Nothing is submitted or stored.</p><a class="arrow-link" href="tel:+17865754837">Text (786) 575-4837 ↗</a></aside>
  <div class="demo-form" data-demo-form data-thanks={link('/thanks/')} role="group" aria-describedby="demo-notice">
    <p class="t-label step-label" data-step-label aria-live="polite">Inquiry details</p>
    <fieldset data-step="0"><legend class="t-heading">01 / Your business</legend><div class="field-grid"><label>Name<input id="inquiry-name" autocomplete="off" required maxlength="120" /></label><label>Company<input id="inquiry-company" autocomplete="off" required maxlength="160" /></label><label>Work email<input id="inquiry-email" type="email" autocomplete="off" required maxlength="254" /></label><label>Website URL<input id="inquiry-website" type="url" autocomplete="off" placeholder="https://" required maxlength="500" /></label></div></fieldset>
    <fieldset data-step="1"><legend class="t-heading">02 / What you need</legend>{layers.map(layer=><div class="service-options"><h3 class="t-label">{layer}</h3>{services.filter(s=>s.layer===layer).map(s=><label class="check-option"><input type="checkbox" value={s.slug} data-service />{s.title}</label>)}</div>)}<div class="field-grid"><label>Monthly budget<select id="inquiry-budget" required><option value="">Choose a range</option>{['Under $5k/mo','$5–10k/mo','$10–25k/mo','$25k+/mo'].map(x=><option>{x}</option>)}</select></label><label>Timeline<select id="inquiry-timeline" required><option value="">Choose a timeline</option>{['As soon as practical','Within three months','Three to six months','Exploring options'].map(x=><option>{x}</option>)}</select></label></div></fieldset>
    <fieldset data-step="2"><legend class="t-heading">03 / The context</legend><label>Message<textarea id="inquiry-message" rows="6" required maxlength="3000"></textarea></label><p class="muted">Demo only. The next screen previews the confirmation; it does not contact ZINC.</p></fieldset>
    <p class="form-error" data-form-error role="alert"></p><div class="form-controls" hidden data-form-controls><button type="button" class="text-button" data-back>Back</button><button type="button" class="button" data-next>Continue</button></div>
    <noscript><p>JavaScript is off. All fields remain visible. This is a non-sending demo.</p><a class="button" href={link('/thanks/')}>Preview demo confirmation</a></noscript>
  </div>
</div></section>}

{route.template==='thanks' && <section class="band" data-theme="dark"><div class="band__inner"><p class="t-label eyebrow">Preview complete</p><h2 class="section-title">Demo only — nothing was sent</h2><p class="lede muted">No inquiry was submitted and no form details were saved. You can return to the form or keep exploring the work.</p><div class="hero-actions"><a class="button" href={link('/contact/')}>Return to inquiry</a><a class="arrow-link" href={link('/work/')}>Explore the work ↗</a></div></div></section>}
</>}

<script>
  const form=document.querySelector<HTMLElement>('[data-demo-form]');
  if(form) {
    const steps=Array.from(form.querySelectorAll<HTMLFieldSetElement>('[data-step]'));
    const controls=form.querySelector<HTMLElement>('[data-form-controls]')!;
    const next=form.querySelector<HTMLButtonElement>('[data-next]')!;
    const back=form.querySelector<HTMLButtonElement>('[data-back]')!;
    const label=form.querySelector<HTMLElement>('[data-step-label]')!;
    const error=form.querySelector<HTMLElement>('[data-form-error]')!;
    let step=0;
    const params=new URLSearchParams(location.search).getAll('service');
    if(params.length===1) for(const field of form.querySelectorAll<HTMLInputElement>('[data-service]')) field.checked=field.value===params[0];
    controls.hidden=false;
    function show(focus=false){steps.forEach((el,i)=>el.hidden=i!==step);back.hidden=step===0;next.textContent=step===2?'Preview demo confirmation':'Continue';label.textContent=`Step ${step+1} of 3`;error.textContent='';if(focus){steps[step].querySelector<HTMLElement>('input,select,textarea')?.focus();}}
    function advance(){const fields=Array.from(steps[step].querySelectorAll<HTMLInputElement|HTMLSelectElement|HTMLTextAreaElement>('input,select,textarea'));const invalid=fields.find(field=>!field.checkValidity());if(invalid){error.textContent='Complete the required fields with valid sample information.';invalid.reportValidity();return;}if(step===1&&!form!.querySelector<HTMLInputElement>('[data-service]:checked')){error.textContent='Choose at least one service to continue.';return;}if(step<2){step++;show(true);}else {location.assign(form!.dataset.thanks!);}}
    next.addEventListener('click',advance);back.addEventListener('click',()=>{step--;show(true);});
    form.addEventListener('keydown',event=>{if(event.key==='Enter'&&event.target instanceof HTMLInputElement){event.preventDefault();advance();}});
    show();
  }
</script>
