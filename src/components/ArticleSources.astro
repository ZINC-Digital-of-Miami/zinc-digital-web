---
import { articleSources, type SourceArticle } from '../data/article-sources';
interface Props { post: SourceArticle }
const sources = articleSources(Astro.props.post);
---
{sources.length > 0 && <section class="p-article-sources" aria-labelledby="article-sources-title" data-article-sources>
  <h2 id="article-sources-title">Sources</h2>
  <ul>{sources.map(source => <li><a href={source.url}>{source.title}<span aria-hidden="true"> ↗</span></a><span class="p-source-provider">{new URL(source.url).hostname.replace(/^www\./, '')}</span></li>)}</ul>
</section>}
