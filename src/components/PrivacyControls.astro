<button class="privacy-open" type="button" data-privacy-open hidden>Privacy settings</button>
<noscript><p class="privacy-nojs">Optional tracking is off without JavaScript. <a href="/privacy/">Privacy Policy</a>.</p></noscript>
<section class="consent-bar" aria-label="Privacy settings" data-consent-bar hidden>
 <div class="consent-copy">
  <h2>Your privacy choices</h2>
  <p>Choose whether we can measure visits, record clicks and scrolling, and use data for advertising. Optional tracking stays off until you choose. <a href="/privacy/">Privacy Policy</a></p>
  <p data-privacy-status role="status" hidden></p>
 </div>
 <div class="consent-actions">
  <button type="button" data-privacy-reject>Reject optional</button>
  <button type="button" data-privacy-accept>Accept all</button>
  <button type="button" data-privacy-settings aria-expanded="false" aria-controls="privacy-options">Choose settings</button>
  <button type="button" data-privacy-close hidden>Close</button>
 </div>
 <div id="privacy-options" class="consent-options" hidden>
  <p>Essential functions, including forms and staff sign-in, are always available.</p>
  <label><input type="checkbox" data-privacy-choice="analytics" /><span><strong>Measure website visits</strong><small>Google Analytics measures page visits, traffic sources and form use.</small></span></label>
  <label><input type="checkbox" data-privacy-choice="recordings" /><span><strong>Record clicks and scrolling</strong><small>Microsoft Clarity records page activity so we can see how people use the site. Form fields are masked.</small></span></label>
  <label><input type="checkbox" data-privacy-choice="advertising" /><span><strong>Advertising</strong><small>Allow Google advertising measurement and personalization, and Microsoft advertising use when activity recording is also on.</small></span></label>
  <p class="consent-note">Your choice applies to this browser for 180 days. Saving reloads the page. Turning tracking off does not erase data already sent or existing provider cookies.</p>
  <button type="button" data-privacy-save>Save my choices</button>
 </div>
</section>
<style>
 .privacy-open{font:inherit;font-size:14px;color:var(--ink);background:none;border:0;border-bottom:1px solid var(--line);padding:12px 0;min-height:44px;margin:8px 0;cursor:pointer}
 .privacy-nojs{font-size:14px}
 .consent-bar{position:fixed;z-index:10000;inset:auto 0 0;background:var(--bg,#f5f6f7);color:var(--ink,#16181b);border-top:2px solid var(--teal,#0b736c);box-shadow:0 -8px 32px #00000012;padding:22px max(24px,calc((100vw - 1320px)/2));display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px 32px;max-height:75dvh;overflow:auto;text-align:left;font-family:var(--font-body,sans-serif)}
 .consent-bar[hidden],.consent-bar [hidden],.privacy-open[hidden]{display:none!important}
 .consent-bar h2{font:800 20px/1.3 var(--font-display,sans-serif);text-transform:none;letter-spacing:-.02em;margin:0 0 8px;color:inherit}
 .consent-bar p{font-size:14px;line-height:1.55;max-width:740px;margin:0}
 .consent-bar a{text-decoration:none;border-bottom:1px solid currentColor;color:inherit}
 .consent-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
 .consent-bar button{font:600 14px/1.3 var(--font-body,sans-serif);color:inherit;background:transparent;border:1px solid var(--ink,#16181b);border-radius:4px;min-height:44px;padding:11px 15px;cursor:pointer;white-space:nowrap}
 .consent-bar button:hover{background:var(--ink,#16181b);color:var(--bg,#f5f6f7)}
 .consent-bar button:disabled{opacity:.55;cursor:default}
 .consent-bar :focus-visible,.privacy-open:focus-visible{outline:3px solid var(--teal,#0b736c);outline-offset:3px}
 .consent-options{grid-column:1/-1;border-top:1px solid var(--line);padding-top:18px;max-width:900px}
 .consent-options label{display:flex;gap:12px;align-items:flex-start;margin:16px 0;cursor:pointer}
 .consent-options input{width:20px;height:20px;flex-shrink:0;margin:2px 0;accent-color:var(--teal,#0b736c)}
 .consent-options strong{display:block;font-size:15px;line-height:1.5}
 .consent-options small{display:block;font-size:14px;line-height:1.5}
 .consent-note{margin:18px 0!important}
 [data-privacy-status]{margin-top:10px!important;font-weight:600}
 @media(max-width:960px){.consent-bar{grid-template-columns:1fr;gap:14px;padding:18px 24px}.consent-actions{gap:8px}}
 @media(max-width:480px){.consent-bar{padding:16px}.consent-actions button{flex:1;padding-inline:10px}.consent-actions [data-privacy-settings]{flex-basis:100%}.consent-bar h2{font-size:18px}}
</style>
<script>
 import '../scripts/tracking-privacy';
</script>
