---
import PageRail from "./PageRail.astro";
import ApprovedImage from './ApprovedImage.astro';
import { clientOrder, workFor } from '../data/client-work';
import CaseHeroMockup from './CaseHeroMockup.astro';
import {cases} from '../data/site';
const previewAssets: Record<string,string> = {'bear-claw-usa':'bear-white-devices.png','smoky-mountain-survival':'smoky-white-devices.png','fraim-cawley-company':'tax.jpeg','andrew-neese':'andrew-white-devices.png','porsche-roanoke':'porsche-white-devices.png','felon-motorwerk':'felon-white-devices.png','summit-marine-development':'summit.jpeg','us-oil-solutions':'oil-white-devices.png'};
const previewLabels: Record<string,string> = {'bear-claw-usa':'Industrial · Website','smoky-mountain-survival':'Outdoor · Website','fraim-cawley-company':'Accounting · Website','andrew-neese':'Real estate · Website','porsche-roanoke':'Dealer & merchandise websites','felon-motorwerk':'Motorcycles · Web work','summit-marine-development':'Marine · Website & campaigns','us-oil-solutions':'Commercial services · Website'};
const clients = clientOrder.map(slug => cases.find(c => c.slug === slug)!);
import '../styles/editorial.css';
---
<section class="zn-page-hero zn-work-overview"><div class="zn-hero-grid wrap"><div class="zn-hero-copy"><p class="lab">ZINC / Selected projects</p><h1 class="disp">Selected<br/>work<span>.</span></h1><p class="p-lede">Websites, campaigns and applications.<br/>See what we made, and the work behind it.</p><a class="zn-hero-action" href="#selected-projects">Explore the projects </a></div><ApprovedImage name="build-uos.png" alt="U.S. Oil Solutions website on a laptop and phone" loading="eager" sizes="(max-width: 600px) calc(100vw - 48px), (max-width: 900px) 92vw, (min-width: 1440px) 720px, calc(50.6vw - 11px)" widths={[480,640,768,1100,1536]} class="zn-direction-art" /></div></section><PageRail path="/work/" title="Work" /><section class="zn-editorial" id="selected-projects"><div class="light"><div class="wrap"><div class="gallery">{clients.map(study => <article class:list={["project",{tax:study.slug==='fraim-cawley-company'}]} data-client={study.slug}>
<a class="zn-project-link" href={'/work/'+study.slug+'/'}><div class:list={['art',{'zn-device-stage':!previewAssets[study.slug]}]}>{previewAssets[study.slug] ? <ApprovedImage name={previewAssets[study.slug]} alt={study.title+' project preview'} /> : <CaseHeroMockup study={study} loading="lazy" />}</div><div class="meta"><h2>{study.title}</h2><p>{previewLabels[study.slug] || (['ballad-health','meade-tractor','general-shale'].includes(study.slug)?study.scope:study.slug==='carla-funk-photography'?'Photography · Website':study.slug==='miami-tactical'?'Website · Logo design':study.application?'Application':study.nonprofit?'Community · Website':'Commerce · Website')}</p>{study.slug==='porsche-roanoke' && <p>Illustrative device presentation</p>}</div></a>
<ul class="client-engagements" aria-label={'Work for '+study.title}>{workFor(study.slug).map(work => <li><a href={work.href}><span>{work.layer}</span>{work.label}</a></li>)}</ul>
</article>)}</div></div></div></section>
<style>
.zn-project-link{height:auto}
.client-engagements{list-style:none;margin:20px 0 0;padding:0;border-top:1px solid var(--line,#d4d4d0)}.client-engagements a{display:flex;align-items:baseline;gap:16px;padding:12px 0;color:inherit;font:14px/1.5 var(--fb);min-height:44px}.client-engagements span{flex:0 0 84px;font:11px/1.5 var(--fm);color:var(--muted,#616161)}.client-engagements a:focus-visible{outline:2px solid currentColor;outline-offset:3px}@media(max-width:600px){.client-engagements a{gap:10px}.client-engagements span{flex-basis:76px}}
</style>
