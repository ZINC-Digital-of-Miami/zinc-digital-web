---
import DesktopMockup from './DesktopMockup.astro';
import DeviceFrame from './DeviceFrame.astro';
---
<div class="demand-art hero-art" aria-label="Current General Shale website and original Once Upon a Book Club campaign artwork">
 <div class="hero-art__group">
  <div class="demand-site"><DesktopMockup asset="seo-general-shale-current" title="General Shale current website — context for a past national enterprise SEO engagement" loading="eager" sizes="(max-width:700px) 80vw, 50vw" /></div>
  <div class="demand-phone"><DeviceFrame device="phone" asset="ouabc-halloween-campaign-vertical" fit="contain" position="center" fill="#dddad5" title="Original Once Upon a Book Club Halloween campaign creative" loading="eager" sizes="(max-width:700px) 22vw, 14vw" /></div>
 </div>
 <p class="demand-credits"><span>General Shale / SEO client</span><span>OUABC / Campaign creative</span></p>
</div>
<style>
.demand-art{--ratio:1.4;position:absolute;inset:0;background:#101416;isolation:isolate}
.demand-site{position:absolute;width:86%;left:0;top:0}
.demand-phone{position:absolute;width:23%;right:1%;bottom:0;z-index:2;filter:drop-shadow(-14px 20px 18px #0008)}
.demand-credits{position:absolute;right:4%;bottom:2.5%;display:flex;gap:18px;margin:0;font:9px/1.5 var(--fm);letter-spacing:.08em;text-transform:uppercase;color:#bfc7c9}
@media(max-width:700px){.demand-credits{left:max(16px,4%);right:auto;bottom:1.5%;flex-direction:column;gap:0;font-size:8px}}
</style>
