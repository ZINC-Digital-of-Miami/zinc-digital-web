---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/themes.css';
import '../styles/base.css';
import CircuitThread from '../components/CircuitThread.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {toSitePath,assets} from '../data/mockup';

interface Props {
  title: string;
}

const { title } = Astro.props;
const link=(path:string)=>toSitePath(path);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={'Public design draft: '+title+'. Full-site review; content and legal approval pending.'} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="frame">
      <CircuitThread />
      <header class="site-header">
        <a class="wordmark" href={link('/')} aria-label="ZINC home"><img src={assets['wordmark-black'].src} width={892} height={221} alt="ZINC"/></a>
        <span class="draft-tag nav-draft">PUBLIC DESIGN DRAFT</span>
        <nav id="site-nav" aria-label="Main navigation"><a href={link('/work/')}>Work</a><a href={link('/services/')}>Services</a><a href={link('/about/')}>About</a><a href={link('/blog/')}>Articles</a></nav>
        <button class="btn menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" hidden>Menu</button>
        <a class="btn" href={link('/contact/')}>Start an inquiry</a>
      </header>
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
<script>
  const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav=document.querySelector<HTMLElement>('#site-nav');
  if(toggle&&nav){toggle.hidden=false;document.documentElement.classList.add('nav-ready');const close=()=>{toggle.setAttribute('aria-expanded','false');nav.classList.remove('is-open');};toggle.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));nav.classList.toggle('is-open',open);});document.addEventListener('keydown',event=>{if(event.key==='Escape'&&toggle.getAttribute('aria-expanded')==='true'){close();toggle.focus();}});matchMedia('(min-width: 900px)').addEventListener('change',close);}
</script>
<style>
  .frame {
    position: relative;
    container-type: inline-size;
    overflow-x: clip;
  }
</style>
