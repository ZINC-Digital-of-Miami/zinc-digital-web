---
export const prerender=false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import Drawer from '../../components/admin/Drawer.astro';
import {requireStaff} from '../../lib/auth';
import {createServerClient} from '../../lib/supabase';
import {when} from '../../lib/admin-data';
import {models} from '../../lib/research/models';
const staff=requireStaff(Astro);if(staff instanceof Response)return staff;
const db=createServerClient(Astro).schema('research');
const projects=await db.from('projects').select('id,name,client,created_at').order('created_at',{ascending:false});
const project=projects.data?.find(p=>p.id===Astro.url.searchParams.get('project'))||projects.data?.[0];
const before=/^\d+$/.test(Astro.url.searchParams.get('before')||'')?Astro.url.searchParams.get('before'):null;
let hasOlder=false;
let sources:any[]=[],chats:any[]=[],messages:any[]=[],chat:any=null,error=projects.error?'Research projects could not be loaded.':'';
if(project){
 const results=await Promise.all([db.from('documents').select('id,title,kind,status,created_at,meta').eq('project_id',project.id).order('created_at',{ascending:false}).limit(100),db.from('chats').select('id,title,model,updated_at').eq('project_id',project.id).eq('created_by',staff.id).order('created_at',{ascending:false}).limit(100)]);
 sources=results[0].data||[];chats=results[1].data||[];if(results.some(r=>r.error))error='Project sources or conversations could not be loaded.';
 chat=Astro.url.searchParams.get('chat')==='new'?null:chats.find(c=>c.id===Astro.url.searchParams.get('chat'))||chats[0];
 if(chat){let query=db.from('messages').select('id,role,content,status,sources,model,created_at').eq('chat_id',chat.id).order('id',{ascending:false}).limit(201);if(before)query=query.lt('id',before);const result=await query;hasOlder=(result.data?.length||0)>200;messages=(result.data||[]).slice(0,200).reverse();if(result.error)error='Chat history could not be loaded.';}
}
const options=models(),available=options.find(m=>m.key),serp=!!import.meta.env.SERPAPI_KEY;
---
<AdminLayout view="research" title="Research"><button slot="action" class="a-button primary" data-open-dialog="new-project">New project</button>
{error&&<p class="a-error" role="alert">{error}</p>}
<section class="a-research a-section"><aside><div class="a-panel"><h2 class="a-label">Projects</h2><ul class="a-list">{(projects.data||[]).map(p=><li><a class="a-row-button" href={'/admin/research/?project='+p.id} aria-current={p===project?'page':undefined}>{p.name}<small>{p.client||when(p.created_at)}</small></a></li>)}</ul>{!projects.data?.length&&!projects.error&&<p class="a-empty">Create a project to collect sources and start research.</p>}</div>
{project&&<div class="a-panel a-section"><div class="a-actions"><h2 class="a-label">Sources · {sources.length}</h2><button class="a-button" data-open-dialog="add-source">Add source</button></div><ul class="a-list">{sources.map(s=><li><button class="a-row-button" data-source-id={s.id}>{s.title}<small>{s.kind} · {s.status} · {when(s.created_at)}</small></button>{s.status==='error'&&<p class="a-error">{s.meta?.error||'Processing failed.'}</p>}</li>)}</ul>{!sources.length&&<p class="a-empty">No sources yet. Add a note, URL or file.</p>}</div>}</aside>
<div>{project?<><div class="a-actions"><h2 class="a-heading">{project.name}</h2><a class="a-button" href={'/admin/research/?project='+project.id+'&chat=new'}>New chat</a></div>{chats.length>0&&<label class="a-field a-section"><span>Conversation</span><select class="a-input" data-chat-select data-project={project.id}><option value="new" selected={!chat}>New conversation</option>{chats.map(c=><option value={c.id} selected={chat?.id===c.id}>{c.title||'Research conversation'}</option>)}</select></label>}
<section class="a-panel a-section">{chat&&(before||hasOlder)&&<nav class="a-actions" aria-label="Conversation history">{hasOlder&&<a class="a-button" href={'/admin/research/?project='+project.id+'&chat='+chat.id+'&before='+messages[0].id}>Older messages</a>}{before&&<a class="a-button" href={'/admin/research/?project='+project.id+'&chat='+chat.id}>Latest messages</a>}</nav>}<div class="a-chat-log" data-chat-log aria-label="Conversation" role="log" aria-live="polite">{messages.length?messages.map(m=><article class="a-message" data-role={m.role}><div class="a-label a-muted">{m.role==='user'?'You':m.model||'Assistant'}{m.status==='error'?' · error':m.status==='streaming'?' · interrupted':''}</div><div>{m.content||'The answer did not complete.'}</div>{Array.isArray(m.sources)&&m.sources.length>0&&<div class="a-actions a-section">{m.sources.map((s:any)=><button class="a-chip" data-source-id={s.document_id}>[{s.n}] {s.title}</button>)}</div>}</article>):<p class="a-empty">No chats yet in this project. Ask a question and the model answers from this project’s sources.</p>}</div>
<form hidden={!!before} class="a-form" data-chat-form data-project={project.id} data-chat={chat?.id||''}><label class="a-field"><span>Model</span><select class="a-input" name="model" data-model-picker>{options.map(m=><option value={m.value} disabled={!m.key} selected={m===available}>{m.label}{!m.key?' · '+m.reason:''}</option>)}</select></label>{!available&&<p class="a-notice">Chat is unavailable until your subscription connection is configured.</p>}<label class="a-field"><span>Your question</span><textarea class="a-input" name="text" rows="3" maxlength="8000" placeholder="Ask from this project’s sources…" required disabled={!available}></textarea></label><p class="a-error" data-chat-error role="alert" hidden></p><div class="a-actions"><button class="a-button primary" type="submit" disabled={!available}>Send</button><span class="a-count">Cmd / Ctrl + Enter · 20 questions per 10 minutes</span></div></form></section></>:<div class="a-panel"><p class="a-empty">Select or create a project to begin.</p></div>}</div></section>
<Drawer id="new-project" title="New project"><form class="a-form" data-admin-form data-endpoint="/api/admin/research/projects/" data-body='{}'><label class="a-field"><span>Project name</span><input class="a-input" name="name" maxlength="120" required/></label><label class="a-field"><span>Client</span><input class="a-input" name="client" maxlength="120"/></label><p class="a-error" data-form-error role="alert" hidden></p><button class="a-button primary" type="submit">Create project</button></form></Drawer>
{project&&<Drawer id="add-source" title="Add source"><form class="a-form" data-source-form data-project={project.id}><label class="a-field"><span>Type</span><select class="a-input" name="kind" data-source-kind><option value="note">Note</option><option value="url">URL</option><option value="file">File · up to 10 MB</option><option value="serp" disabled={!serp}>SERP{!serp?' · not enabled':''}</option></select></label><label class="a-field"><span>Source title</span><input class="a-input" name="title" maxlength="200" required/></label><label class="a-field" data-source-field="note"><span>Source text</span><textarea class="a-input" name="content" rows="12" maxlength="200000"></textarea></label><label class="a-field" data-source-field="url" hidden><span>Public URL</span><input class="a-input" name="url" type="url" maxlength="2048"/></label><label class="a-field" data-source-field="file" hidden><span>PDF, DOCX, TXT or MD</span><input class="a-input" name="file" type="file" accept=".pdf,.docx,.txt,.md"/></label><label class="a-field" data-source-field="serp" hidden><span>Search query</span><input class="a-input" name="query" maxlength="500"/></label><p class="a-error" data-form-error role="alert" hidden></p><p class="a-count" data-source-progress role="status"></p><button class="a-button primary" type="submit">Add to project</button></form></Drawer>}
<Drawer id="source-detail" title="Source"><div data-source-detail><p class="a-empty">Loading…</p></div></Drawer>
<script>import '../../scripts/admin/research';</script>
</AdminLayout>
