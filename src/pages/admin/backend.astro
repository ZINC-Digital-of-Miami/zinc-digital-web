---
export const prerender=false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import PublishBar from '../../components/admin/PublishBar.astro';
import {requireStaff} from '../../lib/auth';
import {deployments,deploymentConfig,type Deployment} from '../../lib/vercel';
import GoogleConnections from '../../components/admin/GoogleConnections.astro';
import {isConfigured} from '../../lib/env';
import {inquiries,contentList,unpublished,when} from '../../lib/admin-data';
const staff=requireStaff(Astro);if(staff instanceof Response)return staff;
let rows:Deployment[]=[],error='',failures:number|null=null,pending=0;
try{rows=await deployments();}catch(e){error=(e as Error).message;}
try{failures=(await inquiries(Astro)).filter(r=>r.notify_status==='failed').length;pending=unpublished(await contentList(Astro));}catch{}
const config=deploymentConfig();
---
<AdminLayout view="backend" title="Backend"><div class="a-grid a-section"><section class="a-panel"><h2 class="a-heading">Vercel</h2><p class="a-muted">Production · zinc-digital-web</p>{error&&<p class="a-notice">{error}</p>}{rows[0]&&<><span class="a-chip">{rows[0].state}</span><p>{when(new Date(rows[0].created).toISOString())}</p><p class="a-count">{rows[0].meta?.githubCommitSha?.slice(0,7)} · {rows[0].meta?.githubCommitMessage?.split('\n')[0]}</p><a class="a-link" href={'https://'+rows[0].url}>Visit deployment</a></>}{staff.role==='owner'&&<div class="a-section"><button class="a-button" data-endpoint="/api/admin/redeploy/" data-body='{"confirm":true}' data-confirm="Rebuild main and deploy it to production?" data-success="Redeploy started." disabled={!config.hook}>Redeploy</button>{!config.hook&&<p class="a-muted">Connect the main deploy hook to redeploy.</p>}</div>}</section><section class="a-panel"><h2 class="a-heading">Contact form</h2><p>Live inquiries</p><p>{isConfigured('admin')?'Database configuration present':'Connect Supabase to save inquiries.'}</p><p>{isConfigured('smtp')?'Notification mail configuration present':'Connect Workspace mail for notifications.'}</p><p>{failures===null?'Notification status unavailable':failures+' failed notifications'}</p><a class="a-link" href="/admin/inquiries/">Review inquiries</a></section><section class="a-panel"><h2 class="a-heading">Publishing</h2><PublishBar pending={pending}/></section></div><GoogleConnections/><section class="a-panel a-section"><h2 class="a-heading">Latest production deployments</h2>{rows.length?<div class="a-table-wrap"><table class="a-table"><thead><tr><th>Created</th><th>Status</th><th>Commit</th><th>Deployment</th></tr></thead><tbody>{rows.map(row=><tr><td>{when(new Date(row.created).toISOString())}</td><td>{row.state}</td><td>{row.meta?.githubCommitSha?.slice(0,7)||'—'}<small>{row.meta?.githubCommitMessage?.split('\n')[0]}</small></td><td><a class="a-link" href={'https://'+row.url}>Visit</a></td></tr>)}</tbody></table></div>:<p class="a-empty">{error||'No production deployments were returned.'}</p>}</section></AdminLayout>
