<section class="a-panel a-section"><h2 class="a-heading">Site AI connections</h2><p>Fable 5.1 High handles SEO, research, planning, development proposals and orchestration. Terra 6.1 High handles writing, creative work, image-tool direction and chat. API keys remain on the server.</p><p class="a-count">Each test makes one short API request and retains the actual model and token receipt. Configuration alone does not prove execution.</p><div class="a-actions"><button class="a-button" data-model-test="claude">Test Fable High</button><button class="a-button" data-model-test="gpt">Test Terra High</button><button class="a-button" data-model-read>Read last test</button></div><pre data-model-test-result role="status" style="white-space:pre-wrap;overflow-wrap:anywhere"></pre></section>
<script>
 import {post} from '../../scripts/admin/shell';
 const output=document.querySelector<HTMLElement>('[data-model-test-result]')!;
 let active:{id:string;provider:string}|null=null;
 try{active=JSON.parse(sessionStorage.getItem('zinc:model-test')||'null');}catch{}
 async function read(){if(!active)throw Error('No test started in this browser session.');const response=await fetch('/api/admin/content-studio/assist/?'+new URLSearchParams({id:active.id,provider:active.provider}),{cache:'no-store'});const data=await response.json();if(!response.ok)throw Error(data.error||'Receipt unavailable.');output.textContent=JSON.stringify({status:data.status,error:data.error,model:data.model,effort:data.effort,requestId:data.providerRequestId,messageId:data.messageId,responseId:data.responseId,usage:data.usage,partialUsage:data.partialUsage,completedAt:data.completedAt},null,2);}
 document.querySelectorAll<HTMLButtonElement>('[data-model-test]').forEach(button=>button.onclick=async()=>{button.disabled=true;try{active={id:crypto.randomUUID(),provider:button.dataset.modelTest!};sessionStorage.setItem('zinc:model-test',JSON.stringify(active));output.textContent='Testing '+active.provider+' · '+active.id;await post('/api/admin/content-studio/connection/',{provider:active.provider,requestId:active.id});await read();}catch(e){output.textContent=(e as Error).message+' Use Read last test before retrying.';}finally{button.disabled=false;}});
 document.querySelector<HTMLButtonElement>('[data-model-read]')!.onclick=()=>read().catch(e=>output.textContent=e.message);
</script>
