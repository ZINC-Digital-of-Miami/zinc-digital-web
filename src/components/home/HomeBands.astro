---
// HomeBands.astro — the homepage, ported from ZINC Home Blend.dc.html.
// Header, CTA band and footer come from SiteLayout. Motion lives in scripts/home.ts.
import Img from '../Img.astro';
import ApprovedHero from './ApprovedHero.astro';
import SelectedWork from './SelectedWork.astro';
import BookClubSlider from './BookClubSlider.astro';
import OilSlider from './OilSlider.astro';
import ApprovedImage from '../ApprovedImage.astro';
import '../../styles/home-blend.css';
import '../../styles/editorial.css';
import '../../styles/refinements.css';
import CaseScene from '../CaseScene.astro';

import { workLanes, laneNames } from '../../data/work-lanes';
import { team, asset, posts, dateLabel, services, cases } from '../../data/site';
import '../../styles/home.css';
import '../../styles/home-mockups.css';
---
<ApprovedHero />

<section class="home-introduction" aria-labelledby="homeIntroTitle"><div class="wrap">
  <div class="intro">
    <div class="rv"><span class="kick">Build · Demand · Intelligence</span><h2 class="disp home-intro-title" id="homeIntroTitle">One team.<br/>Three connected<br/><span>lanes.</span></h2><p class="intro-lede">One team connects your website or store, the demand reaching it, and the reporting that guides the next step.</p><div class="acts"><a class="btn fill" href="/contact/">Start an inquiry ↗</a><a class="home-text-link" href="sms:+17865754837">Text (786) 575-4837 ↗</a></div></div>
    <nav class="home-lane-directory rv" aria-label="Explore work by service lane"><span class="kick"><span class="mdot"></span> Explore the work</span><ol>{laneNames.map((lane,i)=><li><a href={workLanes[lane].path}><span class="lab home-lane-number">0{i+1}</span><div><h3 class="disp">{lane}</h3><p>{workLanes[lane].line}</p><span class="lab">{services.filter(service=>service.layer===lane).length} {lane==='Intelligence'?'service':'services'}</span></div><span class="home-lane-arrow" aria-hidden="true">↗</span></a></li>)}</ol><a class="home-directory-all" href="/work/"><span>{cases.length} client stories across the lanes</span><span aria-hidden="true">→</span></a></nav>
  </div>
</div></section>

<div class="home-services-strip" aria-label="Services"><div class="wrap"><span class="lab">Connected services</span><p>Websites <i>↗</i> Commerce <i>↗</i> Campaigns <i>↗</i> Intelligence</p><a href="/services/" class="lab">All services →</a></div></div>


<section class="loop home-loop" id="loop"><div class="loop-pin"><div class="wrap" style="width:100%"><div class="loop-grid"><div class="circ"><svg viewBox="0 0 400 400" aria-hidden="true"><circle class="trace" cx="200" cy="200" r="186"></circle><circle class="track" cx="200" cy="200" r="150"></circle><circle class="draw" id="loopDraw" cx="200" cy="200" r="150" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" transform="rotate(-90 200 200)"></circle><circle class="node" cx="200" cy="50" r="12"></circle><circle class="node" cx="329.9" cy="275" r="12"></circle><circle class="node" cx="70.1" cy="275" r="12"></circle><text class="nl" x="200" y="22" text-anchor="middle">Build</text><text class="nl" x="352" y="312" text-anchor="middle">Demand</text><text class="nl" x="48" y="312" text-anchor="middle">Intelligence</text><circle id="loopPulse" cx="200" cy="50" r="6" fill="#FC0781"></circle></svg><div class="circ-core"><div class="badge"><div class="bring2"></div><Img k="zinc-badge" class="bimg" alt="" sizes="260px" /><div class="bring"></div><div class="borbit"><div class="bdot"></div></div></div></div></div><ol class="layers"><li class="layer on"><span class="lab">01 · The machine the customer touches</span><h2 class="disp layer-t">Build</h2><ul class="layer-list"><li><a href="/services/shopify/">Shopify Ecommerce</a></li><li><a href="/services/web-design/">Web Design</a></li><li><a href="/services/apps/">Apps</a></li></ul></li><li class="layer"><span class="lab">02 · Traffic into it</span><h2 class="disp layer-t">Demand</h2><ul class="layer-list"><li><a href="/services/seo/">SEO</a></li><li><a href="/services/local-seo/">Local SEO</a></li><li><a href="/services/ai-search-optimization/">Generative Search Optimization</a></li><li><a href="/services/google-search-ads/">Google Search Ads</a></li><li><a href="/services/shopping-ads/">Shopping / Merchant Center Ads</a></li><li><a href="/services/social-ads/">Social Ads (Meta)</a></li><li><a href="/services/tiktok-ads/">TikTok Ads</a></li></ul></li><li class="layer"><span class="lab">03 · The truth about what's working</span><h2 class="disp layer-t">Intelligence</h2><ul class="layer-list"><li><a href="/services/business-intelligence/">Business Intelligence</a></li><li><span style="color:var(--muted)">Reporting that feeds Build and Demand</span></li></ul></li></ol></div></div></div></section>

<section class="hz" id="hz"><div class="hz-pin"><div class="hz-track" id="hzTrack">
  <div class="hz-panel"><div class="hz-in"><div class="hz-text"><span class="kick">01 · Build</span><h2 class="disp hz-h" style="margin-top:14px">Build</h2><p class="hz-p">The storefront, the site, the app. The machine the customer touches, built to convert before any traffic hits it.</p><div class="hz-tags"><span class="hz-tag">Shopify</span><span class="hz-tag">Web design</span><span class="hz-tag">Apps</span></div><a class="arrow home-lane-link" href="/work/build/">Explore the builds ↗</a></div><div class="hz-vis home-scene"><CaseScene name="build-hero" alt="Bear Claw and Once Upon a Book Club websites in laptop, tablet and phone mockups" /></div></div></div>
  <div class="hz-panel"><div class="hz-in"><div class="hz-text"><span class="kick">02 · Demand</span><h2 class="disp hz-h" style="margin-top:14px">Demand</h2><p class="hz-p">Search, AI answers, paid and social. Traffic modeled against the demand curve, then pointed at the pages that close.</p><div class="hz-tags"><span class="hz-tag">SEO</span><span class="hz-tag">Generative search</span><span class="hz-tag">Paid media</span></div><a class="arrow home-lane-link" href="/work/demand/">Explore the demand work ↗</a></div><div class="hz-vis home-scene"><CaseScene name="demand-summit" alt="Summit Marine waterfront campaigns presented in phone and landscape mockups" /></div></div></div>
  <div class="hz-panel"><div class="hz-in"><div class="hz-text"><span class="kick">03 · Intelligence</span><h2 class="disp hz-h" style="margin-top:14px">Intelligence</h2><p class="hz-p">Dashboards and models your team actually opens. The truth about what's working, tied to revenue.</p><div class="hz-tags"><span class="hz-tag">BI dashboards</span><span class="hz-tag">Business reporting</span><span class="hz-tag">Decision apps</span></div><a class="arrow home-lane-link" href="/work/intelligence/">Explore the intelligence work ↗</a><p class="lab home-development">OUABC BI Fusion · Application in development · Private figures removed</p></div><div class="hz-vis home-scene"><figure class="case-scene"><ApprovedImage name="bi.png" alt="OUABC BI Fusion dashboard and campaign context; private figures removed" /></figure></div></div></div>
</div><div class="hz-dots" id="hzDots"><i class="on"></i><i></i><i></i></div></div></section>

<SelectedWork />
<BookClubSlider />

<OilSlider />

<section class="band home-commit"><div class="wrap"><span class="kick rv">How we work</span><ol class="commit"><li><span class="lab">01</span><span class="typed">You own your accounts, data and code.</span><span class="lock">■ Locked</span></li><li><span class="lab">02</span><span class="typed">Direct access to the people doing the work.</span><span class="lock">■ Locked</span></li><li><span class="lab">03</span><span class="typed">Reporting tied to revenue, not impressions.</span><span class="lock">■ Locked</span></li></ol></div></section>

<section class="band home-team" hidden id="team" style="padding-top:0"><div class="wrap"><div class="kick rv">The people behind the work</div><div class="team" data-team>{team.map((p) => <div class="person rv"><div class="person-ph"><img src={asset(p.photo).src} alt={p.name} width={asset(p.photo).width} height={asset(p.photo).height} loading="lazy" decoding="async" /></div><div class="person-n">{p.name}</div><div class="lab" style="margin-top:6px">{p.role}</div></div>)}</div></div></section>

<section class="band home-notes" id="notes"><div class="wrap"><h2 class="disp home-notes-title rv">&lt;insights<span>.py</span>/&gt;</h2><div class="notes rv">{posts.slice(0, 3).map((p) => <a class="note" href={'/blog/' + p.slug + '/'}><span class="lab">{dateLabel(p.dateGmt)} · {p.layer}</span><h3>{p.title}</h3></a>)}</div></div></section>

<section class="band home-contact-story"><div class="wrap"><div class="mcard"><div class="sph" data-par="0.05" style="width:420px;height:420px;left:8%;top:10%;animation:float1 12s ease-in-out infinite"></div><div class="sph" data-par="0.07" style="width:300px;height:300px;right:10%;bottom:6%;animation:float2 10s ease-in-out infinite"></div><span class="kick rv" style="position:relative;z-index:2"><span class="mdot"></span> Work with ZINC</span><h2 class="disp mcard-h rv">Every engagement starts with <span class="ctag"><span class="b">&lt;</span>model<span class="x">.py</span><span class="b">/&gt;</span></span></h2><p class="mcard-p rv">Search that isn't converting, brand systems that don't scale, reporting nobody trusts. Send the details and we'll tell you what's visible, what's missing, and what to model next.</p><a class="btn fill rv" href="/contact/">Start with a conversation</a></div></div></section>

<section class="band cta" id="inquiry"><div class="sph" data-par="0.06" style="width:520px;height:520px;left:-140px;top:-80px;animation:float2 12s ease-in-out infinite"></div><div class="sph" data-par="0.09" style="width:340px;height:340px;right:22%;bottom:-120px;animation:float1 10s ease-in-out infinite"></div><div class="wrap cta-grid"><div><span class="kick rv"><span class="mdot"></span> Work with ZINC</span><h2 class="disp cta-h rv" style="margin-top:18px">Send the <span class="hit" style="z-index:0">hard part.</span></h2><div class="acts rv" style="margin-top:36px"><a class="btn fill" href="/contact/">Open the form</a><a class="btn ghost" href="sms:+17865754837">Text (786) 575-4837</a></div></div><div class="rv" style="width:clamp(160px,18vw,260px);aspect-ratio:1"><div class="badge"><div class="bring2"></div><Img k="zinc-badge" class="bimg" alt="" sizes="260px" /><div class="bring"></div><div class="borbit"><div class="bdot"></div></div></div></div></div></section>


<script>
  import { initHome } from '../../scripts/home';
  initHome();
  import {initCaseSliders} from '../../scripts/case-sliders';
  initCaseSliders();
</script>
