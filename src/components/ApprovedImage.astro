---
import { Picture } from 'astro:assets';
import type {ImageMetadata} from 'astro';
interface Props { name:string; alt:string; class?:string; loading?:'eager'|'lazy'; sizes?:string; widths?:number[]; }
const {name,alt,class:cls,loading='lazy',sizes='(max-width: 760px) 100vw, 50vw',widths=[480,768,1100,1536]}=Astro.props;
const images=import.meta.glob<{default:ImageMetadata}>('../assets/approved/*.{png,jpg,jpeg,webp,avif}',{eager:true});
const image=images['../assets/approved/'+name]?.default;
if(!image) throw new Error('Missing approved image: '+name);
---
<Picture src={image} formats={['avif','webp']} fallbackFormat="webp" widths={widths.filter(w=>w<=image.width)} quality={90} sizes={sizes} alt={alt} class={cls} loading={loading} fetchpriority={loading==='eager'?'high':undefined} />
