---
import SiteLayout from '../layouts/SiteLayout.astro';
import Page from '../components/Page.astro';
import { routes, type Route } from '../data/site';
// Every route except the homepage, which src/pages/index.astro renders with its own stylesheet.
export function getStaticPaths() {
  return routes.filter((route) => route.template !== 'home').map((route) => ({ params: { path: route.path.replace(/^\/|\/$/g, '') }, props: { route } }));
}
interface Props { route: Route }
const { route } = Astro.props;
---
<SiteLayout route={route}><Page route={route} /></SiteLayout>
