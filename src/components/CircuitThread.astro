---
---
<div id="thread" aria-hidden="true"></div>
<div id="thread-dot" aria-hidden="true"></div>

<style>
  #thread {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--gutter) / 2 - 1px);
    width: 2px;
    background: var(--color-snow);
    mix-blend-mode: difference;
    z-index: 5;
    pointer-events: none;
  }

  #thread-dot {
    position: absolute;
    top: 0;
    left: calc(var(--gutter) / 2 - 5px);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-magenta);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-magenta) 22%, transparent);
    z-index: 6;
    pointer-events: none;
  }

  @container (min-width: 821px) {
    #thread-dot {
      left: calc(var(--gutter) / 2 - 7px);
      width: 14px;
      height: 14px;
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-magenta) 22%, transparent);
    }
  }
</style>

<script>
  // Progressive enhancement only: under prefers-reduced-motion (or with no JS
  // at all) the dot stays at the CSS default of top: 0, at the head of the
  // thread. This script never adds the .anim class — only the homepage
  // script (Task 3) arms motion.
  const thread = document.getElementById('thread');
  const dot = document.getElementById('thread-dot');
  const frame = thread?.parentElement as HTMLElement | null;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (dot && frame && !reduce) {
    let ticking = false;

    const update = () => {
      ticking = false;
      const frameHeight = frame.offsetHeight;
      const dotSize = dot.getBoundingClientRect().height || 10;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
      dot.style.top = progress * Math.max(0, frameHeight - dotSize) + 'px';
    };

    const request = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request, { passive: true });
    update();
  }
</script>
