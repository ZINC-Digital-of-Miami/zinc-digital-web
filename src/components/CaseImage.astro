---
import Img from './Img.astro';
import { asset } from '../data/site';
import type { ImageMetadata } from 'astro';
interface Props { k:string; alt:string; sizes?:string; widths?:number[]; loading?:'lazy'|'eager'; quality?:number }
const {k,alt,...props}=Astro.props;
const images=import.meta.glob<{default:ImageMetadata}>('../assets/**/*.{png,jpg,jpeg,webp}',{eager:true});
const source=asset(k);
const href=images['../assets'+source.src]?.default.src || source.src;
---
<a class="case-image" href={href} target="_blank" rel="noopener" aria-label={'Enlarge '+alt+' — view detail'}><Img k={k} alt={alt} {...props}/></a>
<style>.case-image{display:block;cursor:zoom-in}.case-image:focus-visible{outline:3px solid var(--tealt,#00858a);outline-offset:5px}</style>
