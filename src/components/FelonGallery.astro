---
import {Picture} from 'astro:assets';
import type {ImageMetadata} from 'astro';
interface Props {items:{image:ImageMetadata;label:string;group?:string}[]; apparel?:boolean; wide?:boolean; creative?:boolean}
const {items,apparel=false,wide=false,creative=false}=Astro.props;
const groups=[...new Set(items.map(item=>item.group).filter(Boolean))];
---
<div class="project-gallery" data-gallery-group data-filter-gallery data-gallery-limit={items.length<=10?items.length:8}>
  <div class="gallery-tools">{groups.length>1 && <div class="gallery-filters" role="group" aria-label="Filter gallery" hidden data-gallery-enhancement><button type="button" data-gallery-filter="all" aria-pressed="true">All pieces <span>{items.length}</span></button>{groups.map(group=><button type="button" data-gallery-filter={group} aria-pressed="false">{group}<span>{items.filter(item=>item.group===group).length}</span></button>)}</div>}<p data-gallery-tally>{items.length} pieces · Select an image to explore</p></div>
  <div class:list={['felon-gallery',{'felon-gallery--wide':wide,'felon-gallery--creative':creative}]}>
    {items.map(({image,label,group})=><figure data-gallery-card data-category={group || 'all'} data-apparel-item={apparel?true:undefined}>
      <a data-gallery-image href={image.src} target="_blank" rel="noopener" aria-label={'View '+label+' in the image viewer'}>
        <div class="felon-image"><Picture src={image} formats={['avif','webp']} widths={[...new Set([400,700,1000,image.width].filter(w=>w<=image.width))]} sizes={creative && group==='Campaigns'?'(max-width: 800px) 90vw, 60vw':creative?'(max-width: 480px) 90vw, (max-width: 800px) 44vw, 29vw':wide?'(max-width: 600px) 90vw, 44vw':'(max-width: 600px) 90vw, (max-width: 1000px) 44vw, 29vw'} quality={90} alt={label} loading="lazy" /><span class="image-action">View detail <span aria-hidden="true">+</span></span></div>
        <figcaption><span>{label}</span></figcaption>
      </a>
    </figure>)}
  </div>
  <button class="gallery-more" type="button" data-gallery-more hidden>Show more pieces +</button>
</div>
<style>
.gallery-tools{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:10px 0 26px}.gallery-tools p{font:13px/1.5 var(--fb);color:#565b5e;margin:0}.gallery-filters{display:flex;flex-wrap:wrap;gap:8px}.gallery-filters button,.gallery-more{background:transparent;border:1px solid #aeb0ad;border-radius:5px;padding:11px 15px;min-height:44px;font:14px/1.4 var(--fb);color:#191b1c;cursor:pointer}.gallery-filters button span{margin-left:10px;opacity:.7;font-size:12px}.gallery-filters button[aria-pressed=true]{background:#191b1c;color:#f4f3ef;border-color:#191b1c}.gallery-filters button:hover,.gallery-more:hover{border-color:#191b1c}.felon-gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px 24px}.felon-gallery--wide{grid-template-columns:repeat(2,minmax(0,1fr))}.felon-gallery figure{margin:0;min-width:0}.felon-gallery a{display:block;color:#191b1c!important;text-decoration:none!important;cursor:zoom-in}.felon-image{position:relative;aspect-ratio:1;display:flex;align-items:center;justify-content:center;background:#fff;overflow:hidden;border-radius:4px}.felon-gallery--wide .felon-image{aspect-ratio:4/3}.felon-image :global(picture){display:contents}.felon-image :global(img){width:100%;height:100%;object-fit:contain}.image-action{position:absolute;right:12px;bottom:12px;display:flex;align-items:center;gap:20px;padding:9px 12px;background:#151718;color:#fff;border-radius:4px;font:12px/1.5 var(--fb);opacity:0;transition:opacity .18s}.image-action>span{font-size:19px}.felon-gallery a:hover .image-action,.felon-gallery a:focus-visible .image-action{opacity:1}.felon-gallery figcaption{padding-top:14px;font:14px/1.5 var(--fb);display:flex;justify-content:space-between;gap:12px}.project-gallery :focus-visible{outline:3px solid #008d91;outline-offset:5px}.gallery-more{display:block;margin:30px auto 0;min-width:230px}@media(max-width:1000px){.felon-gallery{grid-template-columns:repeat(2,minmax(0,1fr))}.gallery-tools{align-items:start;flex-direction:column}}@media(max-width:600px){.felon-gallery{grid-template-columns:1fr;gap:28px}.image-action{opacity:1}.gallery-filters{gap:6px}.gallery-filters button{font-size:12px;padding:10px}.gallery-tools{padding-bottom:20px}}
.felon-gallery--creative{grid-template-columns:repeat(3,minmax(0,1fr))}.felon-gallery--creative .felon-image{aspect-ratio:1}.felon-gallery--creative figure[data-category=Campaigns]{grid-column:span 2}.felon-gallery--creative figure[data-category=Campaigns] .felon-image{aspect-ratio:1.5}.felon-gallery--creative figure[data-category=Logos] .felon-image :global(img){padding:clamp(18px,3vw,36px)}@media(max-width:800px){.felon-gallery--creative{grid-template-columns:repeat(2,minmax(0,1fr))}.felon-gallery--creative figure[data-category=Campaigns]{grid-column:1/-1}}@media(max-width:480px){.felon-gallery--creative{grid-template-columns:1fr}}
</style>
