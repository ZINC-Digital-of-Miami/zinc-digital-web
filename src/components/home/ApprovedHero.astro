---
import PageRail from "../PageRail.astro";
import ApprovedImage from '../ApprovedImage.astro';
const slides=[{name:'build',image:'build-ouabc-neese.png',alt:'Bear Claw laptop, OUABC storefront phone and Andrew Neese tablet'},{name:'demand',image:'demand-dark.png',alt:'Book Club and Summit Marine search and campaign work'},{name:'intelligence',image:'intelligence-vibrant.png',alt:'OUABC BI Fusion seasonal dashboard across desktop, tablet and mobile'}];
---
<section aria-label="ZINC Digital and our work" class="zn-hero" id="hero"><div class="wrap"><div class="zn-mast"><h1><span class="zn-stable-word">ZINC DIGITAL</span><span>.</span></h1><p><span>Other agencies deliver the scope.</span><br/>ZINC delivers the business.</p></div><div class="zn-stage" data-lane="build">{slides.map((slide,i)=><div class="zn-hero-picture" data-zn-picture={slide.name} hidden={i!==0}><ApprovedImage name={slide.image} alt={slide.alt} loading={i===0?'eager':'lazy'} sizes="(max-width: 760px) 100vw, 75vw" /></div>)}<div class="zn-copy"><h2 id="zn-title">BUILD<span>.</span></h2><p id="zn-description">Websites, commerce<br/>and applications.</p></div></div><div aria-label="Explore our three lanes" class="zn-tabs"><button aria-pressed="true" data-zn-lane="build" type="button">BUILD <span>↗</span></button><button aria-pressed="false" data-zn-lane="demand" type="button">DEMAND <span>↗</span></button><button aria-pressed="false" data-zn-lane="intelligence" type="button">INTELLIGENCE <span>↗</span></button></div></div></section><PageRail path="/" title="Home" /><script>
const root=document.querySelector('.zn-hero');
if(root){
const content={build:['BUILD','Websites, commerce<br>and applications.'],demand:['DEMAND','Search. Campaigns.<br>The path to a customer.'],intelligence:['INTELLIGENCE','Reporting and systems<br>for the next decision.']};
root.querySelectorAll<HTMLButtonElement>('[data-zn-lane]').forEach(button=>button.addEventListener('click',()=>{const key=button.dataset.znLane as keyof typeof content;root.querySelector<HTMLElement>('.zn-stage')!.dataset.lane=key;root.querySelector('#zn-title')!.innerHTML=content[key][0]+'<span>.</span>';root.querySelector('#zn-description')!.innerHTML=content[key][1];root.querySelectorAll<HTMLElement>('[data-zn-picture]').forEach(p=>p.hidden=p.dataset.znPicture!==key);root.querySelectorAll('[data-zn-lane]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));}));
}
</script>