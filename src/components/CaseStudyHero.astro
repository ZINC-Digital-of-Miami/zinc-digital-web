---
import CaseHeroMockup from './CaseHeroMockup.astro';
import Img from './Img.astro';
import type { Case } from '../data/site';
interface Props {
  study: Case;
  title?: string;
  description?: string;
  eyebrow?: string;
  href?: string;
  action?: string;
  caption?: string;
}
const { study, title = study.title, description = study.line, eyebrow = 'Selected client work', href = '#case-content', action = 'Explore the work', caption } = Astro.props;
const seo = ['ballad-health','meade-tractor','general-shale'].includes(study.slug);
const accents: Record<string,string> = {
  'las-vegas-safety':'#ed3652', 'once-upon-a-book-club':'#eb70c3',
  'bear-claw-usa':'#ffac43', 'smoky-mountain-survival':'#d3ad62',
  'us-oil-solutions':'#edcb45', 'summit-marine-development':'#38c2d6',
  'the-lampstand-va':'#f4a181', 'straight-street-ministries':'#c8da54',
  'carla-funk-photography':'#f39dc9', 'ballad-health':'#64c8f1',
  'meade-tractor':'#d5e46d', 'general-shale':'#efa28d',
  'felon-motorwerk':'#ed3652', 'miami-tactical':'#e96464',
  'fraim-cawley-company':'#97bddc', 'porsche-roanoke':'#d7c4a3',
  'andrew-neese':'#b5c8de', 'zinc-fusion-v16':'#59d7be',
};
const artworkLabel = caption || (seo ? study.scope : study.slug === 'porsche-roanoke' ? 'Illustrative device presentation' : study.slug === 'las-vegas-safety' ? 'Final delivered website · 2024–2025' : study.application ? 'Application · In development' : 'Website presentation');
---
<header class:list={['case-study-hero', { 'case-study-hero--identity': seo, 'case-study-hero--lvs': study.slug === 'las-vegas-safety' }]} data-case-hero={study.slug} style={'--hero-accent:'+ (accents[study.slug] || '#54c8cd')}>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="wrap hero-layout">
    <div class="hero-copy">
      <p class="hero-eyebrow"><span aria-hidden="true"></span>ZINC / {eyebrow}</p>
      <h1 class="disp">{title}<span class="hero-period" aria-hidden="true">.</span></h1>
      <p class="hero-description">{description}</p>
      <a class="hero-action" href={href}>{action}<span aria-hidden="true">↘</span></a>
    </div>
    <figure class="hero-exhibit">
      <div class="hero-studio">
        <div class="studio-backdrop" aria-hidden="true"></div>
        <div class="studio-floor" aria-hidden="true"></div>
        <div class="studio-plinth" aria-hidden="true"></div>
        <div class="studio-art">
          {seo ? <div class="identity-plaque"><Img k={study.hero} alt={study.title + ' — past SEO client'} loading="eager" sizes="(max-width: 800px) 80vw, 580px" /></div> : <CaseHeroMockup study={study} />}
        </div>
      </div>
      <figcaption><span class="exhibit-rule" aria-hidden="true"></span>{artworkLabel}</figcaption>
    </figure>
    <dl class="hero-details">
      <div><dt>Client</dt><dd>{study.client || study.title}</dd></div>
      <div><dt>Work</dt><dd>{study.scope}</dd></div>
      <div><dt>{study.nonprofit ? 'Commitment' : 'Engagement'}</dt><dd>{study.nonprofit ? 'Ongoing pro bono support' : study.timeline || 'Selected work'}</dd></div>
    </dl>
  </div>
</header>
<style>
.case-study-hero{position:relative;isolation:isolate;overflow:clip;background:#0c1014;color:#f6f5f2;--ink:#f6f5f2;--muted:#bbc1c6;--line:#3c444a;--tealt:var(--hero-accent);padding:clamp(45px,6vw,88px) 0 0}
.hero-glow{position:absolute;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(ellipse at 90% 28%,color-mix(in srgb,var(--hero-accent) 17%,transparent),transparent 60%),linear-gradient(120deg,#0c1014 35%,#20272c)}
.hero-layout{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.25fr);gap:28px 5%;align-items:center}
.hero-copy{position:relative;z-index:2;padding-bottom:20px;min-width:0}
.hero-eyebrow{font:10px/1.8 var(--fm);letter-spacing:.1em;text-transform:uppercase;display:flex;gap:12px;align-items:center;margin:0 0 25px;color:#c6ccd0}
.hero-eyebrow>span{width:24px;height:2px;background:var(--hero-accent);flex-shrink:0}
.case-study-hero h1{font-size:clamp(46px,5.8vw,90px);font-weight:400;line-height:.98;letter-spacing:-.025em;margin:0;max-width:12ch;overflow-wrap:normal}
.case-study-hero h1>span{display:inline}
.case-study-hero h1 .hero-period{color:var(--hero-accent)}
.hero-description{font-size:clamp(17px,1.45vw,22px);line-height:1.6;color:#c6ccd0;max-width:43ch;margin:24px 0 0}
.case-study-hero .hero-action{display:inline-flex;align-items:center;gap:28px;min-height:48px;margin-top:30px;padding:8px 0;border-bottom:1px solid var(--hero-accent);font:11px/1.5 var(--fm);color:#f6f5f2}
.hero-action>span{font:24px/1 var(--fb);color:var(--hero-accent);transition:transform .2s ease}
.hero-action:hover>span{transform:translate(3px,3px)}
.hero-action:focus-visible{outline:2px solid var(--hero-accent);outline-offset:7px}
.hero-exhibit{margin:0;min-width:0;position:relative;align-self:center}
.hero-studio{position:relative;isolation:isolate;aspect-ratio:1.35;perspective:1200px}
.studio-backdrop{position:absolute;inset:1% 0 10%;background:radial-gradient(ellipse at 48% 30%,#fff 20%,#e9edef 65%,#bec5ca);clip-path:polygon(0 5%,100% 0,100% 100%,0 100%);z-index:-2}
.studio-backdrop::after{content:'';position:absolute;inset:0;background:linear-gradient(110deg,transparent 68%,#fff9 68.2%,transparent 69%);opacity:.6}
.studio-floor{position:absolute;inset:65% -5% 0;z-index:-1;background:radial-gradient(ellipse at 50% 15%,#12181b66,transparent 62%);filter:blur(12px)}
.studio-plinth{position:absolute;left:4%;right:4%;bottom:11%;height:15%;background:linear-gradient(#fff,#d3d9dd);transform:rotateX(56deg);transform-origin:bottom;box-shadow:0 10px 0 #b5bec4,0 11px 0 #fff5,0 24px 30px #0005}
.studio-art{position:absolute;inset:5% 1% 15%;display:grid;place-items:center;transform:translateZ(25px);filter:drop-shadow(0 18px 13px #17202733)}
.studio-art :global(.case-mockup){background:transparent;aspect-ratio:auto;height:100%;overflow:visible;mix-blend-mode:multiply}
.studio-art :global(.case-mockup>picture){width:100%}
.studio-art :global(.case-mockup>picture>img){height:auto;max-height:100%;object-fit:contain}
.studio-art :global(.device-composition){mix-blend-mode:multiply}
.case-study-hero--lvs .hero-studio{aspect-ratio:1.5}
.case-study-hero--lvs .studio-art{inset:14% -4% 15%;filter:drop-shadow(0 21px 12px #17202766)}
.case-study-hero--lvs .studio-backdrop{background:radial-gradient(ellipse at 50% 20%,#fff,#e8e9e9 70%)}
.identity-plaque{width:85%;padding:10%;background:#fff;box-shadow:0 5px 0 #c3c9cd,0 10px 0 #a6b0b8,0 28px 30px #17202733;display:grid;place-items:center}
.identity-plaque :global(img){display:block;width:100%;height:auto;max-height:210px;object-fit:contain}
.case-study-hero--identity .studio-art{filter:none}
.hero-exhibit figcaption{display:flex;align-items:center;gap:12px;font:10px/1.6 var(--fm);letter-spacing:.025em;color:#c6ccd0;padding:8px 0 0}
.exhibit-rule{display:block;width:30px;height:1px;background:var(--hero-accent);flex-shrink:0}
.hero-details{grid-column:1/-1;display:grid;grid-template-columns:1fr 1.8fr 1fr;gap:30px;margin:15px 0 0;padding:25px 0 28px;border-top:1px solid #ffffff30}
.hero-details dt{font:9px/1.5 var(--fm);text-transform:uppercase;letter-spacing:.12em;color:#aeb7be;margin-bottom:9px}
.hero-details dd{font:12px/1.6 var(--fb);margin:0;color:#f0f2f3}
@media(min-width:1600px){.hero-layout{grid-template-columns:minmax(0,.9fr) minmax(0,1.2fr)}}
@media(max-width:900px){.hero-layout{grid-template-columns:1fr;gap:20px}.hero-copy{padding-bottom:0}.case-study-hero h1{font-size:clamp(48px,9vw,78px);max-width:15ch}.hero-description{max-width:55ch}.hero-exhibit{width:100%;max-width:700px;justify-self:center}.hero-studio{aspect-ratio:1.5}.hero-details{margin-top:8px;gap:20px}.hero-description{font-size:18px}}
@media(max-width:540px){.case-study-hero{padding-top:35px}.hero-eyebrow{font-size:9px;margin-bottom:18px}.case-study-hero h1{font-size:clamp(44px,11.5vw,62px)}.hero-description{font-size:16px;margin-top:20px}.hero-action{margin-top:22px!important}.hero-studio{margin-top:12px}.hero-exhibit figcaption{font-size:9px}.hero-details{grid-template-columns:1fr 1fr;padding-top:20px}.hero-details>div:nth-child(2){grid-column:1/-1;grid-row:2}.hero-details dd{font-size:12px}.hero-details dt{font-size:9px}}
</style>
