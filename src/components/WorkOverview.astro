---
import PageRail from "./PageRail.astro";
import BuildHeroArt from './BuildHeroArt.astro';
import CaseHeroMockup from './CaseHeroMockup.astro';
import {cases} from '../data/site';
const order=['bear-claw-usa','smoky-mountain-survival','fraim-cawley-company','once-upon-a-book-club','andrew-neese','porsche-roanoke','felon-motorwerk','summit-marine-development','us-oil-solutions'];
const orderedCases=[...order.map(slug=>cases.find(c=>c.slug===slug)!),...cases.filter(c=>!order.includes(c.slug))];
import '../styles/editorial.css';
---
<section class="zn-page-hero zn-work-overview"><div class="zn-hero-grid wrap"><div class="zn-hero-copy"><p class="lab">ZINC / Selected projects</p><h1 class="disp">Selected<br/>work<span>.</span></h1><p class="p-lede">Websites, campaigns and applications.<br/>See what we made, and the work behind it.</p><a class="zn-hero-action" href="#selected-projects">Explore the projects ↓</a></div><BuildHeroArt /></div></section><PageRail path="/work/" title="Work" /><section class="zn-editorial" id="selected-projects"><div class="light"><div class="wrap"><div class="gallery">
  {orderedCases.map(study => <article class="project" data-client={study.slug}>
    <a class="zn-project-link" href={'/work/'+study.slug+'/'}>
      <div class="art zn-device-stage"><CaseHeroMockup study={study} loading="lazy" /></div>
      <div class="meta"><h2>{study.title}</h2><p>{study.scope}</p></div>
      {study.slug === 'porsche-roanoke' && <p class="project-note">Illustrative device presentation</p>}
      {study.application && <p class="project-note">Application · In development</p>}
    </a>
  </article>)}
</div></div></div></section>
<style>
.zn-editorial .meta{display:block}.zn-editorial .meta h2{margin-bottom:12px}.zn-editorial .meta p{max-width:65ch;line-height:1.7;text-align:left;white-space:normal}.project-note{font:10px/1.6 var(--fm);margin:12px 0 0;color:var(--muted)}
</style>
